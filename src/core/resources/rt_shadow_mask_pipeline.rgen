#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_ray_tracing : require

#include "pelican_sets.glsl"
#include "pelican_frame.glsl"

layout(set = PELICAN_SET_PASS_INPUT, binding = 0)
    uniform sampler2D pelican_resource_world_position;
layout(set = PELICAN_SET_PASS_INPUT, binding = 1)
    uniform sampler2D pelican_resource_normal;
layout(r8, set = PELICAN_SET_PASS_INPUT, binding = 2)
    writeonly uniform image2D pelican_resource_shadow_mask;

layout(set = PELICAN_SET_FRAME,
       binding = PELICAN_RAY_QUERY_TLAS_BINDING)
    uniform accelerationStructureEXT pelicanRayTracingScene;

layout(location = 0) rayPayloadEXT float visibility;

const float RAY_ORIGIN_ABSOLUTE_BIAS = 0.01;
// This exactly matches rt_shadow_mask.frag: R16F world positions have
// roughly one ULP per 1024 units, and two ULPs cover the round trip.
const float RAY_ORIGIN_RELATIVE_BIAS = 1.0 / 512.0;
const float RAY_MAX_DISTANCE = 10000.0;

void storeVisibility(ivec2 pixel, float value) {
    imageStore(
        pelican_resource_shadow_mask, pixel,
        vec4(value, value, value, 1.0));
}

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    vec2 uv =
        (vec2(pixel) + vec2(0.5)) /
        vec2(gl_LaunchSizeEXT.xy);
    vec4 world = texture(
        pelican_resource_world_position, uv);
    if (world.a < 0.5 ||
        pelicanLights.directionalLightCount == 0u) {
        storeVisibility(pixel, 1.0);
        return;
    }

    vec3 toLight = normalize(
        -pelicanLights.directionalLights[0].direction);
    vec3 normal = normalize(
        texture(pelican_resource_normal, uv).xyz * 2.0 - 1.0);
    float coordinateScale = max(
        1.0, max(abs(world.x), max(abs(world.y), abs(world.z))));
    float originBias = max(
        RAY_ORIGIN_ABSOLUTE_BIAS,
        coordinateScale * RAY_ORIGIN_RELATIVE_BIAS);
    float normalSide = dot(normal, toLight) >= 0.0 ? 1.0 : -1.0;
    vec3 origin = world.xyz + normal * normalSide * originBias;

    visibility = 1.0;
    traceRayEXT(
        pelicanRayTracingScene,
        gl_RayFlagsTerminateOnFirstHitEXT |
            gl_RayFlagsOpaqueEXT,
        0xff, 0, 0, 0, origin, 0.0, toLight,
        RAY_MAX_DISTANCE, 0);
    storeVisibility(pixel, visibility);
}
