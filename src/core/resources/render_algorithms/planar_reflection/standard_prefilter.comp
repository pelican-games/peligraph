#version 460
#extension GL_GOOGLE_include_directive : enable

#include "pelican_frame.glsl"
#include "pelican_resource_ports.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#ifndef PELICAN_FEATURE_PLANAR_REFLECTION_PREFILTER_RADIUS
#error PELICAN_FEATURE_PLANAR_REFLECTION_PREFILTER_RADIUS is required
#endif

vec3 pelican_prefilter_sample(
    vec2 uv,
    vec2 source_texel,
    vec2 offset,
    uint view_index) {
    return pelican_sample_source_color(
        uv + source_texel * offset,
        view_index).rgb;
}

// The sum of four taps at the given offsets (in source texels, scaled by
// `scale`), added in the order given.
vec3 pelican_prefilter_sum4(
    vec2 uv,
    vec2 source_texel,
    float scale,
    uint view_index,
    vec2 o0,
    vec2 o1,
    vec2 o2,
    vec2 o3) {
    vec3 sum = pelican_prefilter_sample(uv, source_texel, o0 * scale, view_index);
    sum = sum + pelican_prefilter_sample(uv, source_texel, o1 * scale, view_index);
    sum = sum + pelican_prefilter_sample(uv, source_texel, o2 * scale, view_index);
    return sum + pelican_prefilter_sample(uv, source_texel, o3 * scale, view_index);
}

void main() {
    ivec2 coordinate = ivec2(gl_GlobalInvocationID.xy);
    ivec2 output_size = pelican_size_filtered_color();
    if (any(greaterThanEqual(coordinate, output_size))) {
        return;
    }

    vec2 uv =
        (vec2(coordinate) + vec2(0.5)) /
        vec2(output_size);
    vec2 source_texel =
        1.0 / vec2(pelican_size_source_color());
    uint view_index = pelican_view_index();

    // The graph owns the selected subresource. Its generated typed accessor
    // gives this replaceable algorithm the destination level without a
    // task-name convention or Vulkan state.
    float level = float(
        pelican_base_mip_filtered_color());
    float roughness = clamp(level / 6.0, 0.0, 1.0);
    float radius =
        max(PELICAN_FEATURE_PLANAR_REFLECTION_PREFILTER_RADIUS, 0.5) *
        mix(0.75, 2.0, roughness * roughness);

    // 13 taps that cover five overlapping 2x2-texel boxes: one centred on
    // the pixel (the four +-1 diagonal taps) and one in each diagonal quadrant
    // (spanning the centre, the +-2 edge taps and a +-2 corner). The centred
    // box weighs 1/2 and each quadrant box 1/8, split evenly over its four
    // taps, so a tap's weight is the sum over the boxes that contain it:
    // centre 4 x 1/32, edge 2 x 1/32, corner 1/32, inner diagonal 1/8. The
    // weights sum to 1. Pattern: J. Jimenez, "Next Generation Post Processing
    // in Call of Duty: Advanced Warfare", SIGGRAPH 2014 course. It suppresses
    // the shimmer of a single bilinear tap and widens with `radius` toward
    // rough mips; it stays a planar screen-space approximation, not a
    // direction-space GGX convolution.
    vec3 centre = pelican_prefilter_sample(
        uv, source_texel, vec2(0.0), view_index);
    vec3 outer_corners = pelican_prefilter_sum4(
        uv, source_texel, radius, view_index,
        vec2(-2.0, 2.0), vec2(2.0, 2.0), vec2(-2.0, -2.0), vec2(2.0, -2.0));
    vec3 outer_edges = pelican_prefilter_sum4(
        uv, source_texel, radius, view_index,
        vec2(0.0, 2.0), vec2(-2.0, 0.0), vec2(2.0, 0.0), vec2(0.0, -2.0));
    vec3 inner_diagonals = pelican_prefilter_sum4(
        uv, source_texel, radius, view_index,
        vec2(-1.0, 1.0), vec2(1.0, 1.0), vec2(-1.0, -1.0), vec2(1.0, -1.0));

    vec3 filtered = centre * 0.125;
    filtered += outer_corners * 0.03125;
    filtered += outer_edges * 0.0625;
    filtered += inner_diagonals * 0.125;
    pelican_store_filtered_color(
        coordinate,
        view_index,
        vec4(filtered, 1.0));
}
