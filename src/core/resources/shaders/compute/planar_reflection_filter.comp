#version 460
#extension GL_GOOGLE_include_directive : enable

#include "pelican_frame.glsl"
#include "pelican_resource_ports.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    ivec2 coordinate = ivec2(gl_GlobalInvocationID.xy);
    ivec2 output_size = pelican_size_filtered_color();
    if (any(greaterThanEqual(coordinate, output_size))) {
        return;
    }

    // Sampling the previous mip at the destination texel center with a
    // linear sampler is a 2x2 box reduction. Repeating this copyable task
    // produces the standard roughness pyramid without shader-owned mip IDs.
    vec2 uv =
        (vec2(coordinate) + vec2(0.5)) /
        vec2(output_size);
    uint view_index = pelican_view_index();
    pelican_store_filtered_color(
        coordinate,
        view_index,
        pelican_sample_source_color(
            uv, view_index));
}
