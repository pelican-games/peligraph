{
  "schema": "pelican.render_fragment",
  "version": 1,
  "name": "forward_base",
  "render_targets": [
    {
      "name": "opaque_color",
      "extent_scale": 1.0,
      "format": "R16G16B16A16_SFLOAT",
      "format_class": "explicit(R16G16B16A16_SFLOAT)",
      "usage": [
        "TRANSFER_DST",
        "SAMPLED"
      ]
    },
    {
      "name": "opaque_depth",
      "extent_scale": 1.0,
      "format": "D32_SFLOAT",
      "format_class": "data",
      "usage": [
        "TRANSFER_DST",
        "SAMPLED"
      ]
    }
  ],
  "passes": [
    {
      "name": "forward_opaque",
      "type": "material",
      "material_contract": "forward_opaque_v1",
      "output": {
        "color": [
          "lit_color"
        ],
        "depth": "scene_depth"
      },
      "color_load_op": "load",
      "depth_load_op": "load",
      "depth_store_op": "store"
    },
    {
      "name": "__snapshot_opaque_color",
      "type": "snapshot_copy",
      "source": "lit_color",
      "destination": "opaque_color",
      "snapshot": "opaque_color",
      "snapshot_after": "forward_opaque"
    },
    {
      "name": "__snapshot_opaque_depth",
      "type": "snapshot_copy",
      "source": "scene_depth",
      "destination": "opaque_depth",
      "snapshot": "opaque_depth",
      "snapshot_after": "forward_opaque"
    },
    {
      "name": "forward_transparent",
      "type": "material",
      "material_contract": "forward_transparent_v1",
      "screen_inputs": {
        "opaque_color": "opaque_color",
        "opaque_depth": "opaque_depth",
        "scene_depth": "opaque_depth",
        "linear_view_depth": "opaque_depth"
      },
      "output": {
        "color": [
          "lit_color"
        ],
        "depth": "scene_depth"
      },
      "color_load_op": "load",
      "depth_load_op": "load",
      "depth_store_op": "store"
    }
  ],
  "required_targets": [
    "lit_color",
    "scene_depth"
  ]
}
