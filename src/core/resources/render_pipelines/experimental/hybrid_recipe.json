{
  "schema": "pelican.render_pipeline",
  "version": 2,
  "name": "hybrid_recipe",
  "config": {
    "shader_defines": [
      "PELICAN_HYBRID_SCENE_LINEAR"
    ],
    "draw_sort": {
      "opaque": {
        "provider": "state_batched_v1"
      },
      "transparent": {
        "provider": "back_to_front_v1"
      },
      "xr_view_policy": "logical_view_center"
    },
    "material_routing": {
      "policy": "hybrid_auto_v1",
      "routes": {
        "deferred_geometry": "deferred_geometry",
        "forward_opaque": "forward_opaque",
        "forward_transparent": "forward_transparent"
      }
    },
    "graph_filters": {
      "schema": "pelican.graph_filters",
      "version": 1,
      "categories": [],
      "feature_categories": {},
      "filters": [
        {
          "id": "render",
          "label": "Render",
          "match": {},
          "children": [
            {
              "id": "scene",
              "label": "Scene",
              "match": {
                "node_ids": ["deferred_geometry", "forward_opaque", "forward_transparent"]
              }
            },
            {
              "id": "lighting",
              "label": "Lighting",
              "match": {
                "node_ids": ["ssao_pass", "ssao_blur_pass", "deferred_lighting"]
              }
            },
            {
              "id": "present",
              "label": "Present",
              "match": {"node_ids": ["scene_present"]}
            }
          ]
        }
      ]
    },
    "base": [
      {
        "family": "main_render",
        "fragments": [
          "engine://render_fragments/deferred_geometry.json",
          "engine://render_fragments/ssao.json",
          "engine://render_fragments/deferred_lighting.json",
          "engine://render_fragments/forward_base.json",
          "engine://render_fragments/present.json"
        ]
      }
    ]
  }
}
