{
  "schema": "pelican.render_feature",
  "version": 1,
  "name": "planar_reflection",
  "parameters": {
    "schema": "pelican.render_feature_parameters",
    "version": 1,
    "scalars": [
      {
        "name": "resolution",
        "type": "int",
        "range": [64, 8192],
        "default": 1024,
        "shader_define": false
      },
      {
        "name": "plane_x",
        "type": "float",
        "range": [-10000.0, 10000.0],
        "default": 0.0,
        "shader_define": false
      },
      {
        "name": "plane_y",
        "type": "float",
        "range": [-10000.0, 10000.0],
        "default": 1.0,
        "shader_define": false
      },
      {
        "name": "plane_z",
        "type": "float",
        "range": [-10000.0, 10000.0],
        "default": 0.0,
        "shader_define": false
      },
      {
        "name": "plane_offset",
        "type": "float",
        "range": [-10000.0, 10000.0],
        "default": 0.0,
        "shader_define": false
      },
      {
        "name": "preserve_raster_winding",
        "type": "bool",
        "default": true,
        "shader_define": false
      },
      {
        "name": "oblique_near_plane",
        "type": "bool",
        "default": true,
        "shader_define": false
      },
      {
        "name": "prefilter_radius",
        "type": "float",
        "range": [0.5, 3.0],
        "default": 1.0
      }
    ],
    "shader_assets": [
      {
        "name": "prefilter_shader",
        "stage": "compute",
        "default": "engine://render_algorithms/planar_reflection/standard_prefilter"
      }
    ]
  },
  "render_targets": [
    {
      "name": "planar_reflection_albedo",
      "extent_scale": 1.0,
      "width": "$resolution",
      "height": "$resolution",
      "layers": 2,
      "format": "B8G8R8A8_UNORM",
      "format_class": "scene",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED"]
    },
    {
      "name": "planar_reflection_normal",
      "extent_scale": 1.0,
      "width": "$resolution",
      "height": "$resolution",
      "layers": 2,
      "format": "R16G16B16A16_SFLOAT",
      "format_class": "data",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED"]
    },
    {
      "name": "planar_reflection_material",
      "extent_scale": 1.0,
      "width": "$resolution",
      "height": "$resolution",
      "layers": 2,
      "format": "R8G8B8A8_UNORM",
      "format_class": "data",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED"]
    },
    {
      "name": "planar_reflection_worldpos",
      "extent_scale": 1.0,
      "width": "$resolution",
      "height": "$resolution",
      "layers": 2,
      "format": "R16G16B16A16_SFLOAT",
      "format_class": "data",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED"]
    },
    {
      "name": "planar_reflection_emissive",
      "extent_scale": 1.0,
      "width": "$resolution",
      "height": "$resolution",
      "layers": 2,
      "format": "B8G8R8A8_UNORM",
      "format_class": "scene",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED"]
    },
    {
      "name": "planar_reflection_depth",
      "extent_scale": 1.0,
      "width": "$resolution",
      "height": "$resolution",
      "layers": 2,
      "format": "D32_SFLOAT",
      "format_class": "data",
      "usage": ["DEPTH_STENCIL_ATTACHMENT", "TRANSFER_SRC"]
    },
    {
      "name": "planar_reflection_ao",
      "extent_scale": 1.0,
      "width": "$resolution",
      "height": "$resolution",
      "layers": 2,
      "format": "R8_UNORM",
      "format_class": "data",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED"]
    },
    {
      "name": "planar_reflection_ao_blur",
      "extent_scale": 1.0,
      "width": "$resolution",
      "height": "$resolution",
      "layers": 2,
      "format": "R8_UNORM",
      "format_class": "data",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED"]
    },
    {
      "name": "planar_reflection_color",
      "extent_scale": 1.0,
      "width": "$resolution",
      "height": "$resolution",
      "layers": 2,
      "format": "R16G16B16A16_SFLOAT",
      "format_class": "explicit(R16G16B16A16_SFLOAT)",
      "usage": ["COLOR_ATTACHMENT", "STORAGE", "SAMPLED", "TRANSFER_SRC"],
      "mip_levels": 7
    },
    {
      "name": "planar_reflection_opaque_color",
      "extent_scale": 1.0,
      "width": "$resolution",
      "height": "$resolution",
      "layers": 2,
      "format": "R16G16B16A16_SFLOAT",
      "format_class": "explicit(R16G16B16A16_SFLOAT)",
      "usage": ["TRANSFER_DST", "SAMPLED"]
    },
    {
      "name": "planar_reflection_opaque_depth",
      "extent_scale": 1.0,
      "width": "$resolution",
      "height": "$resolution",
      "layers": 2,
      "format": "D32_SFLOAT",
      "format_class": "data",
      "usage": ["TRANSFER_DST", "SAMPLED"]
    }
  ],
  "passes": [
    {
      "insert": "begin",
      "pass": {
        "name": "planar_reflection_geometry",
        "type": "material",
        "material_contract": "deferred_geometry_v1",
        "resolution_domain": "independent",
        "view_family": "$reflection/planar",
        "output": {
          "color": [
            "planar_reflection_albedo",
            "planar_reflection_normal",
            "planar_reflection_material",
            "planar_reflection_worldpos",
            "planar_reflection_emissive"
          ],
          "depth": "planar_reflection_depth"
        },
        "depth_store_op": "store"
      }
    },
    {
      "insert": "after:planar_reflection_geometry",
      "pass": {
        "name": "planar_reflection_ssao",
        "type": "fullscreen",
        "resolution_domain": "independent",
        "view_family": "$reflection/planar",
        "output": {
          "color": ["planar_reflection_ao"],
          "depth": null
        },
        "input": [
          "planar_reflection_worldpos",
          "planar_reflection_normal"
        ],
        "resource_ports": {
          "world": {
            "resource": "planar_reflection_worldpos",
            "access": "sampled",
            "view": "per_view"
          },
          "normal": {
            "resource": "planar_reflection_normal",
            "access": "sampled",
            "view": "per_view"
          }
        },
        "push_constants": "projection_view",
        "shader": {
          "vertex": "engine://fullscreen",
          "fragment": "engine://ssao"
        },
        "clear_color": [1.0, 1.0, 1.0, 1.0]
      }
    },
    {
      "insert": "after:planar_reflection_ssao",
      "pass": {
        "name": "planar_reflection_ssao_blur",
        "type": "fullscreen",
        "resolution_domain": "independent",
        "view_family": "$reflection/planar",
        "output": {
          "color": ["planar_reflection_ao_blur"],
          "depth": null
        },
        "input": ["planar_reflection_ao"],
        "resource_ports": {
          "ssaoInput": {
            "resource": "planar_reflection_ao",
            "access": "sampled",
            "view": "per_view"
          }
        },
        "shader": {
          "vertex": "engine://fullscreen",
          "fragment": "engine://ssao_blur"
        },
        "clear_color": [1.0, 1.0, 1.0, 1.0]
      }
    },
    {
      "insert": "after:planar_reflection_ssao_blur",
      "pass": {
        "name": "planar_reflection_lighting",
        "type": "fullscreen",
        "inherit_bindings_from": "deferred_lighting",
        "resolution_domain": "independent",
        "view_family": "$reflection/planar",
        "output": {
          "color": ["planar_reflection_color"],
          "depth": null
        },
        "input": [
          "planar_reflection_albedo",
          "planar_reflection_normal",
          "planar_reflection_material",
          "planar_reflection_worldpos",
          "planar_reflection_emissive",
          "planar_reflection_ao_blur"
        ],
        "shader": {
          "vertex": "engine://fullscreen",
          "fragment": "engine://fullscreen"
        },
        "push_constants": "camera_position",
        "uses_light_data": true
      }
    },
    {
      "insert": "after:planar_reflection_lighting",
      "pass": {
        "name": "planar_reflection_forward_opaque",
        "type": "material",
        "material_contract": "forward_opaque_v1",
        "inherit_bindings_from": "forward_opaque",
        "resolution_domain": "independent",
        "view_family": "$reflection/planar",
        "output": {
          "color": ["planar_reflection_color"],
          "depth": "planar_reflection_depth"
        },
        "color_load_op": "load",
        "depth_load_op": "load",
        "depth_store_op": "store"
      }
    },
    {
      "insert": "after:planar_reflection_forward_opaque",
      "pass": {
        "name": "planar_reflection_snapshot_opaque_color",
        "type": "snapshot_copy",
        "view_family": "$reflection/planar",
        "source": "planar_reflection_color",
        "destination": "planar_reflection_opaque_color",
        "snapshot": "planar_reflection_opaque_color",
        "snapshot_after": "planar_reflection_forward_opaque"
      }
    },
    {
      "insert": "after:planar_reflection_snapshot_opaque_color",
      "pass": {
        "name": "planar_reflection_snapshot_opaque_depth",
        "type": "snapshot_copy",
        "view_family": "$reflection/planar",
        "source": "planar_reflection_depth",
        "destination": "planar_reflection_opaque_depth",
        "snapshot": "planar_reflection_opaque_depth",
        "snapshot_after": "planar_reflection_forward_opaque"
      }
    },
    {
      "insert": "after:planar_reflection_snapshot_opaque_depth",
      "pass": {
        "name": "planar_reflection_forward_transparent",
        "type": "material",
        "material_contract": "forward_transparent_v1",
        "inherit_bindings_from": "forward_transparent",
        "resolution_domain": "independent",
        "view_family": "$reflection/planar",
        "screen_inputs": {
          "opaque_color": "planar_reflection_opaque_color",
          "opaque_depth": "planar_reflection_opaque_depth",
          "scene_depth": "planar_reflection_opaque_depth",
          "linear_view_depth": "planar_reflection_opaque_depth"
        },
        "material_resources": {
          "planar_reflection": {
            "resource": "planar_reflection_opaque_color",
            "access": "sampled",
            "view": "family_array",
            "sampling": {
              "filter": "linear",
              "address": "clamp_to_edge"
            },
            "footprint": "arbitrary"
          }
        },
        "output": {
          "color": ["planar_reflection_color"],
          "depth": "planar_reflection_depth"
        },
        "color_load_op": "load",
        "depth_load_op": "load",
        "depth_store_op": "store"
      }
    }
  ],
  "compute_tasks": [
    {
      "name": "planar_reflection_filter_mip_1",
      "shader": "$prefilter_shader",
      "reads": ["planar_reflection_color"],
      "writes": ["planar_reflection_color"],
      "schedule": "per_view",
      "view_family": "$reflection/planar",
      "resource_ports": {
        "source_color": {
          "resource": "planar_reflection_color",
          "access": "sampled",
          "view": "family_array",
          "sampling": {
            "filter": "linear",
            "address": "clamp_to_edge"
          },
          "subresource": {
            "mip": 0,
            "layer": 0
          }
        },
        "filtered_color": {
          "resource": "planar_reflection_color",
          "access": "storage",
          "view": "family_array",
          "subresource": {
            "mip": 1,
            "layer": 0
          }
        }
      },
      "dispatch": {
        "groups_from": {
          "port": "filtered_color"
        }
      }
    },
    {
      "name": "planar_reflection_filter_mip_2",
      "shader": "$prefilter_shader",
      "reads": ["planar_reflection_color"],
      "writes": ["planar_reflection_color"],
      "schedule": "per_view",
      "view_family": "$reflection/planar",
      "resource_ports": {
        "source_color": {
          "resource": "planar_reflection_color",
          "access": "sampled",
          "view": "family_array",
          "sampling": {
            "filter": "linear",
            "address": "clamp_to_edge"
          },
          "subresource": {
            "mip": 1,
            "layer": 0
          }
        },
        "filtered_color": {
          "resource": "planar_reflection_color",
          "access": "storage",
          "view": "family_array",
          "subresource": {
            "mip": 2,
            "layer": 0
          }
        }
      },
      "dispatch": {
        "groups_from": {
          "port": "filtered_color"
        }
      }
    },
    {
      "name": "planar_reflection_filter_mip_3",
      "shader": "$prefilter_shader",
      "reads": ["planar_reflection_color"],
      "writes": ["planar_reflection_color"],
      "schedule": "per_view",
      "view_family": "$reflection/planar",
      "resource_ports": {
        "source_color": {
          "resource": "planar_reflection_color",
          "access": "sampled",
          "view": "family_array",
          "sampling": {
            "filter": "linear",
            "address": "clamp_to_edge"
          },
          "subresource": {
            "mip": 2,
            "layer": 0
          }
        },
        "filtered_color": {
          "resource": "planar_reflection_color",
          "access": "storage",
          "view": "family_array",
          "subresource": {
            "mip": 3,
            "layer": 0
          }
        }
      },
      "dispatch": {
        "groups_from": {
          "port": "filtered_color"
        }
      }
    },
    {
      "name": "planar_reflection_filter_mip_4",
      "shader": "$prefilter_shader",
      "reads": ["planar_reflection_color"],
      "writes": ["planar_reflection_color"],
      "schedule": "per_view",
      "view_family": "$reflection/planar",
      "resource_ports": {
        "source_color": {
          "resource": "planar_reflection_color",
          "access": "sampled",
          "view": "family_array",
          "sampling": {
            "filter": "linear",
            "address": "clamp_to_edge"
          },
          "subresource": {
            "mip": 3,
            "layer": 0
          }
        },
        "filtered_color": {
          "resource": "planar_reflection_color",
          "access": "storage",
          "view": "family_array",
          "subresource": {
            "mip": 4,
            "layer": 0
          }
        }
      },
      "dispatch": {
        "groups_from": {
          "port": "filtered_color"
        }
      }
    },
    {
      "name": "planar_reflection_filter_mip_5",
      "shader": "$prefilter_shader",
      "reads": ["planar_reflection_color"],
      "writes": ["planar_reflection_color"],
      "schedule": "per_view",
      "view_family": "$reflection/planar",
      "resource_ports": {
        "source_color": {
          "resource": "planar_reflection_color",
          "access": "sampled",
          "view": "family_array",
          "sampling": {
            "filter": "linear",
            "address": "clamp_to_edge"
          },
          "subresource": {
            "mip": 4,
            "layer": 0
          }
        },
        "filtered_color": {
          "resource": "planar_reflection_color",
          "access": "storage",
          "view": "family_array",
          "subresource": {
            "mip": 5,
            "layer": 0
          }
        }
      },
      "dispatch": {
        "groups_from": {
          "port": "filtered_color"
        }
      }
    },
    {
      "name": "planar_reflection_filter_mip_6",
      "shader": "$prefilter_shader",
      "reads": ["planar_reflection_color"],
      "writes": ["planar_reflection_color"],
      "schedule": "per_view",
      "view_family": "$reflection/planar",
      "before": ["forward_transparent"],
      "resource_ports": {
        "source_color": {
          "resource": "planar_reflection_color",
          "access": "sampled",
          "view": "family_array",
          "sampling": {
            "filter": "linear",
            "address": "clamp_to_edge"
          },
          "subresource": {
            "mip": 5,
            "layer": 0
          }
        },
        "filtered_color": {
          "resource": "planar_reflection_color",
          "access": "storage",
          "view": "family_array",
          "subresource": {
            "mip": 6,
            "layer": 0
          }
        }
      },
      "dispatch": {
        "groups_from": {
          "port": "filtered_color"
        }
      }
    }
  ],
  "pass_overrides": {
    "forward_transparent": {
      "material_resources": {
        "planar_reflection": {
          "resource": "planar_reflection_color",
          "access": "sampled",
          "view": "family_array",
          "sampling": {
            "filter": "linear",
            "address": "clamp_to_edge"
          },
          "subresource": {
            "mip": 0,
            "mip_count": "remaining",
            "layer": 0,
            "layer_count": 1
          },
          "footprint": "arbitrary"
        }
      }
    }
  }
}
