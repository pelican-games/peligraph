{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pelican://schemas/pelican.ui_semantic_coverage/1",
  "title": "pelican.ui_semantic_fixture coverage manifest v1",
  "description": "Closed schema for test/fixtures/ui_semantic/normative/coverage.json. Every entry is a structured object {fixture, gate, clause?} — no prose in paths. The semantic_invariant_coverage clause keys are closed here (required + additionalProperties:false), so adding an invariant clause in the design doc without covering it fails validation. Enum-value completeness against the fixture schema is checked by check_coverage.mjs, which must report exact set equality (not subset).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "description", "enum_coverage", "invalid_class_coverage", "semantic_invariant_coverage"],
  "properties": {
    "schema": { "const": "pelican.ui_semantic_fixture.coverage" },
    "version": { "const": 2 },
    "description": { "type": "string", "maxLength": 2000 },
    "enum_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_trace.kind", "input_trace.button", "effects", "consumed_vocabulary_class", "lifecycle.kind", "capture_cancel.reason", "command_dropped.reason", "errors.phase", "errors.code", "sampler"],
      "properties": {
        "input_trace.kind": { "$ref": "#/$defs/entry_map" },
        "input_trace.button": { "$ref": "#/$defs/entry_map" },
        "effects": { "$ref": "#/$defs/entry_map" },
        "consumed_vocabulary_class": { "$ref": "#/$defs/entry_map" },
        "lifecycle.kind": { "$ref": "#/$defs/entry_map" },
        "capture_cancel.reason": { "$ref": "#/$defs/entry_map" },
        "command_dropped.reason": { "$ref": "#/$defs/entry_map" },
        "errors.phase": { "$ref": "#/$defs/entry_map" },
        "errors.code": { "$ref": "#/$defs/entry_map" },
        "sampler": { "$ref": "#/$defs/entry_map" }
      }
    },
    "invalid_class_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_root_property", "unknown_enum_value", "variant_required_missing", "variant_forbidden_field", "numeric_range", "wrong_type", "unknown_error_code", "required_root_missing", "string_pattern", "null_value", "non_integer", "closed_vocabulary", "path_traversal", "unique_items", "multiple_of_6"],
      "properties": {
        "unknown_root_property": { "$ref": "#/$defs/entry" },
        "unknown_enum_value": { "$ref": "#/$defs/entry" },
        "variant_required_missing": { "$ref": "#/$defs/entry" },
        "variant_forbidden_field": { "$ref": "#/$defs/entry" },
        "numeric_range": { "$ref": "#/$defs/entry" },
        "wrong_type": { "$ref": "#/$defs/entry" },
        "unknown_error_code": { "$ref": "#/$defs/entry" },
        "required_root_missing": { "$ref": "#/$defs/entry" },
        "string_pattern": { "$ref": "#/$defs/entry" },
        "null_value": { "$ref": "#/$defs/entry" },
        "non_integer": { "$ref": "#/$defs/entry" },
        "closed_vocabulary": { "$ref": "#/$defs/entry" },
        "path_traversal": { "$ref": "#/$defs/entry" },
        "unique_items": { "$ref": "#/$defs/entry" },
        "multiple_of_6": { "$ref": "#/$defs/entry" }
      }
    },
    "semantic_invariant_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["I1_rect_order", "I2_ancestor_exists", "I3_clip_equality", "I4_id_unique", "I5a_decl_seq_monotonic", "I5b_event_seq_monotonic", "I6a_run0_zero", "I6b_total_match", "I7_unique_effects_consumed", "I8_scissor_containment", "I9_texture_traversal", "I10a_dangling_forbidden", "I10b_missing_not_allowed_reason", "I10c_missing_allowed_reasons", "I11a_capture_requires_target_down", "I11b_capture_only_on_down", "I11c_up_requires_release", "I11d_click_xor_drag", "I12_viewport_containment"],
      "properties": {
        "I1_rect_order": { "$ref": "#/$defs/entry" },
        "I2_ancestor_exists": { "$ref": "#/$defs/entry" },
        "I3_clip_equality": { "$ref": "#/$defs/entry" },
        "I4_id_unique": { "$ref": "#/$defs/entry" },
        "I5a_decl_seq_monotonic": { "$ref": "#/$defs/entry" },
        "I5b_event_seq_monotonic": { "$ref": "#/$defs/entry" },
        "I6a_run0_zero": { "$ref": "#/$defs/entry" },
        "I6b_total_match": { "$ref": "#/$defs/entry" },
        "I7_unique_effects_consumed": { "$ref": "#/$defs/entry" },
        "I8_scissor_containment": { "$ref": "#/$defs/entry" },
        "I9_texture_traversal": { "$ref": "#/$defs/entry" },
        "I10a_dangling_forbidden": { "$ref": "#/$defs/entry" },
        "I10b_missing_not_allowed_reason": { "$ref": "#/$defs/entry" },
        "I10c_missing_allowed_reasons": { "$ref": "#/$defs/entry" },
        "I11a_capture_requires_target_down": { "$ref": "#/$defs/entry" },
        "I11b_capture_only_on_down": { "$ref": "#/$defs/entry" },
        "I11c_up_requires_release": { "$ref": "#/$defs/entry" },
        "I11d_click_xor_drag": { "$ref": "#/$defs/entry" },
        "I12_viewport_containment": { "$ref": "#/$defs/entry" }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "gate"],
      "properties": {
        "fixture": { "type": "string", "pattern": "^(valid|invalid|semantic_invalid)/[a-z0-9_]+\\.json$" },
        "gate": { "enum": ["schema", "semantic"] },
        "clause": { "type": "string", "maxLength": 200 }
      }
    },
    "entry_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  }
}
