{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pelican://schemas/pelican.ui/1",
  "title": "pelican.ui v1 CPU document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "key", "root"],
  "properties": {
    "schema": { "const": "pelican.ui" },
    "version": { "const": 1 },
    "key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "revision": { "type": "string" },
    "direction": { "const": "ltr" },
    "root": { "$ref": "#/$defs/widget" }
  },
  "$defs": {
    "i32": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
    "axis": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["fixed", "content", "fill"] },
        "value": { "$ref": "#/$defs/i32" }, "min": { "$ref": "#/$defs/i32" },
        "max": { "$ref": "#/$defs/i32" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "vec2_number": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "rect_i32": { "type": "array", "items": { "$ref": "#/$defs/i32" }, "minItems": 4, "maxItems": 4 },
    "layout": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "x": { "$ref": "#/$defs/axis" }, "y": { "$ref": "#/$defs/axis" },
        "anchor_min": { "$ref": "#/$defs/vec2_number" }, "anchor_max": { "$ref": "#/$defs/vec2_number" },
        "offsets": { "$ref": "#/$defs/rect_i32" }, "padding": { "$ref": "#/$defs/rect_i32" },
        "stack": { "enum": ["none", "horizontal", "vertical"] }, "gap": { "$ref": "#/$defs/i32" },
        "align": { "enum": ["start", "center", "end", "stretch"] },
        "justify": { "enum": ["start", "center", "end", "space_between"] }
      }
    },
    "emit_field": {
      "type": "object", "additionalProperties": false, "required": ["name", "from"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "pattern": "^(static|stable_id|drag_delta_ui|widget_value\\((value|checked|text)\\))$" },
        "value": true
      }
    },
    "emit_binding": {
      "type": "object", "additionalProperties": false, "required": ["event"],
      "properties": {
        "event": { "type": "string", "minLength": 1 },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/emit_field" } }
      }
    },
    "emit": { "type": "object", "additionalProperties": { "$ref": "#/$defs/emit_binding" } },
    "widget": {
      "type": "object", "additionalProperties": false, "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 128 },
        "type": { "enum": ["panel", "image", "label", "button", "gauge", "stack"] },
        "layout": { "$ref": "#/$defs/layout" },
        "intrinsic_size": { "type": "array", "items": { "$ref": "#/$defs/i32" }, "minItems": 2, "maxItems": 2 },
        "visibility": { "enum": ["visible", "hidden", "collapsed"] },
        "overflow": { "enum": ["visible", "clip"] },
        "enabled": { "type": "boolean" }, "hit_testable": { "type": "boolean" },
        "layer": { "$ref": "#/$defs/i32" }, "emit": { "$ref": "#/$defs/emit" },
        "children": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/widget" } }
      }
    }
  }
}
