# Catch emits executable CMake with add_test, set_tests_properties, and the
# discovered test-list variable. Read it through argument-preserving wrappers
# instead of requiring Python for every GPU test link, including Python-OFF
# configurations. Bracket quoting keeps spaces, semicolons, and backslashes.
foreach(required IN ITEMS DIRECTORY TARGET LAUNCHER)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "patch_catch_gpu_lease_tests requires ${required}")
    endif()
endforeach()

function(pelican_quote value output)
    set(equals "==")
    while("${value}" MATCHES "]${equals}]")
        string(APPEND equals "=")
    endwhile()
    set(${output} "[${equals}[${value}]${equals}]" PARENT_SCOPE)
endfunction()

function(add_test)
    get_property(index GLOBAL PROPERTY PELICAN_DISCOVERY_COUNT)
    math(EXPR next "${index} + 1")
    set_property(GLOBAL PROPERTY PELICAN_DISCOVERY_COUNT ${next})
    string(SHA256 key "${ARGV0}")
    set_property(GLOBAL PROPERTY PELICAN_DISCOVERY_GPU_${key} FALSE)
    set_property(GLOBAL PROPERTY PELICAN_DISCOVERY_KEY_${index} "${key}")
    pelican_quote("${ARGV0}" name)
    set_property(GLOBAL PROPERTY PELICAN_DISCOVERY_NAME_${index} "${name}")
    set(command "")
    # Re-linking can run discovery against an already-patched file.
    set(first 1)
    if(ARGC GREATER 2 AND "${ARGV1}" STREQUAL "${LAUNCHER}" AND "${ARGV2}" STREQUAL "--")
        set(first 3)
    endif()
    math(EXPR last "${ARGC} - 1")
    foreach(argument RANGE ${first} ${last})
        pelican_quote("${ARGV${argument}}" quoted)
        string(APPEND command " ${quoted}")
    endforeach()
    set_property(GLOBAL PROPERTY PELICAN_DISCOVERY_COMMAND_${index} "${command}")
endfunction()

function(set_tests_properties)
    set(command "set_tests_properties(")
    string(SHA256 key "${ARGV0}")
    math(EXPR last "${ARGC} - 1")
    foreach(argument RANGE 0 ${last})
        pelican_quote("${ARGV${argument}}" quoted)
        string(APPEND command " ${quoted}")
        if("${ARGV${argument}}" STREQUAL "LABELS")
            math(EXPR value_index "${argument} + 1")
            set(labels "${ARGV${value_index}}")
            list(FIND labels "gpu" gpu_index)
            # Catch emits a second property call for Qt's DLL search path.
            # Only an explicit LABELS assignment changes GPU classification.
            set_property(GLOBAL PROPERTY PELICAN_DISCOVERY_GPU_${key} FALSE)
            if(NOT gpu_index EQUAL -1)
                set_property(GLOBAL PROPERTY PELICAN_DISCOVERY_GPU_${key} TRUE)
            endif()
        endif()
    endforeach()
    set_property(GLOBAL APPEND_STRING PROPERTY PELICAN_DISCOVERY_PROPERTIES
        "${command})\n")
endfunction()

file(GLOB discovery_files
    "${DIRECTORY}/${TARGET}-*_tests.cmake"
    "${DIRECTORY}/${TARGET}-*_tests-*.cmake")
if(NOT discovery_files)
    message(FATAL_ERROR "No Catch discovery output for ${TARGET} in ${DIRECTORY}")
endif()
foreach(discovery_file IN LISTS discovery_files)
    set_property(GLOBAL PROPERTY PELICAN_DISCOVERY_COUNT 0)
    set_property(GLOBAL PROPERTY PELICAN_DISCOVERY_PROPERTIES "")
    include("${discovery_file}")
    file(READ "${discovery_file}" contents)
    string(REGEX REPLACE "(^|\n)(add_test|set_tests_properties)\\([^\n]*\\)\n" "\\1" contents "${contents}")
    # Adjacent commands can share the newline consumed by the first match.
    string(REGEX REPLACE "(^|\n)(add_test|set_tests_properties)\\([^\n]*\\)\n" "\\1" contents "${contents}")
    get_property(count GLOBAL PROPERTY PELICAN_DISCOVERY_COUNT)
    set(commands "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            get_property(key GLOBAL PROPERTY PELICAN_DISCOVERY_KEY_${index})
            get_property(name GLOBAL PROPERTY PELICAN_DISCOVERY_NAME_${index})
            get_property(command GLOBAL PROPERTY PELICAN_DISCOVERY_COMMAND_${index})
            get_property(gpu GLOBAL PROPERTY PELICAN_DISCOVERY_GPU_${key})
            set(prefix "")
            if(gpu)
                pelican_quote("${LAUNCHER}" launcher)
                set(prefix " ${launcher} [==[--]==]")
            endif()
            string(APPEND commands "add_test(${name}${prefix}${command})\n")
        endforeach()
    endif()
    get_property(properties GLOBAL PROPERTY PELICAN_DISCOVERY_PROPERTIES)
    file(WRITE "${discovery_file}" "${commands}${properties}${contents}")
endforeach()
