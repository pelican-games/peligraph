cmake_minimum_required(VERSION 3.20)
foreach(required IN ITEMS PATCH_SCRIPT GLFW_DIR PRISTINE_GLFW_DIR OUT_DIR)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
file(REMOVE_RECURSE "${OUT_DIR}")
file(MAKE_DIRECTORY "${OUT_DIR}")

function(run_patch label source_dir expected_success)
  execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DPELICAN_GLFW_SOURCE_DIR=${source_dir}" -P "${PATCH_SCRIPT}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(expected_success AND NOT result EQUAL 0)
    message(FATAL_ERROR "${label} failed: ${result}\n${stdout}\n${stderr}")
  elseif(NOT expected_success AND result EQUAL 0)
    message(FATAL_ERROR "${label} unexpectedly succeeded")
  endif()
  set("${label}_STDOUT" "${stdout}" PARENT_SCOPE)
  set("${label}_STDERR" "${stderr}" PARENT_SCOPE)
endfunction()

find_package(Git)
if(GIT_FOUND)
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${PRISTINE_GLFW_DIR}" show HEAD:src/win32_joystick.c
    RESULT_VARIABLE pristine_result OUTPUT_VARIABLE pristine ERROR_VARIABLE pristine_error ENCODING NONE)
else()
  set(pristine_result 1)
  set(pristine_error "Git was not found")
endif()
if(pristine_result EQUAL 0)
  string(REPLACE "\r\n" "\n" pristine "${pristine}")
  file(WRITE "${OUT_DIR}/lf/src/win32_joystick.c" "${pristine}")
  string(REPLACE "\n" "\r\n" crlf "${pristine}")
  file(WRITE "${OUT_DIR}/crlf/src/win32_joystick.c" "${crlf}")
  run_patch(lf_pristine "${OUT_DIR}/lf" TRUE)
  run_patch(crlf_pristine "${OUT_DIR}/crlf" TRUE)
  file(READ "${OUT_DIR}/lf/src/win32_joystick.c" lf_patched)
  file(READ "${OUT_DIR}/crlf/src/win32_joystick.c" crlf_patched)
  foreach(text IN ITEMS lf_patched crlf_patched)
    string(FIND "${${text}}" "Altered by Pelican (DMAP-1a)" marker)
    string(FIND "${${text}}" "data->buttonCount >= 32" button_guard)
    if(marker EQUAL -1 OR button_guard EQUAL -1)
      message(FATAL_ERROR "${text} does not contain the complete patch")
    endif()
  endforeach()
  if(NOT lf_patched STREQUAL crlf_patched)
    message(FATAL_ERROR "LF and CRLF inputs produced different patched bytes")
  endif()
  run_patch(lf_second "${OUT_DIR}/lf" TRUE)
  file(READ "${OUT_DIR}/lf/src/win32_joystick.c" lf_second)
  if(NOT lf_second STREQUAL lf_patched)
    message(FATAL_ERROR "patching twice changed the patched bytes")
  endif()

  string(REPLACE "if (data->buttonCount >= 32)" "if (data->buttonCount >= 31)" partial "${pristine}")
  string(REPLACE "// Altered by Pelican" "// Altered by Pelican" partial "${partial}")
  file(WRITE "${OUT_DIR}/partial/src/win32_joystick.c" "${partial}")
  # A marker-only, otherwise pristine file is partial even without another edit.
  string(REPLACE "// Data produced with DirectInput device object enumeration"
    "// Altered by Pelican (DMAP-1a)\n// Data produced with DirectInput device object enumeration"
    partial "${pristine}")
  file(WRITE "${OUT_DIR}/partial/src/win32_joystick.c" "${partial}")
  run_patch(partial "${OUT_DIR}/partial" FALSE)
else()
  message(STATUS "UNVERIFIED: pristine source unavailable; pristine/CRLF/partial apply cases not run: ${pristine_error}")
endif()

file(MAKE_DIRECTORY "${OUT_DIR}/patched/src")
configure_file("${GLFW_DIR}/src/win32_joystick.c" "${OUT_DIR}/patched/src/win32_joystick.c" COPYONLY)
file(READ "${OUT_DIR}/patched/src/win32_joystick.c" patched_before)
run_patch(patched_again "${OUT_DIR}/patched" TRUE)
file(READ "${OUT_DIR}/patched/src/win32_joystick.c" patched_after)
if(NOT patched_before STREQUAL patched_after)
  message(FATAL_ERROR "fully patched input was not byte-stable")
endif()

file(WRITE "${OUT_DIR}/bad/src/win32_joystick.c" "int x;\n")
run_patch(bad "${OUT_DIR}/bad" FALSE)
string(REGEX REPLACE "[ \t\r\n]+" " " bad_error_normalized "${bad_STDERR}")
string(FIND "${bad_error_normalized}" "review the patch" review_message)
if(review_message EQUAL -1)
  message(FATAL_ERROR "unknown revision did not name patch review: ${bad_STDERR}")
endif()

file(READ "${PRISTINE_GLFW_DIR}/src/win32_joystick.c" input_after)
if(DEFINED pristine AND NOT input_after STREQUAL pristine)
  message(FATAL_ERROR "patch application modified the shared input checkout")
endif()
message(STATUS "glfw_dinput_patch_script: verified patched state and input isolation")
