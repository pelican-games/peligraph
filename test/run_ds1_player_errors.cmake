if(NOT DEFINED PLAYER OR NOT DEFINED OUT_DIR)
  message(FATAL_ERROR "PLAYER and OUT_DIR required")
endif()
file(MAKE_DIRECTORY "${OUT_DIR}")
set(ENV{PELICAN_NO_MESSAGEBOX} 1)
foreach(mode standalone rpc embedded console)
  set(extra)
  if(NOT mode STREQUAL "standalone")
    list(APPEND extra "--${mode}")
  endif()
  execute_process(COMMAND "${PLAYER}" --project "${OUT_DIR}/missing-project" ${extra}
    WORKING_DIRECTORY "${OUT_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
  file(WRITE "${OUT_DIR}/${mode}.log" "${out}\n${err}")
  if(result EQUAL 0 OR NOT err MATCHES "missing-project")
    message(FATAL_ERROR "${mode}: missing fatal diagnostic (${result}): ${err}")
  endif()
endforeach()
