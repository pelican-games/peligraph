{
  "schema": "pelican.render_feature",
  "version": 1,
  "name": "dummy_feature",
  "render_targets": [
    {
      "name": "feature_scratch",
      "extent_scale": 1.0,
      "format": "R8G8B8A8_UNORM",
      "format_class": "explicit(R8G8B8A8_UNORM)",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED"]
    }
  ],
  "render_target_overrides": {
    "lit_color": {
      "usage": ["TRANSFER_SRC"]
    }
  },
  "passes": [
    {
      "insert": "after:post_ldr",
      "pass": {
        "name": "feature_present",
        "type": "fullscreen",
        "output": {"color": "swapchain", "depth": null},
        "shader": {
          "vertex": "shaders/fullscreen",
          "fragment": "shaders/feature"
        }
      }
    }
  ],
  "shader_defines": ["PELICAN_FEATURE_DUMMY"]
}
