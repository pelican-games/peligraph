#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_ray_tracing : require
// Callable 0: a warm tint, as strong as its callable record's strength.
#include "__pelican_ray_group_layout.glsl"
layout(location = 0) callableDataInEXT vec4 callable_color;
layout(shaderRecordEXT, std430) buffer CallableRecord {
    float strength;
} record;
void main() {
    vec3 tinted = callable_color.rgb * vec3(1.0, 0.5, 0.25) + vec3(0.25, 0.05, 0.0);
    callable_color.rgb = mix(callable_color.rgb, tinted, record.strength);
}
