//! pelican.surface v1
//! language: glsl
//! params:
//!   - { name: tint, type: color, default: [0.2, 0.55, 1.0, 1.0], encoding: linear }
//! textures:
//!   - { name: detail, default: "engine://textures/white", color_space: srgb }

void pelican_vertex_displace_v1(inout PelicanVertexV1 vertex) {
    vertex.position.y += 0.05;
    vertex.custom0 = vec4(vertex.position, 1.0);
}

void pelican_surface_v1(in PelicanSurfaceInputV1 surface_input, inout PelicanSurfaceV1 surface) {
    surface.base_color *= pelican_param_tint();
    surface.base_color *= pelican_sample_detail(surface_input.uv);
    surface.roughness = 0.8;
}
