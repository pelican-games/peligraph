{
  "schema": "pelican.render_feature",
  "version": 1,
  "name": "glow",
  "runtime_shader_compiler": "optional",
  "render_targets": [
    {
      "name": "AcmeGlow_Downsample_RT",
      "extent_scale": 0.25,
      "format": "B8G8R8A8_UNORM",
      "format_class": "scene",
      "usage": ["COLOR_ATTACHMENT", "SAMPLED"]
    }
  ],
  "passes": [
    {
      "insert": "after:post_ldr",
      "pass": {
        "name": "AcmeGlowDownsample",
        "type": "fullscreen",
        "canonical_anchor": "post_ldr",
        "output": {
          "color": ["AcmeGlow_Downsample_RT"],
          "depth": null
        },
        "input": ["lit_color"],
        "shader": {
          "vertex": "engine://fullscreen",
          "fragment": "engine://bloom_upsample"
        },
        "clear_color": [0.0, 0.0, 0.0, 0.0]
      }
    },
    {
      "insert": "after:post_ldr",
      "pass": {
        "name": "AcmeGlowComposite",
        "type": "fullscreen",
        "canonical_anchor": "post_ldr",
        "output": {
          "color": ["swapchain"],
          "depth": null
        },
        "input": ["AcmeGlow_Downsample_RT"],
        "shader": {
          "vertex": "engine://fullscreen",
          "fragment": "engine://bloom_upsample"
        },
        "color_load_op": "Load",
        "raster_state": {
          "color_attachments": [
            {
              "blend": {
                "color": {"src": "one", "dst": "one", "op": "add"},
                "alpha": {"src": "one", "dst": "one", "op": "add"}
              }
            }
          ]
        }
      }
    }
  ]
}
