{
  "schema": "pelican.graph",
  "version": 1,
  "definitions": {
    "gain_curve": {
      "nodes": [
        {"id": "gain", "op": "graph.input", "default": 2},
        {"id": "bias", "op": "graph.input"},
        {"id": "sum", "op": "value.add",
         "inputs": {"a": {"node": "gain", "port": "value"},
                    "b": {"node": "bias", "port": "value"}},
         "outputs": ["value"]}
      ],
      "outputs": {"value": {"node": "sum", "port": "value"}}
    }
  },
  "nodes": [
    {"id": "clock", "op": "value.input", "parameters": {"name": "scene_time"}, "outputs": ["value"]},
    {"id": "left", "op": "graph.instance", "definition": "gain_curve",
     "owner": {"scene": "default_scene", "object": 1},
     "parameters": {"gain": 2.5, "bias": 5}}
  ],
  "outputs": {},
  "rendering": {
    "features": [
      "engine://features/bloom.json"
    ],
    "render_targets": [
      {
        "name": "gbuffer_albedo",
        "extent_scale": 1.0,
        "format": "B8G8R8A8_UNORM",
        "format_class": "scene",
        "usage": [
          "COLOR_ATTACHMENT",
          "SAMPLED"
        ]
      },
      {
        "name": "gbuffer_normal",
        "extent_scale": 1.0,
        "format": "R16G16B16A16_SFLOAT",
        "format_class": "data",
        "usage": [
          "COLOR_ATTACHMENT",
          "SAMPLED"
        ]
      },
      {
        "name": "gbuffer_material",
        "extent_scale": 1.0,
        "format": "R8G8B8A8_UNORM",
        "format_class": "data",
        "usage": [
          "COLOR_ATTACHMENT",
          "SAMPLED"
        ]
      },
      {
        "name": "g_emissive",
        "extent_scale": 1.0,
        "format": "R8G8B8A8_UNORM",
        "format_class": "scene",
        "usage": [
          "COLOR_ATTACHMENT",
          "SAMPLED"
        ]
      },
      {
        "name": "gbuffer_worldpos",
        "extent_scale": 1.0,
        "format": "R16G16B16A16_SFLOAT",
        "format_class": "data",
        "usage": [
          "COLOR_ATTACHMENT",
          "SAMPLED"
        ]
      },
      {
        "name": "offscreen_depth",
        "extent_scale": 1.0,
        "format": "D32_SFLOAT",
        "format_class": "data",
        "usage": [
          "DEPTH_STENCIL_ATTACHMENT",
          "TRANSFER_SRC"
        ]
      },
      {
        "name": "lit_color",
        "extent_scale": 1.0,
        "format": "R16G16B16A16_SFLOAT",
        "format_class": "explicit(R16G16B16A16_SFLOAT)",
        "role": "color",
        "usage": [
          "COLOR_ATTACHMENT",
          "SAMPLED",
          "TRANSFER_SRC"
        ]
      },
      {
        "name": "opaque_color",
        "extent_scale": 1.0,
        "format": "R16G16B16A16_SFLOAT",
        "format_class": "explicit(R16G16B16A16_SFLOAT)",
        "role": "color",
        "usage": [
          "TRANSFER_DST",
          "SAMPLED"
        ]
      },
      {
        "name": "opaque_depth",
        "extent_scale": 1.0,
        "format": "D32_SFLOAT",
        "format_class": "data",
        "usage": [
          "TRANSFER_DST",
          "SAMPLED"
        ]
      },
      {
        "name": "ssao_output",
        "extent_scale": 1.0,
        "format": "R8_UNORM",
        "format_class": "data",
        "usage": [
          "COLOR_ATTACHMENT",
          "SAMPLED"
        ]
      },
      {
        "name": "ssao_blur",
        "extent_scale": 1.0,
        "format": "R8_UNORM",
        "format_class": "data",
        "usage": [
          "COLOR_ATTACHMENT",
          "SAMPLED"
        ]
      }
    ],
    "rendering_passes": [
      {
        "name": "main_render",
        "passes": [
          {
            "name": "gbuffer_pass",
            "type": "material",
            "output": {
              "color": [
                "gbuffer_albedo",
                "gbuffer_normal",
                "gbuffer_material",
                "gbuffer_worldpos",
                "g_emissive"
              ],
              "depth": "offscreen_depth"
            }
          },
          {
            "name": "ssao_pass",
            "type": "fullscreen",
            "output": {
              "color": [
                "ssao_output"
              ],
              "depth": null
            },
            "input": [
              "gbuffer_worldpos",
              "gbuffer_normal"
            ],
            "resource_ports": {
              "world": {
                "resource": "gbuffer_worldpos",
                "access": "sampled",
                "view": "per_view"
              },
              "normal": {
                "resource": "gbuffer_normal",
                "access": "sampled",
                "view": "per_view"
              }
            },
            "push_constants": "projection_view",
            "shader": {
              "vertex": "engine://fullscreen",
              "fragment": "engine://ssao"
            },
            "clear_color": [
              1.0,
              1.0,
              1.0,
              1.0
            ]
          },
          {
            "name": "ssao_blur_pass",
            "type": "fullscreen",
            "output": {
              "color": [
                "ssao_blur"
              ],
              "depth": null
            },
            "input": [
              "ssao_output"
            ],
            "resource_ports": {
              "ssaoInput": {
                "resource": "ssao_output",
                "access": "sampled",
                "view": "per_view"
              }
            },
            "shader": {
              "vertex": "engine://fullscreen",
              "fragment": "engine://ssao_blur"
            },
            "clear_color": [
              1.0,
              1.0,
              1.0,
              1.0
            ]
          },
          {
            "name": "lighting_pass",
            "type": "fullscreen",
            "output": {
              "color": [
                "lit_color"
              ],
              "depth": null
            },
            "input": [
              "gbuffer_albedo",
              "gbuffer_normal",
              "gbuffer_material",
              "gbuffer_worldpos",
              "g_emissive",
              "ssao_blur"
            ],
            "shader": {
              "vertex": "engine://fullscreen",
              "fragment": "engine://fullscreen"
            },
            "push_constants": "camera_position",
            "uses_light_data": true
          },
          {
            "name": "__snapshot_opaque_color",
            "type": "snapshot_copy",
            "source": "lit_color",
            "destination": "opaque_color",
            "snapshot": "opaque_color",
            "snapshot_after": "lighting_pass"
          },
          {
            "name": "__snapshot_opaque_depth",
            "type": "snapshot_copy",
            "source": "offscreen_depth",
            "destination": "opaque_depth",
            "snapshot": "opaque_depth",
            "snapshot_after": "lighting_pass"
          },
          {
            "name": "forward_transparent",
            "type": "material",
            "material_contract": "forward_transparent_v1",
            "screen_inputs": {
              "opaque_color": "opaque_color",
              "opaque_depth": "opaque_depth",
              "scene_depth": "opaque_depth",
              "linear_view_depth": "opaque_depth"
            },
            "output": {
              "color": [
                "lit_color"
              ],
              "depth": "offscreen_depth"
            },
            "color_load_op": "load",
            "depth_load_op": "load",
            "depth_store_op": "store"
          }
        ]
      }
    ]
  }
}
