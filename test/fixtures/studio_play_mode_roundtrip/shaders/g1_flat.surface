//! pelican.surface v1
//! language: glsl
//! params:
//!   - { name: tint, type: color, default: [1.0, 0.45, 0.05, 1.0], encoding: linear }

void pelican_surface_v1(in PelicanSurfaceInputV1 input_data, inout PelicanSurfaceV1 surface) {
    surface.base_color = pelican_param_tint();
    surface.roughness = 0.8;
}

// Lit by nothing: the box is its tint wherever it covers the screen, so the
// scenario can tell it from the cleared target without depending on a light.
vec3 pelican_lighting_v1(in PelicanSurfaceV1 surface, in PelicanSurfaceInputV1 input_data) {
    return pelican_param_tint().rgb;
}
