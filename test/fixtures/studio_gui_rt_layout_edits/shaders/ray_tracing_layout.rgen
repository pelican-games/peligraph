#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_ray_tracing : require

// ray_tracing_layout.rgen: a ray tracing set Studio wrote for a ray layout.
// One ray per pixel of the image it writes (the task's dispatch.rays_from),
// from the camera through that pixel. The hit group the object is assigned
// to answers with the colour; the miss shader with the sky.

// The ray layout's names: PELICAN_RAY_TYPE_<ray type>, PELICAN_MISS_<miss>
// and pelican_ray_type_count, generated from the project's ray layout.
#include "__pelican_ray_group_layout.glsl"
#include "pelican_sets.glsl"
#include "pelican_frame.glsl"

layout(rgba16f, set = PELICAN_SET_PASS_INPUT, binding = 0)
    writeonly uniform image2D pelican_resource_color;

layout(set = PELICAN_SET_FRAME, binding = PELICAN_RAY_QUERY_TLAS_BINDING)
    uniform accelerationStructureEXT pelicanRayTracingScene;

// The payload: rgb is the colour, w is 1 on a hit and 0 when the miss ran.
layout(location = 0) rayPayloadEXT vec4 hit;

void main() {
    vec2 pixel = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    vec2 ndc = pixel / vec2(gl_LaunchSizeEXT.xy) * 2.0 - 1.0;
    vec4 target = inverse(pelicanFrame.projection) * vec4(ndc, 0.5, 1.0);
    vec3 direction = normalize((inverse(pelicanFrame.view) *
                                vec4(normalize(target.xyz / target.w), 0.0)).xyz);
    vec3 origin = (inverse(pelicanFrame.view) * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    hit = vec4(0.0);
    // A second ray type (a shadow ray, say) is traced the same way with its
    // own PELICAN_RAY_TYPE_ and PELICAN_MISS_ names.
    traceRayEXT(pelicanRayTracingScene, gl_RayFlagsOpaqueEXT, 0xff,
                PELICAN_RAY_TYPE_primary, pelican_ray_type_count,
                PELICAN_MISS_miss, origin, 0.001, direction, 10000.0, 0);
    vec3 color = hit.w > 0.5 ? hit.rgb
                             : mix(vec3(0.04, 0.05, 0.07), vec3(0.18, 0.26, 0.36),
                                   clamp(direction.y * 0.5 + 0.5, 0.0, 1.0));
    imageStore(pelican_resource_color, ivec2(gl_LaunchIDEXT.xy), vec4(color, 1.0));
}
