{
  "schema": "pelican.graph",
  "version": 1,
  "definitions": {},
  "nodes": [
    {"id": "clock", "op": "value.input", "parameters": {"name": "scene_time"},
     "outputs": ["value"]},
    {"id": "fade_linear", "op": "value.curve",
     "inputs": {"time": {"node": "clock", "port": "value"}},
     "parameters": {"keys": [{"time": 0.0, "value": 0.0},
                             {"time": 1.0, "value": 1.0},
                             {"time": 3.0, "value": 0.25}]},
     "outputs": ["value"]},
    {"id": "flash_step", "op": "value.curve",
     "inputs": {"time": {"node": "clock", "port": "value"}},
     "parameters": {"keys": [{"time": 0.0, "value": 0.0, "interpolation": "step"},
                             {"time": 0.5, "value": 1.0, "interpolation": "step"},
                             {"time": 2.0, "value": 0.25, "interpolation": "step"}]},
     "outputs": ["value"]},
    {"id": "wobble_cubic", "op": "value.curve",
     "inputs": {"time": {"node": "clock", "port": "value"}},
     "parameters": {"keys": [{"time": 0.0, "value": 0.0, "interpolation": "cubic", "out_tangent": 2.0},
                             {"time": 1.5, "value": 1.0, "interpolation": "cubic",
                              "in_tangent": 0.0, "out_tangent": -1.0},
                             {"time": 3.0, "value": -0.5, "interpolation": "cubic", "in_tangent": 0.5}]},
     "outputs": ["value"]}
  ],
  "outputs": {}
}
