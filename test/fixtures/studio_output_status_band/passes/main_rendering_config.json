{
  "schema": "pelican.graph",
  "version": 1,
  "definitions": {},
  "nodes": [
    {
      "id": "capture_target",
      "op": "render.image",
      "parameters": {
        "type": {
          "semantic": "pelican.render.color_signal@1",
          "arguments": {
            "reference": "scene",
            "transfer": "linear",
            "range": "extended"
          }
        },
        "format": "R8G8B8A8_UNORM",
        "width": 4,
        "height": 4,
        "extent_scale": 1.0,
        "usage": ["COLOR_ATTACHMENT", "SAMPLED"]
      },
      "outputs": ["resource"]
    },
    {
      "id": "capture_fill",
      "op": "render.fullscreen",
      "parameters": {
        "pass_set": "main_render",
        "shader": {
          "vertex": "engine://fullscreen",
          "fragment": "project://shaders/output_band"
        },
        "ports": {
          "color": {
            "kind": "image",
            "type": {
              "semantic": "pelican.render.color_signal@1",
              "arguments": {
                "reference": "scene",
                "transfer": "linear",
                "range": "extended"
              }
            },
            "access": "write",
            "attachment": "color",
            "location": 0
          }
        }
      },
      "inputs": {
        "color": { "node": "capture_target", "port": "resource" }
      },
      "outputs": ["color"]
    },
    {
      "id": "capture_output",
      "op": "output.file",
      "parameters": {
        "name": "shot",
        "every_n": 1,
        "enabled": true,
        "format": "raw",
        "when_full": "drop"
      },
      "inputs": {
        "source": { "node": "capture_fill", "port": "color" }
      },
      "outputs": []
    }
  ],
  "outputs": {},
  "rendering": {
    "rendering_passes": [
      {
        "name": "main_render",
        "passes": [
          {
            "name": "present",
            "type": "fullscreen",
            "input": [],
            "output": {
              "color": [{ "target": "display" }],
              "depth": null
            },
            "shader": {
              "vertex": "engine://fullscreen",
              "fragment": "engine://passthrough"
            }
          }
        ]
      }
    ]
  }
}
