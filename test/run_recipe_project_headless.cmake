foreach(required PLAYER PROJECT_DIR OUT_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(MAKE_DIRECTORY "${OUT_DIR}")
foreach(mode legacy recipe recipe_lit)
    set(project "${OUT_DIR}/${mode}")
    file(MAKE_DIRECTORY "${project}")
    file(COPY "${PROJECT_DIR}/" DESTINATION "${project}" PATTERN "build" EXCLUDE PATTERN "code" EXCLUDE)
    set(config "${project}/passes/main.json")
    file(READ "${config}" root)
    if(NOT mode STREQUAL legacy)
        if(mode STREQUAL recipe_lit)
            string(JSON root SET "${root}" rendering pipeline preset "\"engine://render_pipelines/experimental/hybrid_recipe_lit.json\"")
            string(JSON shadow GET "${root}" rendering features 0)
            string(JSON sky GET "${root}" rendering features 1)
            if(NOT shadow STREQUAL "engine://features/shadow_directional.json" OR NOT sky STREQUAL "engine://features/sky_ambient.json")
                message(FATAL_ERROR "lit comparison requires the original shadow/sky pair")
            endif()
            string(JSON root REMOVE "${root}" rendering features 1)
            string(JSON root REMOVE "${root}" rendering features 0)
        else()
            string(JSON root SET "${root}" rendering pipeline preset "\"engine://render_pipelines/experimental/hybrid_recipe.json\"")
        endif()
        file(WRITE "${config}" "${root}\n")
    endif()
    execute_process(COMMAND "${PLAYER}" --headless --project "${project}" --frames 3 --size 160x90 --fps 30
        --render-out "${OUT_DIR}/${mode}.png" --dump-frame-plan
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    file(WRITE "${OUT_DIR}/${mode}.log" "${stdout}\n${stderr}")
    if(NOT result EQUAL 0 OR "${stdout}${stderr}" MATCHES "Validation Error|VUID-")
        message(FATAL_ERROR "${mode} failed: ${result}\n${stdout}\n${stderr}")
    endif()
    if(NOT stderr MATCHES "\"graph\": \"main_render\"")
        message(FATAL_ERROR "${mode} did not execute main_render")
    endif()
    if(NOT mode STREQUAL legacy)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT_DIR}/legacy.png" "${OUT_DIR}/${mode}.png" RESULT_VARIABLE difference)
        if(NOT difference EQUAL 0)
            message(FATAL_ERROR "${mode} PNG differs from legacy")
        endif()
    endif()
endforeach()
