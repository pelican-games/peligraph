{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "canvas_text_blend_from_blank",
  "description": "SG-3: text, a blend mode and an adjustment layer on a 2D canvas, from File > New Project > Blank with the Layers dock only. + Canvas places a canvas.output and its 1280 x 720 stack and puts the output's image on present's inputs; + Rect puts a rectangle at the middle and Color: Red repaints it. + Text... opens the text dialog: the text is typed, the font is the system's Arial (the face CV-4's tests draw with; this scenario's prepare script copies it into the run's incoming/ folder, the repository holding no font), brought in with Import font..., which copies it into the project's assets/fonts, and the size is picked from the list (288). OK adds a shape.text centred on the canvas's middle, its white fill and a layer on top in one edit, and the H's left stem, over the rectangle, turns white. Its blend set to Multiply in the picked row's fields, white times red is the rectangle's red again. + Adjustment > Invert puts a canvas.backdrop under a filter.invert above the text: the rectangle's red, under the text and beside it, turns to its inverse; Delete takes the adjustment away and the red is back. A corner of the canvas stays empty throughout. Typed: the project folder and name, the text and the font's file name in Qt's file dialog (as the sound import's scenario does).",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "timeout_ms": 10000, "visible": true},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "canvas_text"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "timeout_ms": 10000, "missing": true},
    {"label": "the blank project's present is on the Frame Plan canvas", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "timeout_ms": 180000, "visible": true},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the Graph tab is in front (its notice says what each edit did)", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the canvas can edit the new document", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "the Layers dock is on screen", "cmd": "wait", "name": "pelican.layersDock", "timeout_ms": 10000, "visible": true},
    {"label": "no canvas yet: + Canvas alone", "cmd": "wait", "name": "pelican.canvasLayers.addCanvas", "timeout_ms": 60000, "visible": true, "enabled": true},
    {"label": "+ Canvas", "cmd": "click", "name": "pelican.canvasLayers.addCanvas"},
    {"label": "the canvas is placed", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].op", "value": "canvas.output", "retry_ms": 120000},
    {"label": "and put on present's inputs", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Pass inputs saved."},
    {"label": "the dock shows its stack", "cmd": "wait", "name": "pelican.canvasLayers.title", "timeout_ms": 60000, "visible": true, "contains": "canvas_stack"},
    {"label": "no 3D pass in the Blank pipeline: Place in 3D scene is off", "cmd": "wait", "name": "pelican.canvasLayers.placeInScene", "timeout_ms": 60000, "visible": true, "enabled": false},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the empty canvas: remember a corner", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[2]", "remember": "corner"},
    {"label": "and where the H's stem will be", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[0]", "remember": "empty"},

    {"label": "the dock takes edits", "cmd": "wait", "name": "pelican.canvasLayers.addRect", "timeout_ms": 120000, "visible": true, "enabled": true},
    {"label": "+ Rect", "cmd": "click", "name": "pelican.canvasLayers.addRect"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the rectangle's row, picked", "cmd": "wait", "name": "pelican.canvasLayers.row0.name", "timeout_ms": 60000, "visible": true, "text": "Rect 1"},
    {"label": "the colour field", "cmd": "wait", "name": "pelican.canvasLayers.field.color", "timeout_ms": 60000, "visible": true, "enabled": true},
    {"label": "Color: Red", "cmd": "select", "name": "pelican.canvasLayers.field.color", "text": "Red"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the fill is red", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[3].parameters.color", "value": [0.9, 0.2, 0.2, 1.0], "retry_ms": 60000},
    {"label": "the rectangle covers the stem's place", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[0]", "op": "ne", "value_of": "empty", "retry_ms": 60000},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "remember the red there", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[0]", "remember": "red"},
    {"label": "and under where the text will be", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[1]", "remember": "red_below"},

    {"label": "the dock takes edits", "cmd": "wait", "name": "pelican.canvasLayers.addText", "timeout_ms": 120000, "visible": true, "enabled": true},
    {"label": "+ Text...", "cmd": "click", "name": "pelican.canvasLayers.addText"},
    {"label": "the text dialog", "cmd": "wait", "name": "pelican.canvasTextDialog", "timeout_ms": 20000, "visible": true},
    {"label": "no font in the project yet: OK waits", "cmd": "wait", "name": "pelican.canvasTextDialog.ok", "timeout_ms": 10000, "enabled": false},
    {"label": "the text", "cmd": "type", "name": "pelican.canvasTextDialog.text", "text": "Hi"},
    {"label": "Import font...", "cmd": "click", "name": "pelican.canvasTextDialog.importFont"},
    {"label": "the font dialog", "cmd": "wait", "name": "pelican.canvasFontDialog", "timeout_ms": 20000, "visible": true},
    {"label": "the font: the one the prepare script put in incoming/", "cmd": "type", "name": "pelican.canvasFontDialog.fileName", "text": "{artifacts}/incoming/arial.ttf"},
    {"label": "Return opens it", "cmd": "key", "name": "pelican.canvasFontDialog.fileName", "sequence": "Return"},
    {"label": "the dialog's loop ends", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "zz-never-shown", "timeout_ms": 400, "expect_error": "automation.wait_timeout@1"},
    {"label": "the font dialog closed", "cmd": "wait", "name": "pelican.canvasFontDialog", "timeout_ms": 20000, "missing": true},
    {"label": "the copy is in the project", "file": "exists", "path": "{artifacts}/canvas_text/assets/fonts/arial.ttf", "value": true},
    {"label": "and is the dialog's font", "cmd": "wait", "name": "pelican.canvasTextDialog.font", "timeout_ms": 10000, "text": "assets/fonts/arial.ttf"},
    {"label": "the size: picked from the list", "cmd": "select", "name": "pelican.canvasTextDialog.size", "text": "288"},
    {"label": "OK can be pressed", "cmd": "wait", "name": "pelican.canvasTextDialog.ok", "timeout_ms": 10000, "enabled": true},
    {"label": "OK", "cmd": "click", "name": "pelican.canvasTextDialog.ok"},
    {"label": "the text dialog closed", "cmd": "wait", "name": "pelican.canvasTextDialog", "timeout_ms": 20000, "missing": true},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "a shape.text centred on the canvas's middle", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[4].parameters", "value": {"font": "project://assets/fonts/arial.ttf", "text": "Hi", "size": 288, "origin": [640, 360], "align": "center"}, "retry_ms": 60000},
    {"label": "painted white", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[5].parameters.color", "value": [1.0, 1.0, 1.0, 1.0]},
    {"label": "a layer on top, named after the text", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers[1]", "value": {"input": "text_1", "name": "Hi"}},
    {"label": "its row, picked", "cmd": "wait", "name": "pelican.canvasLayers.row0.name", "timeout_ms": 60000, "visible": true, "text": "Hi"},
    {"label": "a text row", "cmd": "wait", "name": "pelican.canvasLayers.row0.pick", "timeout_ms": 10000, "text": "Text"},
    {"label": "its text fields", "cmd": "wait", "name": "pelican.canvasLayers.field.textSize", "timeout_ms": 30000, "visible": true},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the H's stem is white over the red", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[0]", "value": "#ffffff", "retry_ms": 60000},
    {"label": "under the text it is red still", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[1]", "value_of": "red_below"},

    {"label": "the blend field", "cmd": "wait", "name": "pelican.canvasLayers.field.blend", "timeout_ms": 60000, "visible": true, "enabled": true},
    {"label": "Blend: Multiply", "cmd": "select", "name": "pelican.canvasLayers.field.blend", "text": "Multiply"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the layer multiplies", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers[1]", "value": {"input": "text_1", "name": "Hi", "blend": "multiply"}, "retry_ms": 60000},
    {"label": "the row says so", "cmd": "wait", "name": "pelican.canvasLayers.row0.blend", "timeout_ms": 30000, "visible": true, "text": "Multiply"},
    {"label": "white times red is red: the stem is the rectangle's red again", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[0]", "value_of": "red", "retry_ms": 60000},

    {"label": "+ Adjustment > Invert", "cmd": "action", "name": "pelican.canvasLayers.addAdjustment.invert"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "a backdrop", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[6].op", "value": "canvas.backdrop", "retry_ms": 60000},
    {"label": "under the filter", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[7].inputs.layer.node", "value": "invert_1_backdrop"},
    {"label": "as the layer above the text", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers[2]", "value": {"input": "invert_1", "name": "Invert 1"}},
    {"label": "its row, picked", "cmd": "wait", "name": "pelican.canvasLayers.row0.name", "timeout_ms": 60000, "visible": true, "text": "Invert 1"},
    {"label": "an adjustment row", "cmd": "wait", "name": "pelican.canvasLayers.row0.pick", "timeout_ms": 10000, "text": "Adjustment"},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the red under the text is inverted", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[1]", "op": "ne", "value_of": "red_below", "retry_ms": 60000},
    {"label": "the inverse of the red in linear light is cyan (1 - 0.787, 1 - 0.033, 1 - 0.033)", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[1]", "value": "#7ffbfb", "remember": "inverted"},
    {"label": "and the stem, red after the multiply, is the same inverse", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[0]", "value_of": "inverted"},

    {"label": "the dock takes edits", "cmd": "wait", "name": "pelican.canvasLayers.delete", "timeout_ms": 120000, "enabled": true},
    {"label": "Delete the adjustment", "cmd": "click", "name": "pelican.canvasLayers.delete"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the layer is gone", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers", "value": [{"input": "rect_1", "name": "Rect 1"}, {"input": "text_1", "name": "Hi", "blend": "multiply"}], "retry_ms": 60000},
    {"label": "and its nodes with it", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[5].id", "value": "text_1_fill"},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the red is back under the text", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[1]", "value_of": "red_below", "retry_ms": 60000},
    {"label": "and on the stem", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[0]", "value_of": "red"},
    {"label": "the corner is still empty", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.4224, 0.4583], [0.5, 0.6], [0.04, 0.06]]}, "path": "pixels[2]", "value_of": "corner"},
    {"label": "a picture of the window", "expect": "screenshot", "path": "canvas_text_blend_window.png"}
  ]
}
