{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "gui_build_B",
  "description": "GB-1 target B (deferred + lighting), built from File > New Project > Blank with Studio's GUI only. The route that goes through is the Frame Plan's: Add material pass... with Deferred geometry (its five G-buffer targets and depth filled as the form opens), Add fullscreen pass after it, New... > Deferred lighting (the five inputs, Uses scene lights and Camera position filled in), its colour output a New target from the output list, Create, Save; then the lighting pass's output dragged onto present's + input on the Frame Plan canvas (present draws with engine://passthrough). The viewport shows the box the scene's light lights: a middle that is neither the gradient nor the background, and more than two colours. Typed: the project folder in New Project and the name gb_b. The route through the Graph tab's palette (a render.material_pass of deferred_geometry_v1) stops: a Pass Editor pass after it runs after present, and present cannot be moved (render_pipeline_preflight_failed); see the GB-1 report.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "start from the default layout", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "visible": true, "timeout_ms": 10000},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "gb_b"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "missing": true, "timeout_ms": 10000},
    {"label": "present is on the Frame Plan canvas", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "visible": true, "timeout_ms": 180000},
    {"label": "the new engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "Add Object > Cube", "cmd": "action", "name": "pelican.outliner.addObject.cube"},
    {"label": "the engine has a Cube", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[2].name", "value": "Cube", "retry_ms": 60000},
    {"label": "the Inspector has read the Cube", "cmd": "wait", "name": "pelican.inspectorModelChoice", "text": "Cube (built-in)", "timeout_ms": 60000},
    {"label": "File > Save Scene", "cmd": "action", "name": "pelican.file.saveScene"},
    {"label": "the save is done", "cmd": "wait", "name": "pelican.inspectorNotice", "contains": "Scene saved", "timeout_ms": 60000},
    {"label": "Add material pass...", "cmd": "action", "name": "pelican.framePlan.addMaterialPass"},
    {"label": "the form is open", "cmd": "wait", "name": "pelican.materialPassForm.name", "visible": true, "timeout_ms": 60000},
    {"label": "Deferred geometry", "cmd": "select", "name": "pelican.materialPassForm.contract", "text": "Deferred geometry (G-buffer)"},
    {"label": "named after it, nothing typed", "expect": "text_equals", "name": "pelican.materialPassForm.name", "value": "deferred_geometry"},
    {"label": "Save: the targets, then the pass", "cmd": "click", "name": "pelican.materialPassForm.ok"},
    {"label": "the form closed", "cmd": "wait", "name": "pelican.materialPassForm.name", "visible": false, "timeout_ms": 10000},
    {"label": "the engine runs deferred_geometry first", "expect": "rpc_equals", "method": "get_render_authoring_context", "params": {}, "path": "graphs[0].passes[0].name", "value": "deferred_geometry", "retry_ms": 120000},
    {"label": "the whole frame", "cmd": "select", "name": "pelican.framePlanTarget", "text": "Whole frame"},
    {"label": "deferred_geometry is drawn", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#deferred_geometry", "visible": true, "timeout_ms": 120000},
    {"label": "fit", "cmd": "action", "name": "pelican.framePlan.fitView"},
    {"label": "pick deferred_geometry by its heading", "cmd": "click", "name": "pelican.framePlanLogicalView::node_header#deferred_geometry"},
    {"label": "Add fullscreen pass after it", "cmd": "action", "name": "pelican.framePlan.addFullscreenPass"},
    {"label": "the Pass Editor has the authoring context", "cmd": "wait", "name": "pelican.fullscreenPass.authoringStatus", "contains": "graph(s)", "timeout_ms": 180000},
    {"label": "and the frame plan", "cmd": "wait", "name": "pelican.fullscreenPass.planStatus", "contains": "resources", "timeout_ms": 180000},
    {"label": "New... beside the fragment stem", "cmd": "click", "name": "pelican.fullscreenPass.newFragmentShader"},
    {"label": "start from Deferred lighting", "cmd": "select", "name": "pelican.fullscreenPass.shaderTemplateKind", "text": "Deferred lighting"},
    {"label": "the five inputs filled themselves from the G-buffer names", "cmd": "wait", "name": "pelican.fullscreenPass.json", "contains": "\"gbuffer_albedo\",\n    \"gbuffer_normal\",\n    \"gbuffer_material\",\n    \"gbuffer_worldpos\",\n    \"gbuffer_emissive\"", "timeout_ms": 10000},
    {"label": "Camera position is on", "expect": "text_equals", "name": "pelican.fullscreenPass.pushConstants", "value": "Camera position"},
    {"label": "the colour output: New target from the output list", "cmd": "select", "name": "pelican.fullscreenPass.colorTarget", "text": "New target: deferred_lighting_color..."},
    {"label": "New render target opens with the name in it", "cmd": "wait", "name": "pelican.renderTargetForm.name", "visible": true, "timeout_ms": 60000},
    {"label": "OK", "cmd": "click", "name": "pelican.renderTargetForm.ok"},
    {"label": "the draft writes it", "cmd": "wait", "name": "pelican.fullscreenPass.json", "contains": "\"deferred_lighting_color\"", "timeout_ms": 60000},
    {"label": "create the shader", "cmd": "click", "name": "pelican.fullscreenPass.createFragmentShader"},
    {"label": "the fragment field holds its stem", "cmd": "wait", "name": "pelican.fullscreenPass.shader.fragment", "text": "project://shaders/deferred_lighting", "timeout_ms": 30000},
    {"label": "Save is ready", "cmd": "wait", "name": "pelican.fullscreenPass.save", "enabled": true, "timeout_ms": 60000},
    {"label": "save the pass", "cmd": "click", "name": "pelican.fullscreenPass.save"},
    {"label": "the engine runs deferred_lighting after the geometry", "expect": "rpc_equals", "method": "get_render_authoring_context", "params": {}, "path": "graphs[0].passes[1].name", "value": "deferred_lighting", "retry_ms": 180000},
    {"label": "with the scene lights", "expect": "rpc_equals", "method": "get_render_authoring_context", "params": {}, "path": "graphs[0].passes[1].declaration.uses_light_data", "value": true, "retry_ms": 60000},
    {"label": "close the Pass Editor (View > Panels)", "cmd": "action", "name": "pelican.view.panels.fullscreenPassDock"},
    {"label": "the whole frame again", "cmd": "select", "name": "pelican.framePlanTarget", "text": "Whole frame"},
    {"label": "fit", "cmd": "action", "name": "pelican.framePlan.fitView"},
    {"label": "the lighting pass's output socket is drawn", "cmd": "wait", "name": "pelican.framePlanLogicalView::node_socket#deferred_lighting/out:deferred_lighting_color", "visible": true, "timeout_ms": 120000},
    {"label": "present offers its + input", "cmd": "wait", "name": "pelican.framePlanLogicalView::node_socket#present/in:variadic", "visible": true, "timeout_ms": 60000},
    {"label": "the lit colour onto present's + input", "cmd": "drag", "from": {"name": "pelican.framePlanLogicalView::node_socket#deferred_lighting/out:deferred_lighting_color"}, "to": {"name": "pelican.framePlanLogicalView::node_socket#present/in:variadic"}, "steps": 8},
    {"label": "the root's present reads deferred_lighting_color", "expect": "rpc_equals", "method": "get_render_authoring_context", "params": {}, "path": "graphs[0].passes[2].root_declaration.input[0]", "value": "deferred_lighting_color", "retry_ms": 120000},
    {"label": "pick the camera, so no gizmo is drawn over the box", "cmd": "select", "name": "pelican.outliner", "text": "MainCamera"},
    {"label": "the Inspector holds the camera", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "MainCamera\n", "timeout_ms": 30000},
    {"label": "the viewport holds a shape, not the gradient's thousands of colours", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/lit.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "distinct_colors", "op": "le", "value": 64, "retry_ms": 120000},
    {"label": "and more than one shade", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/lit.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "distinct_colors", "op": "gt", "value": 1},
    {"label": "the corner, read", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/lit.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[1]", "remember": "corner"},
    {"label": "the lit box: the middle is not the corner", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/lit.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[0]", "op": "ne", "value_of": "corner"},
    {"label": "a picture of the window", "expect": "screenshot", "path": "gui_build_B_window.png"}
  ]
}
