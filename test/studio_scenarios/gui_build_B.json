{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "gui_build_B",
  "description": "GB-1 target B (deferred + lighting), built from File > New Project > Blank with Studio's GUI only, on the Graph tab (UX-5b). The palette adds a render.material_pass of deferred_geometry_v1 (its five G-buffer images and depth), Add Object > Cube gives it something to draw, Add fullscreen pass adds the lighting pass, and its Pass fields' New... > Deferred lighting > Create writes the Pass Editor's template into shaders/deferred_lighting.frag and puts it on the pass in one edit -- Uses scene lights, Camera position, and a line from the material pass's albedo, normal, material, worldpos and emissive outputs to its five inputs (UX-5a's match). The lighting pass's colour output is then dragged onto present's + input, and the viewport shows the box the scene's light lights: a middle that is neither the gradient nor the corner. Typed: the project folder and the name gb_b in New Project, and material_pass in the palette's filter.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up, so the switch to the new project is something that happens", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "start from the default layout", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "visible": true, "timeout_ms": 10000},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "gb_b"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "missing": true, "timeout_ms": 10000},
    {"label": "the blank project's present is on the Frame Plan canvas", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "visible": true, "timeout_ms": 180000},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the Graph tab is in front", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the canvas has read the new document and can edit it", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "Add: the palette opens", "cmd": "click", "name": "pelican.graphCanvasAddNode"},
    {"label": "the palette is on screen", "cmd": "wait", "name": "pelican.graphCanvasPalette", "visible": true, "timeout_ms": 10000},
    {"label": "the filter narrows the list to the material pass", "cmd": "type", "name": "pelican.graphCanvasPaletteFilter", "text": "material_pass"},
    {"label": "the contract combo is offered for it", "cmd": "wait", "name": "pelican.graphCanvasPaletteContract", "visible": true, "timeout_ms": 10000},
    {"label": "a deferred pass: the G-buffer", "cmd": "select", "name": "pelican.graphCanvasPaletteContract", "text": "deferred_geometry_v1"},
    {"label": "Enter in the filter is OK", "cmd": "key", "name": "pelican.graphCanvasPaletteFilter", "sequence": "Return"},
    {"label": "the palette closed", "cmd": "wait", "name": "pelican.graphCanvasPalette", "missing": true, "timeout_ms": 10000},
    {"label": "the pass's draw loop is drawn as a zone (after the restart the route default asks for)", "cmd": "wait", "name": "pelican.graphCanvasView::graph_zone#render_material_pass_draws", "visible": true, "timeout_ms": 180000},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the material pass is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_material_pass", "visible": true, "timeout_ms": 60000},
    {"label": "Add Object > Cube", "cmd": "action", "name": "pelican.outliner.addObject.cube"},
    {"label": "the engine has a Cube", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[2].name", "value": "Cube", "retry_ms": 60000},
    {"label": "the Inspector has read the Cube", "cmd": "wait", "name": "pelican.inspectorModelChoice", "text": "Cube (built-in)", "timeout_ms": 60000},
    {"label": "File > Save Scene", "cmd": "action", "name": "pelican.file.saveScene"},
    {"label": "the save is done", "cmd": "wait", "name": "pelican.inspectorNotice", "contains": "Scene saved", "timeout_ms": 60000},
    {"label": "pick the camera, so no gizmo is drawn over the box", "cmd": "select", "name": "pelican.outliner", "text": "MainCamera"},
    {"label": "the Inspector holds the camera", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "MainCamera\n", "timeout_ms": 30000},
    {"label": "the Graph tab is in front again", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "fit the graph", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "Add fullscreen pass: the lighting pass", "cmd": "action", "name": "pelican.graphCanvas.addFullscreenPass"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "auto layout", "cmd": "action", "name": "pelican.graphCanvas.autoLayout"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "the new pass is the document's tenth node", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].id", "value": "render_fullscreen", "retry_ms": 60000},
    {"label": "pick it", "cmd": "click", "name": "pelican.graphCanvasView::graph_node#render_fullscreen"},
    {"label": "its Pass fields offer New... beside the fragment", "cmd": "wait", "name": "pelican.graphCanvasPass.newFragmentShader", "visible": true, "timeout_ms": 30000},
    {"label": "it draws with the engine's passthrough until then", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].parameters.shader.fragment", "value": "engine://passthrough"},
    {"label": "and its fields say so", "cmd": "wait", "name": "pelican.graphCanvasPass.shader.fragment", "text": "engine://passthrough", "timeout_ms": 30000},
    {"label": "New...", "cmd": "click", "name": "pelican.graphCanvasPass.newFragmentShader"},
    {"label": "the Pass Editor's templates, once the graph takes edits again", "cmd": "wait", "name": "pelican.graphCanvasPass.shaderTemplateKind", "visible": true, "enabled": true, "timeout_ms": 180000},
    {"label": "start from Deferred lighting", "cmd": "select", "name": "pelican.graphCanvasPass.shaderTemplateKind", "text": "Deferred lighting"},
    {"label": "named after it, nothing typed", "expect": "text_equals", "name": "pelican.graphCanvasPass.shaderTemplateName", "value": "deferred_lighting"},
    {"label": "Create", "cmd": "click", "name": "pelican.graphCanvasPass.createFragmentShader"},
    {"label": "the shader is written and the pass takes it", "cmd": "wait", "name": "pelican.graphCanvasPass.shaderTemplateNotice", "contains": "the pass draws with project://shaders/deferred_lighting", "timeout_ms": 30000},
    {"label": "saved, as one edit", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 120000},
    {"label": "the pass draws with the new shader", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].parameters.shader.fragment", "value": "project://shaders/deferred_lighting", "retry_ms": 60000},
    {"label": "with the scene lights", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].parameters.uses_light_data", "value": true},
    {"label": "and the camera position", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].parameters.push_constants", "value": "camera_position"},
    {"label": "a line from the material pass's albedo output", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].inputs.albedo.port", "value": "albedo"},
    {"label": "a line from the material pass's normal output", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].inputs.normal.port", "value": "normal"},
    {"label": "a line from the material pass's material output", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].inputs.material.port", "value": "material"},
    {"label": "a line from the material pass's worldpos output", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].inputs.worldpos.port", "value": "worldpos"},
    {"label": "a line from the material pass's emissive output", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].inputs.emissive.port", "value": "emissive"},
    {"label": "from the material pass (GL-1f), not its image", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].inputs.albedo.node", "value": "render_material_pass"},
    {"label": "the Pass fields say Camera position", "cmd": "wait", "name": "pelican.graphCanvasPass.pushConstants", "text": "Camera position", "timeout_ms": 60000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "present offers an empty + input", "cmd": "wait", "name": "pelican.graphCanvasView::graph_derived_socket#present/in:+", "visible": true, "timeout_ms": 120000},
    {"label": "before: the gradient's middle", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/before.png", "pixels": [[0.5, 0.5]]}, "path": "pixels[0]", "remember": "gradient_middle"},
    {"label": "the lit colour onto present's + input", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#render_fullscreen/out:color"}, "to": {"name": "pelican.graphCanvasView::graph_derived_socket#present/in:+"}, "steps": 8},
    {"label": "present's inputs saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Pass inputs saved.", "timeout_ms": 120000},
    {"label": "the line is the document's", "cmd": "wait", "name": "pelican.graphCanvasView::graph_pass_input_edge#render_fullscreen->present", "visible": true, "timeout_ms": 60000},
    {"label": "the middle is what the lighting drew, not the gradient", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/lit.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[0]", "op": "ne", "value_of": "gradient_middle", "retry_ms": 120000},
    {"label": "the corner, read", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/lit.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[1]", "remember": "corner"},
    {"label": "the lit box: the middle is not the corner", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/lit.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[0]", "op": "ne", "value_of": "corner"},
    {"label": "a picture of the window", "expect": "screenshot", "path": "gui_build_B_window.png"}
  ]
}
