{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "play_view_camera",
  "description": "PM-3b: paused, View: Editor draws the stopped game from the editor camera, which the game's moving camera has left behind, so the picture differs from the game's; View: Game goes back, and Stop returns to the editor camera. While the game plays there is no View choice.",
  "steps": [
    {
      "label": "the engine viewport answers editor RPC",
      "cmd": "wait_engine",
      "timeout_ms": 180000
    },
    {
      "label": "the engine has presented frames",
      "cmd": "wait_engine",
      "timeout_ms": 180000,
      "frames": 30
    },
    {
      "label": "Studio started the engine in edit",
      "cmd": "wait",
      "name": "pelican.playStatus",
      "timeout_ms": 60000,
      "text": "Edit"
    },
    {
      "label": "in edit the frame is drawn from the editor camera",
      "expect": "result",
      "command": {
        "cmd": "rpc",
        "method": "get_status"
      },
      "path": "result.play.view_camera",
      "value": "editor"
    },
    {
      "label": "in edit, View: Game | Editor is offered",
      "expect": "result",
      "command": {
        "cmd": "list",
        "pattern": "pelican.play.viewGame"
      },
      "path": "widgets[0].visible",
      "value": true,
      "retry_ms": 10000
    },
    {
      "label": "in edit, the box is in the middle",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/edit.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.06,
            0.06
          ]
        ]
      },
      "path": "pixels[0]",
      "remember": "box_edit",
      "retry_ms": 60000
    },
    {
      "label": "and the background in a corner",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/edit.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.06,
            0.06
          ]
        ]
      },
      "path": "pixels[1]",
      "remember": "background"
    },
    {
      "label": "the box is on screen",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/edit.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.06,
            0.06
          ]
        ]
      },
      "path": "pixels[0]",
      "op": "ne",
      "value_of": "background"
    },
    {
      "label": "press Play for the view",
      "cmd": "click",
      "name": "pelican.play.play"
    },
    {
      "label": "the status bar says the game plays",
      "cmd": "wait",
      "name": "pelican.playStatus",
      "timeout_ms": 60000,
      "contains": "Playing · frame"
    },
    {
      "label": "no View choice while the game plays",
      "expect": "result",
      "command": {
        "cmd": "list",
        "pattern": "pelican.play.viewEditor"
      },
      "path": "widgets[0].visible",
      "value": false,
      "retry_ms": 5000
    },
    {
      "label": "the game has run a while: its camera moved away",
      "expect": "result",
      "command": {
        "cmd": "rpc",
        "method": "get_status"
      },
      "path": "result.play.game_frame",
      "op": "ge",
      "value": 90,
      "retry_ms": 20000
    },
    {
      "label": "press Pause",
      "cmd": "click",
      "name": "pelican.play.pause"
    },
    {
      "label": "the status bar says paused",
      "cmd": "wait",
      "name": "pelican.playStatus",
      "timeout_ms": 10000,
      "contains": "Paused · frame"
    },
    {
      "label": "paused, View: Editor is offered",
      "expect": "result",
      "command": {
        "cmd": "list",
        "pattern": "pelican.play.viewEditor"
      },
      "path": "widgets[0].visible",
      "value": true,
      "retry_ms": 5000
    },
    {
      "label": "the paused game is seen through its own camera",
      "expect": "result",
      "command": {
        "cmd": "rpc",
        "method": "get_status"
      },
      "path": "result.play.view_camera",
      "value": "game"
    },
    {
      "label": "through the game's camera",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/view_game.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.06,
            0.06
          ]
        ]
      },
      "path": "pixels[0]",
      "remember": "game_center",
      "retry_ms": 10000
    },
    {
      "label": "View: Editor",
      "cmd": "click",
      "name": "pelican.play.viewEditor"
    },
    {
      "label": "the engine draws from the editor camera",
      "expect": "result",
      "command": {
        "cmd": "rpc",
        "method": "get_status"
      },
      "path": "result.play.view_camera",
      "value": "editor",
      "retry_ms": 10000
    },
    {
      "label": "the picture is not the game's",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/view_editor.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.06,
            0.06
          ]
        ]
      },
      "path": "pixels[0]",
      "op": "ne",
      "value_of": "game_center",
      "retry_ms": 30000
    },
    {
      "label": "View: Game",
      "cmd": "click",
      "name": "pelican.play.viewGame"
    },
    {
      "label": "the game's camera again",
      "expect": "result",
      "command": {
        "cmd": "rpc",
        "method": "get_status"
      },
      "path": "result.play.view_camera",
      "value": "game",
      "retry_ms": 10000
    },
    {
      "label": "press Stop",
      "cmd": "click",
      "name": "pelican.play.play"
    },
    {
      "label": "the status bar says Edit again",
      "cmd": "wait",
      "name": "pelican.playStatus",
      "timeout_ms": 60000,
      "text": "Edit"
    },
    {
      "label": "the engine has no play session",
      "expect": "result",
      "command": {
        "cmd": "rpc",
        "method": "get_status"
      },
      "path": "result.play.session",
      "value": false,
      "retry_ms": 10000
    },
    {
      "label": "Stop brings the editor camera back",
      "expect": "result",
      "command": {
        "cmd": "rpc",
        "method": "get_status"
      },
      "path": "result.play.view_camera",
      "value": "editor",
      "retry_ms": 10000
    }
  ]
}
