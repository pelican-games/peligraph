{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "gui_shortcuts_scene_undo",
  "description": "KB-1: window-route keys duplicate, undo, redo and delete the selected scene object from viewport focus; New, Help and Save use the same production actions. All assertions inspect RPC or widgets, without pixels.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {
      "label": "the fixture's engine is up, so the switch to the new project is something that happens",
      "cmd": "wait_engine",
      "timeout_ms": 180000
    },
    {
      "label": "start from the default layout: the panel layout is the desktop's, saved by whichever Studio closed last",
      "cmd": "action",
      "name": "pelican.layout.resetDefault"
    },
    {
      "label": "Focus the native viewport before the window shortcut",
      "cmd": "type",
      "name": "pelican.viewportHost",
      "text": "",
      "select_all": false
    },
    {
      "label": "File > New Project...",
      "cmd": "key",
      "name": "pelican.viewportHost",
      "sequence": "Ctrl+N",
      "route": "window"
    },
    {
      "label": "the dialog is on screen",
      "cmd": "wait",
      "name": "pelican.newProjectDialog",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "the folder: this run's own artifacts, never the repository",
      "cmd": "type",
      "name": "pelican.newProject.location",
      "text": "{artifacts}"
    },
    {
      "label": "the name",
      "cmd": "type",
      "name": "pelican.newProject.name",
      "text": "shortcuts_project"
    },
    {
      "label": "the Blank pipeline template",
      "cmd": "select",
      "name": "pelican.newProject.template",
      "text": "Blank pipeline"
    },
    {
      "label": "Create",
      "cmd": "click",
      "name": "pelican.newProject.create"
    },
    {
      "label": "the dialog closed, because the template is on disk",
      "cmd": "wait",
      "name": "pelican.newProjectDialog",
      "missing": true,
      "timeout_ms": 10000
    },
    {
      "label": "the new project's frame plan has its one pass: the switch to its engine is done",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node#present",
      "visible": true,
      "timeout_ms": 180000
    },
    {
      "label": "the new engine answers editor RPC and has presented frames",
      "cmd": "wait_engine",
      "timeout_ms": 180000,
      "frames": 30
    },
    {
      "label": "the Outliner is on screen",
      "cmd": "wait",
      "name": "pelican.outliner",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "the blank scene holds the template's two objects",
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects.$len",
      "value": 2,
      "retry_ms": 60000
    },
    {
      "label": "Add Object > Cube",
      "cmd": "action",
      "name": "pelican.outliner.addObject.cube"
    },
    {
      "label": "the engine has Cube third",
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects[2].name",
      "value": "Cube",
      "retry_ms": 60000
    },
    {
      "label": "and Cube is selected, by the id its committed spawn named",
      "cmd": "wait",
      "name": "pelican.inspectorSelection",
      "contains": "Cube\n",
      "timeout_ms": 30000
    },
    {
      "cmd": "wait",
      "name": "pelican.inspectorUndo",
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "Focus pelican.viewportHost without changing the selection",
      "cmd": "type",
      "name": "pelican.viewportHost",
      "text": "",
      "select_all": false
    },
    {
      "cmd": "key",
      "name": "pelican.viewportHost",
      "sequence": "Ctrl+D",
      "route": "window"
    },
    {
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects.$len",
      "value": 4,
      "retry_ms": 60000
    },
    {
      "cmd": "wait",
      "name": "pelican.inspectorUndo",
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "Focus pelican.viewportHost without changing the selection",
      "cmd": "type",
      "name": "pelican.viewportHost",
      "text": "",
      "select_all": false
    },
    {
      "cmd": "key",
      "name": "pelican.viewportHost",
      "sequence": "Ctrl+Z",
      "route": "window"
    },
    {
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects.$len",
      "value": 3,
      "retry_ms": 60000
    },
    {
      "cmd": "wait",
      "name": "pelican.inspectorUndo",
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "Focus pelican.viewportHost without changing the selection",
      "cmd": "type",
      "name": "pelican.viewportHost",
      "text": "",
      "select_all": false
    },
    {
      "cmd": "key",
      "name": "pelican.viewportHost",
      "sequence": "Ctrl+Shift+Z",
      "route": "window"
    },
    {
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects.$len",
      "value": 4,
      "retry_ms": 60000
    },
    {
      "cmd": "wait",
      "name": "pelican.outliner::row#Cube_copy1",
      "visible": true,
      "timeout_ms": 60000
    },
    {
      "cmd": "select",
      "name": "pelican.outliner",
      "text": "Cube_copy1"
    },
    {
      "cmd": "wait",
      "name": "pelican.inspectorUndo",
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "Focus pelican.viewportHost without changing the selection",
      "cmd": "type",
      "name": "pelican.viewportHost",
      "text": "",
      "select_all": false
    },
    {
      "cmd": "key",
      "name": "pelican.viewportHost",
      "sequence": "Delete",
      "route": "window"
    },
    {
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects.$len",
      "value": 3,
      "retry_ms": 60000
    },
    {
      "cmd": "wait",
      "name": "pelican.inspectorUndo",
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "Focus pelican.viewportHost without changing the selection",
      "cmd": "type",
      "name": "pelican.viewportHost",
      "text": "",
      "select_all": false
    },
    {
      "cmd": "key",
      "name": "pelican.viewportHost",
      "sequence": "Ctrl+Z",
      "route": "window"
    },
    {
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects.$len",
      "value": 4,
      "retry_ms": 60000
    },
    {
      "cmd": "wait",
      "name": "pelican.inspectorUndo",
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "cmd": "action",
      "name": "pelican.help.shortcuts"
    },
    {
      "cmd": "wait",
      "name": "pelican.help.shortcutsTable",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "cmd": "key",
      "name": "pelican.help.shortcutsDialog",
      "sequence": "Escape"
    },
    {
      "label": "Focus pelican.outliner without changing the selection",
      "cmd": "type",
      "name": "pelican.outliner",
      "text": "",
      "select_all": false
    },
    {
      "cmd": "key",
      "name": "pelican.outliner",
      "sequence": "Ctrl+S",
      "route": "window"
    },
    {
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "Scene saved",
      "timeout_ms": 60000
    }
  ]
}
