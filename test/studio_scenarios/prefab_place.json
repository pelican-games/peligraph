{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "prefab_place",
  "description": "Places a registered prefab, checks history and selection, and verifies persistence through an engine restart.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "wait for the initial engine", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "reset the default layout", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "wait for the outliner", "cmd": "wait", "name": "pelican.outliner", "visible": true, "timeout_ms": 10000},
    {"label": "read the registered prefabs", "expect": "rpc_equals", "method": "list_prefabs", "params": {}, "path": "prefabs[1].name", "value": "lamp"},
    {"label": "wait for both prefab menu entries", "expect": "result", "command": {"cmd": "menu_list", "pattern": "pelican.outliner.addObject.prefab."}, "path": "count", "value": 2, "retry_ms": 60000},
    {"label": "crate placement starts disabled", "expect": "result", "command": {"cmd": "menu_list", "pattern": "pelican.outliner.addObject.prefab.crate"}, "path": "actions[0].enabled", "value": false},
    {"label": "crate menu text names its requirement", "expect": "result", "command": {"cmd": "menu_list", "pattern": "pelican.outliner.addObject.prefab.crate"}, "path": "actions[0].text", "value": "crate (needs model)"},
    {"label": "disabled crate action is refused", "cmd": "action", "name": "pelican.outliner.addObject.prefab.crate", "expect_error": "automation.bad_request@1"},
    {"label": "existing crate row is present", "cmd": "wait", "name": "pelican.outliner::row#crate_1", "visible": true, "timeout_ms": 60000},
    {"label": "camera row remains undecorated", "cmd": "wait", "name": "pelican.outliner::row#MainCamera", "visible": true, "timeout_ms": 10000},
    {"label": "outline identifies the existing crate", "expect": "rpc_equals", "method": "scene_outline", "params": {"scene_id": "default_scene"}, "path": "objects[3].prefab_ref", "value": "crate"},
    {"label": "place lamp", "cmd": "action", "name": "pelican.outliner.addObject.prefab.lamp"},
    {"label": "lamp is appended to the scene", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[4].name", "value": "lamp_1", "retry_ms": 60000},
    {"label": "lamp resolves as a prefab instance", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[4].prefab_instance.ref", "value": "lamp"},
    {"label": "remember lamp authoring identity", "expect": "result", "command": {"cmd": "rpc", "method": "scene_tree", "params": {"scene_id": "default_scene"}}, "path": "result.objects[4].authoring_object_id", "remember": "lamp_id"},
    {"label": "lamp row appears", "cmd": "wait", "name": "pelican.outliner::row#lamp_1", "visible": true, "timeout_ms": 30000},
    {"label": "lamp is selected", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "lamp_1\n", "timeout_ms": 30000},
    {"label": "select camera before history", "cmd": "select", "name": "pelican.outliner", "text": "MainCamera"},
    {"label": "camera is selected", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "MainCamera\n", "timeout_ms": 30000},
    {"label": "wait for undo", "cmd": "wait", "name": "pelican.inspectorUndo", "enabled": true, "timeout_ms": 60000},
    {"label": "undo lamp placement", "cmd": "history", "kind": "scene", "step": "undo"},
    {"label": "lamp row disappears", "cmd": "wait", "name": "pelican.outliner::row#lamp_1", "missing": true, "timeout_ms": 60000},
    {"label": "undo restores four objects", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects.$len", "value": 4, "retry_ms": 60000},
    {"label": "undo does not move camera selection", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "MainCamera\n", "timeout_ms": 30000},
    {"label": "redo lamp placement", "cmd": "history", "kind": "scene", "step": "redo"},
    {"label": "redo restores the lamp row", "cmd": "wait", "name": "pelican.outliner::row#lamp_1", "visible": true, "timeout_ms": 60000},
    {"label": "redo preserves authoring identity", "expect": "result", "command": {"cmd": "rpc", "method": "scene_tree", "params": {"scene_id": "default_scene"}}, "path": "result.objects[4].authoring_object_id", "value_of": "lamp_id", "retry_ms": 60000},
    {"label": "select restored lamp", "cmd": "select", "name": "pelican.outliner", "text": "lamp_1"},
    {"label": "restored lamp is selected", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "lamp_1\n", "timeout_ms": 30000},
    {"label": "save scene", "cmd": "action", "name": "pelican.file.saveScene"},
    {"label": "wait for saved confirmation", "cmd": "wait", "name": "pelican.inspectorNotice", "contains": "Scene saved", "timeout_ms": 60000},
    {"label": "saved scene has the stable instance id", "file": "contains", "path": "{project}/scene.json", "text": "gi_lamp_1", "value": true},
    {"label": "saved scene does not inline defaults", "file": "contains", "path": "{project}/scene.json", "text": "brightness", "value": false},
    {"label": "stop engine", "cmd": "click", "name": "pelican.viewportStop"},
    {"label": "wait for restart", "cmd": "wait", "name": "pelican.viewportRestart", "enabled": true, "timeout_ms": 60000},
    {"label": "restart engine", "cmd": "click", "name": "pelican.viewportRestart"},
    {"label": "wait for restarted engine frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "reopened lamp retains its prefab", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[4].prefab_instance.ref", "value": "lamp", "retry_ms": 60000},
    {"label": "reopened lamp retains its instance id", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[4].prefab_instance.instance_id", "value": "gi_lamp_1"},
    {"label": "reopened brightness is still a default", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[4].prefab_instance.parameters[0].source", "value": "default"},
    {"label": "reopened lamp retains authoring identity", "expect": "result", "command": {"cmd": "rpc", "method": "scene_tree", "params": {"scene_id": "default_scene"}}, "path": "result.objects[4].authoring_object_id", "value_of": "lamp_id"},
    {"label": "reopened lamp row is visible", "cmd": "wait", "name": "pelican.outliner::row#lamp_1", "visible": true, "timeout_ms": 60000},
    {"label": "reopened crate row is visible", "cmd": "wait", "name": "pelican.outliner::row#crate_1", "visible": true, "timeout_ms": 60000},
    {"label": "capture the final window", "expect": "screenshot", "path": "prefab_place_window.png"}
  ]
}
