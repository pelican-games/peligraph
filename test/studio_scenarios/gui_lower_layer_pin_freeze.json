{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "gui_lower_layer_pin_freeze",
  "description": "RC-6b1: GUI Pin / Unpin writes author-graph root backend policy; one Undo restores it. Freeze writes one root policy batch, Remove erases all five fixing keys including Pin, and one Undo restores the document. No legacy package RPCs. Run on the integration virtual monitor.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {
      "label": "the fixture's engine is up, so the switch to the new project is something that happens",
      "cmd": "wait_engine",
      "timeout_ms": 180000
    },
    {
      "label": "start from the default layout",
      "cmd": "action",
      "name": "pelican.layout.resetDefault"
    },
    {
      "label": "File > New Project...",
      "cmd": "action",
      "name": "pelican.file.newProject"
    },
    {
      "label": "the dialog is on screen",
      "cmd": "wait",
      "name": "pelican.newProjectDialog",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "the folder: this run's own artifacts",
      "cmd": "type",
      "name": "pelican.newProject.location",
      "text": "{artifacts}"
    },
    {
      "label": "the name",
      "cmd": "type",
      "name": "pelican.newProject.name",
      "text": "lower_a"
    },
    {
      "label": "the Blank pipeline template",
      "cmd": "select",
      "name": "pelican.newProject.template",
      "text": "Blank pipeline"
    },
    {
      "label": "Create",
      "cmd": "click",
      "name": "pelican.newProject.create"
    },
    {
      "label": "the dialog closed",
      "cmd": "wait",
      "name": "pelican.newProjectDialog",
      "missing": true,
      "timeout_ms": 10000
    },
    {
      "label": "the blank project's present is on the Frame Plan canvas",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node#present",
      "visible": true,
      "timeout_ms": 180000
    },
    {
      "label": "the new engine answers and has presented frames",
      "cmd": "wait_engine",
      "timeout_ms": 180000,
      "frames": 30
    },
    {
      "label": "read the plan again",
      "cmd": "click",
      "name": "pelican.framePlanRefresh"
    },
    {
      "cmd": "click",
      "name": "pelican.framePlanRefresh"
    },
    {
      "cmd": "action",
      "name": "pelican.framePlan.tab.backends"
    },
    {
      "cmd": "wait",
      "name": "pelican.framePlan.backend.state",
      "contains": "Not pinned",
      "timeout_ms": 120000
    },
    {
      "cmd": "select",
      "name": "pelican.framePlanBackends",
      "text": "pelican.vulkan.materialized_plan@1"
    },
    {
      "cmd": "action",
      "name": "pelican.framePlan.backend.pin"
    },
    {
      "cmd": "wait",
      "name": "pelican.framePlanStatus",
      "contains": "Pinned pelican.vulkan.materialized_plan@1.",
      "timeout_ms": 120000
    },
    {
      "expect": "rpc_equals",
      "method": "get_frame_plan",
      "params": {},
      "path": "physical_target_plan.backend_selection.selected_candidate",
      "value": "pelican.vulkan.materialized_plan@1",
      "retry_ms": 120000
    },
    {
      "cmd": "wait",
      "name": "pelican.framePlan.backend.state",
      "text": "Pinned: materialized",
      "timeout_ms": 120000
    },
    {
      "expect": "screenshot",
      "path": "gui_lower_layer_pinned.png"
    },
    {
      "cmd": "click",
      "name": "pelican.framePlan.backend.unpinButton"
    },
    {
      "cmd": "wait",
      "name": "pelican.framePlanStatus",
      "contains": "Unpinned backend",
      "timeout_ms": 120000
    },
    {
      "cmd": "wait",
      "name": "pelican.framePlan.backend.state",
      "contains": "Not pinned",
      "timeout_ms": 120000
    },
    {
      "cmd": "wait",
      "name": "pelican.framePlan.undoButton",
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "cmd": "click",
      "name": "pelican.framePlan.undoButton"
    },
    {
      "cmd": "wait",
      "name": "pelican.framePlan.backend.state",
      "text": "Pinned: materialized",
      "timeout_ms": 120000
    },
    {
      "cmd": "action",
      "name": "pelican.framePlan.tab.physical-plan"
    },
    {
      "cmd": "wait",
      "name": "pelican.framePlan.physical.state",
      "contains": "Root fixing policy present",
      "timeout_ms": 60000
    },
    {
      "cmd": "click",
      "name": "pelican.framePlan.physical.freezeButton"
    },
    {
      "cmd": "wait",
      "name": "pelican.framePlanStatus",
      "contains": "Physical plan frozen as root policy.",
      "timeout_ms": 120000
    },
    {
      "expect": "result",
      "command": {
        "cmd": "rpc",
        "method": "get_render_documents",
        "params": {}
      },
      "path": "result.documents[0].content",
      "op": "contains",
      "value": "target_planning",
      "retry_ms": 30000
    },
    {
      "expect": "result",
      "command": {
        "cmd": "rpc",
        "method": "get_render_documents",
        "params": {}
      },
      "path": "result.documents[0].content",
      "op": "excludes",
      "value": "vulkan_physical_fragments"
    },
    {
      "expect": "screenshot",
      "path": "gui_lower_layer_frozen.png"
    },
    {
      "cmd": "click",
      "name": "pelican.framePlan.physical.removeButton"
    },
    {
      "cmd": "wait",
      "name": "pelican.framePlanStatus",
      "contains": "Removed all five root fixing policy keys",
      "timeout_ms": 120000
    },
    {
      "expect": "result",
      "command": {
        "cmd": "rpc",
        "method": "get_render_documents",
        "params": {}
      },
      "path": "result.documents[0].content",
      "op": "excludes",
      "value": "target_planning",
      "retry_ms": 30000
    },
    {
      "cmd": "wait",
      "name": "pelican.framePlan.physical.state",
      "contains": "No root fixing policy",
      "timeout_ms": 120000
    },
    {
      "cmd": "click",
      "name": "pelican.framePlan.undoButton"
    },
    {
      "cmd": "wait",
      "name": "pelican.framePlan.physical.state",
      "contains": "Root fixing policy present",
      "timeout_ms": 120000
    },
    {
      "expect": "screenshot",
      "path": "gui_lower_layer_undone.png"
    }
  ]
}
