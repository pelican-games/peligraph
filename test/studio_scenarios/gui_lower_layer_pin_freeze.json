{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "gui_lower_layer_pin_freeze",
  "description": "UX-15b, from File > New Project > Blank with Studio's GUI only. The Frame Plan's Backends tab: the materialized candidate's row is picked and Pin this candidate sends edit_vulkan_plan_pins (the plan's ejected pin with that candidate); the engine applies it, so get_frame_plan's applied_pin_package names it and the tab's band says Pinned. The Physical plan tab: Freeze this physical plan sends the ejected fragment with put_vulkan_physical_fragment; the band says Frozen, and Remove takes it out of the root again. Back on Backends, Unpin takes the pin off. Last, the Frame Plan's Undo takes the Unpin back: the root holds the pin and the engine applies it again. Typed: the project folder and name in New Project.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up, so the switch to the new project is something that happens", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "start from the default layout", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "visible": true, "timeout_ms": 10000},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "lower_a"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "missing": true, "timeout_ms": 10000},
    {"label": "the blank project's present is on the Frame Plan canvas", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "visible": true, "timeout_ms": 180000},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the plan ejects a pin package", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "physical_target_plan.ejectable_pin_package.schema", "value": "pelican.vulkan_target_plan_pins", "retry_ms": 60000},
    {"label": "and nothing is pinned yet", "expect": "result", "command": {"cmd": "rpc", "method": "get_render_documents", "params": {}}, "path": "result.documents[0].content", "op": "excludes", "value": "vulkan_plan_pins"},

    {"label": "read the plan again", "cmd": "click", "name": "pelican.framePlanRefresh"},
    {"label": "the Backends tab", "cmd": "action", "name": "pelican.framePlan.tab.backends"},
    {"label": "its band says the planner picks", "cmd": "wait", "name": "pelican.framePlan.backend.state", "contains": "Not pinned", "timeout_ms": 120000},
    {"label": "pick the materialized candidate's row", "cmd": "select", "name": "pelican.framePlanBackends", "text": "pelican.vulkan.materialized_plan@1"},
    {"label": "Pin this candidate (its right-click entry, by name)", "cmd": "action", "name": "pelican.framePlan.backend.pin"},
    {"label": "committed", "cmd": "wait", "name": "pelican.framePlanStatus", "contains": "Pinned pelican.vulkan.materialized_plan@1.", "timeout_ms": 120000},
    {"label": "the root holds the pin", "expect": "result", "command": {"cmd": "rpc", "method": "get_render_documents", "params": {}}, "path": "result.documents[0].content", "op": "contains", "value": "vulkan_plan_pins", "retry_ms": 30000},
    {"label": "the engine took it: the plan applies the pin", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "physical_target_plan.applied_pin_package.pins.backend_candidate", "value": "pelican.vulkan.materialized_plan@1", "retry_ms": 120000},
    {"label": "the band says Pinned", "cmd": "wait", "name": "pelican.framePlan.backend.state", "text": "Pinned: pelican.vulkan.materialized_plan@1", "timeout_ms": 120000},
    {"label": "a picture of the Backends tab, pinned", "expect": "screenshot", "path": "gui_lower_layer_pinned.png"},

    {"label": "the Physical plan tab", "cmd": "action", "name": "pelican.framePlan.tab.physical-plan"},
    {"label": "its band says the planner decides", "cmd": "wait", "name": "pelican.framePlan.physical.state", "contains": "Not frozen", "timeout_ms": 60000},
    {"label": "Freeze this physical plan", "cmd": "click", "name": "pelican.framePlan.physical.freezeButton"},
    {"label": "committed", "cmd": "wait", "name": "pelican.framePlanStatus", "contains": "Physical plan frozen.", "timeout_ms": 120000},
    {"label": "the root holds the fragment", "expect": "result", "command": {"cmd": "rpc", "method": "get_render_documents", "params": {}}, "path": "result.documents[0].content", "op": "contains", "value": "vulkan_physical_fragments", "retry_ms": 30000},
    {"label": "the engine applies it", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "physical_target_plan.applied_physical_fragment.schema", "value": "pelican.vulkan_physical_fragment", "retry_ms": 120000},
    {"label": "the band says Frozen", "cmd": "wait", "name": "pelican.framePlan.physical.state", "contains": "Frozen:", "timeout_ms": 120000},
    {"label": "a picture of the Physical plan tab, frozen", "expect": "screenshot", "path": "gui_lower_layer_frozen.png"},
    {"label": "Remove", "cmd": "click", "name": "pelican.framePlan.physical.removeButton"},
    {"label": "committed", "cmd": "wait", "name": "pelican.framePlanStatus", "contains": "The frozen physical plan was removed.", "timeout_ms": 120000},
    {"label": "the root holds no fragment", "expect": "result", "command": {"cmd": "rpc", "method": "get_render_documents", "params": {}}, "path": "result.documents[0].content", "op": "excludes", "value": "vulkan_physical_fragments", "retry_ms": 30000},
    {"label": "the band says the planner decides again", "cmd": "wait", "name": "pelican.framePlan.physical.state", "contains": "Not frozen", "timeout_ms": 120000},

    {"label": "the Backends tab", "cmd": "action", "name": "pelican.framePlan.tab.backends"},
    {"label": "still pinned", "cmd": "wait", "name": "pelican.framePlan.backend.state", "text": "Pinned: pelican.vulkan.materialized_plan@1", "timeout_ms": 60000},
    {"label": "Unpin", "cmd": "click", "name": "pelican.framePlan.backend.unpinButton"},
    {"label": "committed", "cmd": "wait", "name": "pelican.framePlanStatus", "contains": "Unpinned pelican.vulkan.materialized_plan@1", "timeout_ms": 120000},
    {"label": "the root holds no pin", "expect": "result", "command": {"cmd": "rpc", "method": "get_render_documents", "params": {}}, "path": "result.documents[0].content", "op": "excludes", "value": "vulkan_plan_pins", "retry_ms": 30000},
    {"label": "the band says the planner picks again", "cmd": "wait", "name": "pelican.framePlan.backend.state", "contains": "Not pinned", "timeout_ms": 120000},

    {"label": "Undo is on", "cmd": "wait", "name": "pelican.framePlan.undoButton", "enabled": true, "timeout_ms": 60000},
    {"label": "Undo, on the Frame Plan's toolbar: the Unpin is taken back", "cmd": "click", "name": "pelican.framePlan.undoButton"},
    {"label": "the root holds the pin again", "expect": "result", "command": {"cmd": "rpc", "method": "get_render_documents", "params": {}}, "path": "result.documents[0].content", "op": "contains", "value": "vulkan_plan_pins", "retry_ms": 60000},
    {"label": "and the engine applies it again", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "physical_target_plan.applied_pin_package.pins.backend_candidate", "value": "pelican.vulkan.materialized_plan@1", "retry_ms": 120000},
    {"label": "read the plan again", "cmd": "click", "name": "pelican.framePlanRefresh"},
    {"label": "the band says Pinned", "cmd": "wait", "name": "pelican.framePlan.backend.state", "text": "Pinned: pelican.vulkan.materialized_plan@1", "timeout_ms": 120000},
    {"label": "a picture of the window", "expect": "screenshot", "path": "gui_lower_layer_undone.png"}
  ]
}
