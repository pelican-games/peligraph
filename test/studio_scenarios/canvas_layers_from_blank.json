{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "canvas_layers_from_blank",
  "description": "SG-1: a 2D canvas built in the Graph from File > New Project > Blank with Studio's GUI only. The palette's canvas domain offers the Canvas, which places a canvas.stack (1280 x 720, no layer) and a canvas.output reading it in one edit; with Render alone shown, the output stands as a render pass and its input is cut with the canvas stub. Its image is dragged onto present's + input (the edit_preset_pass GL-1e sends, naming the output). Picking the output opens the Layers panel: + Rect puts a filled rectangle at the middle of the canvas and the centre of the viewport changes; Color: Red repaints it; + Ellipse puts an ellipse on top and the centre changes again; Down moves the ellipse under the rectangle and the centre is the red one again; the eye of the top row (the rectangle) hides it and the centre is the ellipse's again. A corner of the viewport stays as the empty canvas left it throughout. Typed: the project folder and name only.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "timeout_ms": 10000, "visible": true},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "canvas_layers"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "timeout_ms": 10000, "missing": true},
    {"label": "the blank project's present is on the Frame Plan canvas", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "timeout_ms": 180000, "visible": true},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the Graph tab is in front", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the canvas can edit the new document", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "the domain filter has Canvas", "cmd": "wait", "name": "pelican.graphCanvasShow.canvas", "timeout_ms": 10000, "visible": true},

    {"label": "Add: the palette opens", "cmd": "click", "name": "pelican.graphCanvasAddNode"},
    {"label": "the palette is on screen", "cmd": "wait", "name": "pelican.graphCanvasPalette", "timeout_ms": 10000, "visible": true},
    {"label": "the canvas domain", "cmd": "select", "name": "pelican.graphCanvasPaletteDomain", "text": "canvas"},
    {"label": "the Canvas", "cmd": "select", "name": "pelican.graphCanvasPaletteList", "text": "Canvas   (canvas.output + canvas.stack)"},
    {"label": "Enter is OK", "cmd": "key", "name": "pelican.graphCanvasPaletteFilter", "sequence": "Return"},
    {"label": "the palette closed", "cmd": "wait", "name": "pelican.graphCanvasPalette", "timeout_ms": 10000, "missing": true},
    {"label": "with Render shown, the output stands as a render pass", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#canvas", "timeout_ms": 120000, "visible": true},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the stack first", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].op", "value": "canvas.stack", "retry_ms": 60000},
    {"label": "a 1280 x 720 canvas with no layer", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters", "value": {"size": [1280, 720], "layers": []}},
    {"label": "the output reads it", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].inputs.layer.node", "value": "canvas_stack"},
    {"label": "the line from the hidden stack is cut: ← canvas (1)", "cmd": "wait", "name": "pelican.graphCanvasView::graph_domain_stub#canvas/layer", "timeout_ms": 60000, "visible": true},

    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "present's + input", "cmd": "wait", "name": "pelican.graphCanvasView::graph_derived_socket#present/in:+", "timeout_ms": 120000, "visible": true},
    {"label": "let it settle", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "zz-never-shown", "timeout_ms": 800, "expect_error": "automation.wait_timeout@1"},
    {"label": "the canvas's image onto present's + input", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#canvas/out:image"}, "to": {"name": "pelican.graphCanvasView::graph_derived_socket#present/in:+"}, "steps": 8},
    {"label": "present's inputs saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Pass inputs saved."},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the empty canvas: remember the centre", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "remember": "empty"},
    {"label": "and a corner", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[1]", "remember": "corner"},

    {"label": "pick the output", "cmd": "click", "name": "pelican.graphCanvasView::graph_node_header#canvas"},
    {"label": "the Layers panel shows its stack", "cmd": "wait", "name": "pelican.canvasLayers.title", "timeout_ms": 30000, "visible": true, "contains": "canvas_stack"},
    {"label": "no layer yet", "cmd": "wait", "name": "pelican.canvasLayers.empty", "timeout_ms": 10000, "visible": true},

    {"label": "+ Rect", "cmd": "click", "name": "pelican.canvasLayers.addRect"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "its row, picked", "cmd": "wait", "name": "pelican.canvasLayers.row0.name", "timeout_ms": 60000, "visible": true, "text": "Rect 1"},
    {"label": "the layer on the stack", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers", "value": [{"input": "rect_1", "name": "Rect 1"}], "retry_ms": 60000},
    {"label": "reading the fill", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].inputs.rect_1.node", "value": "rect_1_fill"},
    {"label": "the rectangle covers the centre", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "op": "ne", "value_of": "empty", "retry_ms": 60000},
    {"label": "remember it", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "remember": "blue"},
    {"label": "the corner is still empty", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[1]", "value_of": "corner"},

    {"label": "the colour field", "cmd": "wait", "name": "pelican.canvasLayers.field.color", "timeout_ms": 30000, "visible": true, "enabled": true},
    {"label": "Color: Red", "cmd": "select", "name": "pelican.canvasLayers.field.color", "text": "Red"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the fill is red", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[3].parameters.color", "value": [0.9, 0.2, 0.2, 1.0], "retry_ms": 60000},
    {"label": "the centre changed", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "op": "ne", "value_of": "blue", "retry_ms": 60000},
    {"label": "remember it", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "remember": "red"},

    {"label": "the panel takes edits", "cmd": "wait", "name": "pelican.canvasLayers.addEllipse", "timeout_ms": 120000, "enabled": true},
    {"label": "+ Ellipse", "cmd": "click", "name": "pelican.canvasLayers.addEllipse"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "on top", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers[1].input", "value": "ellipse_1", "retry_ms": 60000},
    {"label": "the top row is the ellipse", "cmd": "wait", "name": "pelican.canvasLayers.row0.name", "timeout_ms": 60000, "visible": true, "text": "Ellipse 1"},
    {"label": "the ellipse covers the centre", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "op": "ne", "value_of": "red", "retry_ms": 60000},
    {"label": "remember it", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "remember": "orange"},

    {"label": "the panel takes edits", "cmd": "wait", "name": "pelican.canvasLayers.down", "timeout_ms": 120000, "enabled": true},
    {"label": "Down: the picked ellipse goes under the rectangle", "cmd": "click", "name": "pelican.canvasLayers.down"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the ellipse is the bottom layer", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers[0].input", "value": "ellipse_1", "retry_ms": 60000},
    {"label": "the top row is the rectangle", "cmd": "wait", "name": "pelican.canvasLayers.row0.name", "timeout_ms": 60000, "visible": true, "text": "Rect 1"},
    {"label": "the centre is the red rectangle again", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "value_of": "red", "retry_ms": 60000},

    {"label": "the panel takes edits", "cmd": "wait", "name": "pelican.canvasLayers.row0.visible", "timeout_ms": 120000, "enabled": true},
    {"label": "the eye of the top row (the rectangle)", "cmd": "click", "name": "pelican.canvasLayers.row0.visible"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the rectangle is hidden", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers[1].visible", "value": false, "retry_ms": 60000},
    {"label": "the centre is the ellipse", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "value_of": "orange", "retry_ms": 60000},
    {"label": "the corner is still empty", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[1]", "value_of": "corner"},

    {"label": "Show: Canvas", "cmd": "click", "name": "pelican.graphCanvasShow.canvas"},
    {"label": "the stack is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#canvas_stack", "timeout_ms": 60000, "visible": true},
    {"label": "its sockets are its layers", "cmd": "wait", "name": "pelican.graphCanvasView::graph_socket#canvas_stack/in:rect_1", "timeout_ms": 60000, "visible": true},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "a picture of the Graph tab with the Layers panel", "expect": "screenshot", "name": "pelican.graphCanvas", "path": "canvas_layers_graph.png"},
    {"label": "a picture of the window", "expect": "screenshot", "path": "canvas_layers_window.png"}
  ]
}
