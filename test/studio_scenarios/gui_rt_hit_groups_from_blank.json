{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "gui_rt_hit_groups_from_blank",
  "description": "RTL-2s (a): hit groups of a ray tracing task from File > New Project > Blank with Studio's GUI only. A Cube and a Sphere side by side, two materials (the Materials dock) bound to them (the Inspector's Material rows), and a ray tracing task placed from the Graph tab's palette in the form without a ray layout (CT-6s). The Rendering settings tab's Ray layout section offers Enable hit groups: one edit_batch writes the default ray layout beside the root and the task in the layout's form (Studio's starting set rewritten into shaders/ray_tracing_layout.*, the files before kept), and the engine starts again to run it. A hit group is added with its closest hit from the template, the second material is assigned to it, and the two objects come back in different colours: the cube in the default group's normal colour, the sphere in the new group's tint. Typed: the project folder and its name in New Project, render.compute in the palette's filter, and the two objects' x positions.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up, so the switch to the new project is something that happens", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "start from the default layout", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "visible": true, "timeout_ms": 10000},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "gb_hg"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "missing": true, "timeout_ms": 10000},
    {"label": "the blank project's present is on the Frame Plan canvas", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "visible": true, "timeout_ms": 180000},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},

    {"label": "Add Object > Cube", "cmd": "action", "name": "pelican.outliner.addObject.cube"},
    {"label": "the engine has a Cube", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[2].name", "value": "Cube", "retry_ms": 60000},
    {"label": "the Cube is selected", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "Cube\n", "timeout_ms": 30000},
    {"label": "its position is on screen and takes input", "cmd": "wait", "name": "pelican.inspectorVector.transform.pos.0", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "the Cube to the left", "cmd": "type", "name": "pelican.inspectorVector.transform.pos.0", "text": "-0.8"},
    {"label": "commit it", "cmd": "key", "name": "pelican.inspectorVector.transform.pos.0", "sequence": "Return"},
    {"label": "the field holds it", "cmd": "wait", "name": "pelican.inspectorVector.transform.pos.0", "contains": "-0.8000", "timeout_ms": 30000},
    {"label": "Add Object > Sphere", "cmd": "action", "name": "pelican.outliner.addObject.sphere"},
    {"label": "the engine has a Sphere", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[3].name", "value": "Sphere", "retry_ms": 60000},
    {"label": "the Sphere is selected", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "Sphere\n", "timeout_ms": 30000},
    {"label": "let the Inspector settle on the Sphere", "cmd": "wait", "name": "pelican.inspectorNotice", "contains": "zz-never-shown", "timeout_ms": 1500, "expect_error": "automation.wait_timeout@1"},
    {"label": "its position takes input", "cmd": "wait", "name": "pelican.inspectorVector.transform.pos.0", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "the Sphere to the right", "cmd": "type", "name": "pelican.inspectorVector.transform.pos.0", "text": "0.8"},
    {"label": "commit it", "cmd": "key", "name": "pelican.inspectorVector.transform.pos.0", "sequence": "Return"},
    {"label": "the field holds it", "cmd": "wait", "name": "pelican.inspectorVector.transform.pos.0", "contains": "0.8000", "timeout_ms": 30000},

    {"label": "View > Materials", "cmd": "action", "name": "pelican.view.materials"},
    {"label": "the dock is on screen", "cmd": "wait", "name": "pelican.materials.list", "visible": true, "timeout_ms": 10000},
    {"label": "New material...", "cmd": "click", "name": "pelican.materials.newMaterial"},
    {"label": "the row under it is open", "cmd": "wait", "name": "pelican.materials.new.surface", "visible": true, "timeout_ms": 10000},
    {"label": "OpenPBR's opaque one-sided surface", "cmd": "select", "name": "pelican.materials.new.surface", "text": "openpbr / opaque_single_sided"},
    {"label": "the name is proposed, nothing typed", "expect": "text_equals", "name": "pelican.materials.new.name", "value": "material"},
    {"label": "Create", "cmd": "click", "name": "pelican.materials.new.create"},
    {"label": "the engine lists the first material", "expect": "rpc_equals", "method": "list_materials", "params": {}, "path": "documents.$len", "value": 1, "retry_ms": 30000},
    {"label": "New material... again", "cmd": "click", "name": "pelican.materials.newMaterial"},
    {"label": "the row is open", "cmd": "wait", "name": "pelican.materials.new.surface", "visible": true, "timeout_ms": 10000},
    {"label": "the same surface", "cmd": "select", "name": "pelican.materials.new.surface", "text": "openpbr / opaque_single_sided"},
    {"label": "the next name is proposed", "expect": "text_equals", "name": "pelican.materials.new.name", "value": "material_2"},
    {"label": "Create", "cmd": "click", "name": "pelican.materials.new.create"},
    {"label": "the engine lists both", "expect": "rpc_equals", "method": "list_materials", "params": {}, "path": "documents.$len", "value": 2, "retry_ms": 30000},

    {"label": "pick the Cube", "cmd": "select", "name": "pelican.outliner", "text": "Cube"},
    {"label": "the Inspector names it", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "Cube\n", "timeout_ms": 30000},
    {"label": "its Material rows are read", "cmd": "wait", "name": "pelican.inspectorMaterialChoice", "enabled": true, "timeout_ms": 60000},
    {"label": "every Cube", "cmd": "select", "name": "pelican.inspectorMaterialTarget", "text": "Every Cube"},
    {"label": "material for the cube", "cmd": "select", "name": "pelican.inspectorMaterialChoice", "text": "material"},
    {"label": "the engine binds it", "expect": "rpc_equals", "method": "get_material_bindings", "params": {"model": "engine://primitives/cube"}, "path": "primitives[0].material", "value": "material", "retry_ms": 30000},
    {"label": "pick the Sphere", "cmd": "select", "name": "pelican.outliner", "text": "Sphere"},
    {"label": "the Inspector names it", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "Sphere\n", "timeout_ms": 30000},
    {"label": "its Material rows are read", "cmd": "wait", "name": "pelican.inspectorMaterialChoice", "enabled": true, "timeout_ms": 60000},
    {"label": "every Sphere", "cmd": "select", "name": "pelican.inspectorMaterialTarget", "text": "Every Sphere"},
    {"label": "material_2 for the sphere", "cmd": "select", "name": "pelican.inspectorMaterialChoice", "text": "material_2"},
    {"label": "the engine binds it", "expect": "rpc_equals", "method": "get_material_bindings", "params": {"model": "engine://primitives/sphere"}, "path": "primitives[0].material", "value": "material_2", "retry_ms": 30000},
    {"label": "File > Save Scene: the restart reads the scene from disk", "cmd": "action", "name": "pelican.file.saveScene"},
    {"label": "the save is done", "cmd": "wait", "name": "pelican.inspectorNotice", "contains": "Scene saved", "timeout_ms": 60000},
    {"label": "pick the camera, so no gizmo is drawn over the objects", "cmd": "select", "name": "pelican.outliner", "text": "MainCamera"},
    {"label": "the Inspector holds the camera", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "MainCamera\n", "timeout_ms": 30000},

    {"label": "the Graph tab is in front", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the canvas can edit", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "Add: the palette opens", "cmd": "click", "name": "pelican.graphCanvasAddNode"},
    {"label": "the palette is on screen", "cmd": "wait", "name": "pelican.graphCanvasPalette", "visible": true, "timeout_ms": 10000},
    {"label": "the filter narrows the list to the compute task", "cmd": "type", "name": "pelican.graphCanvasPaletteFilter", "text": "render.compute"},
    {"label": "New... beside its shader list", "cmd": "wait", "name": "pelican.graphCanvasPaletteComputeNew", "visible": true, "enabled": true, "timeout_ms": 10000},
    {"label": "New...: the ray tracing set", "cmd": "click", "name": "pelican.graphCanvasPaletteComputeNew"},
    {"label": "written and picked", "cmd": "wait", "name": "pelican.graphCanvasPaletteComputeShader", "text": "project://shaders/ray_tracing  (ray tracing)", "timeout_ms": 10000},
    {"label": "Enter in the filter is OK", "cmd": "key", "name": "pelican.graphCanvasPaletteFilter", "sequence": "Return"},
    {"label": "the palette closed", "cmd": "wait", "name": "pelican.graphCanvasPalette", "missing": true, "timeout_ms": 10000},
    {"label": "the task is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_compute", "visible": true, "timeout_ms": 180000},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 120000},
    {"label": "the task traces without a ray layout: closesthit, not hit_shaders", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.closesthit", "value": "project://shaders/ray_tracing", "retry_ms": 60000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "present offers an empty + input", "cmd": "wait", "name": "pelican.graphCanvasView::graph_derived_socket#present/in:+", "visible": true, "timeout_ms": 60000},
    {"label": "the trace onto present's + input", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#render_compute/out:color"}, "to": {"name": "pelican.graphCanvasView::graph_derived_socket#present/in:+"}, "steps": 8},
    {"label": "present's inputs saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Pass inputs saved.", "timeout_ms": 120000},
    {"label": "the trace is a task of the frame plan", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "nodes[1].name", "value": "render_compute", "retry_ms": 120000},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "before: the cube's colour without hit groups", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/before.png", "pixels": [[0.27, 0.5], [0.70, 0.5], [0.04, 0.04]]}, "path": "pixels[0]", "remember": "cube_before"},

    {"label": "the Rendering settings tab", "cmd": "action", "name": "pelican.view.renderTools.rendering_settings"},
    {"label": "the Ray layout section reads the project: no layout, Enable hit groups", "cmd": "wait", "name": "pelican.rayLayout.enable", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "its line says the task traces every object alike", "cmd": "wait", "name": "pelican.rayLayout.state", "contains": "1 ray tracing task", "timeout_ms": 10000},
    {"label": "the engine running before the restart", "expect": "result", "command": {"cmd": "rpc", "method": "get_status", "params": {}}, "path": "result.instance_id", "remember": "engine_before"},
    {"label": "Enable hit groups: one edit_batch, then the engine starts again", "cmd": "click", "name": "pelican.rayLayout.enable"},
    {"label": "committed for the next start: the section says the engine starts again for the ray layout", "cmd": "wait", "name": "pelican.rayLayout.notice", "contains": "ray_layout_mode_changed", "timeout_ms": 120000},
    {"label": "the new engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "it is another engine", "expect": "result", "command": {"cmd": "rpc", "method": "get_status", "params": {}}, "path": "result.instance_id", "op": "ne", "value_of": "engine_before"},
    {"label": "it runs the ray layout", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "mode", "value": "layout", "retry_ms": 60000},
    {"label": "the layout beside the root", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "layout.reference", "value": "project://passes/ray_layout.json"},
    {"label": "its one hit group, default", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "names.default_group", "value": "default"},
    {"label": "the task in the layout's form: primary traced", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.traced_ray_types[0]", "value": "primary"},
    {"label": "its default cell: the layout's starting set", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.hit_shaders.primary.default.closesthit", "value": "project://shaders/ray_tracing_layout"},
    {"label": "its miss", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.misses.miss", "value": "project://shaders/ray_tracing_layout"},
    {"label": "the raygen in the layout's form is written", "file": "contains", "path": "{artifacts}/gb_hg/shaders/ray_tracing_layout.rgen", "text": "PELICAN_RAY_TYPE_primary", "value": true},
    {"label": "the file before is kept for Undo", "file": "exists", "path": "{artifacts}/gb_hg/shaders/ray_tracing.rgen", "value": true},
    {"label": "the frame plan has the trace", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "nodes[1].name", "value": "render_compute", "retry_ms": 120000},

    {"label": "the Rendering settings tab again", "cmd": "action", "name": "pelican.view.renderTools.rendering_settings"},
    {"label": "the Hit groups table: default", "cmd": "wait", "name": "pelican.rayLayout.group.default.name", "visible": true, "text": "default", "timeout_ms": 60000},
    {"label": "Hit groups +", "cmd": "click", "name": "pelican.rayLayout.group.add"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.rayLayout.addDialog", "visible": true, "timeout_ms": 10000},
    {"label": "the name is proposed, nothing typed", "expect": "text_equals", "name": "pelican.rayLayout.addDialog.name", "value": "group_2"},
    {"label": "its closest hit from the template", "cmd": "click", "name": "pelican.rayLayout.addDialog.template"},
    {"label": "Add: the layout and the task's grid in one batch", "cmd": "click", "name": "pelican.rayLayout.addDialog.ok"},
    {"label": "saved", "cmd": "wait", "name": "pelican.rayLayout.notice", "contains": "Saved: Add hit group group_2.", "timeout_ms": 120000},
    {"label": "the layout has it", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "names.groups[1].name", "value": "group_2", "retry_ms": 30000},
    {"label": "the task's grid has its cell", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.hit_shaders.primary.group_2.closesthit", "value": "project://shaders/hit_group_2", "retry_ms": 30000},
    {"label": "its closest hit is written", "file": "contains", "path": "{artifacts}/gb_hg/shaders/hit_group_2.rchit", "text": "GROUP_TINT", "value": true},
    {"label": "no restart for this one: the same engine", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "mode", "value": "layout"},

    {"label": "the assignments list material", "cmd": "wait", "name": "pelican.rayLayout.assign.material.group", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "material in the default group", "cmd": "select", "name": "pelican.rayLayout.assign.material.group", "text": "default"},
    {"label": "the bindings hold it", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "bindings.document.bindings[0].group", "value": "default", "retry_ms": 30000},
    {"label": "pick the Sphere", "cmd": "select", "name": "pelican.outliner", "text": "Sphere"},
    {"label": "the Inspector names it", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "Sphere\n", "timeout_ms": 30000},
    {"label": "its Material rows are read", "cmd": "wait", "name": "pelican.inspectorAssignHitGroup", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "decision 4: the Inspector's Assign hit group... opens the material's assignment row", "cmd": "click", "name": "pelican.inspectorAssignHitGroup"},
    {"label": "the section names the material it opened", "cmd": "wait", "name": "pelican.rayLayout.notice", "contains": "Pick the hit group of material_2", "timeout_ms": 30000},
    {"label": "pick the camera again", "cmd": "select", "name": "pelican.outliner", "text": "MainCamera"},
    {"label": "the Inspector holds the camera", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "MainCamera\n", "timeout_ms": 30000},
    {"label": "the row is read again", "cmd": "wait", "name": "pelican.rayLayout.assign.material_2.group", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "material_2 in group_2", "cmd": "select", "name": "pelican.rayLayout.assign.material_2.group", "text": "group_2"},
    {"label": "the bindings hold it", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "bindings.document.bindings[1].group", "value": "group_2", "retry_ms": 30000},
    {"label": "selected by its document", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "bindings.document.bindings[1].material.document", "value": "materials/material_2.material.json"},
    {"label": "every assignment matches an object", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "unresolved_bindings.$len", "value": 0, "retry_ms": 30000},
    {"label": "the sphere's rows answer from group_2", "expect": "rpc_equals", "method": "get_ray_occurrences", "params": {"name": "Sphere"}, "path": "entries[0].binding.group_name", "value": "group_2", "retry_ms": 60000},
    {"label": "the cube's from default", "expect": "rpc_equals", "method": "get_ray_occurrences", "params": {"name": "Cube"}, "path": "entries[0].binding.group_name", "value": "default", "retry_ms": 60000},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the picture", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/hit_groups.png", "pixels": [[0.27, 0.5], [0.70, 0.5], [0.04, 0.04]]}, "path": "pixels[1]", "remember": "sphere"},
    {"label": "the cube", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/hit_groups.png", "pixels": [[0.27, 0.5], [0.70, 0.5], [0.04, 0.04]]}, "path": "pixels[0]", "remember": "cube"},
    {"label": "the sky", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/hit_groups.png", "pixels": [[0.27, 0.5], [0.70, 0.5], [0.04, 0.04]]}, "path": "pixels[2]", "remember": "sky"},
    {"label": "the two objects are different colours", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/hit_groups.png", "pixels": [[0.27, 0.5], [0.70, 0.5]]}, "path": "pixels[1]", "op": "ne", "value_of": "cube", "retry_ms": 60000},
    {"label": "the sphere is not the sky", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/hit_groups.png", "pixels": [[0.27, 0.5], [0.70, 0.5]]}, "path": "pixels[1]", "op": "ne", "value_of": "sky"},
    {"label": "nor the cube", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/hit_groups.png", "pixels": [[0.27, 0.5], [0.70, 0.5]]}, "path": "pixels[0]", "op": "ne", "value_of": "sky"},
    {"label": "the sphere in group_2's tint: red above blue", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/hit_groups.png", "pixels": [[0.70, 0.5]]}, "path": "rgb[0][0]", "remember": "sphere_red"},
    {"label": "its blue", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/hit_groups.png", "pixels": [[0.70, 0.5]]}, "path": "rgb[0][2]", "op": "lt", "value_of": "sphere_red"},
    {"label": "the cube in the default group's normal colour: blue above red", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/hit_groups.png", "pixels": [[0.27, 0.5]]}, "path": "rgb[0][2]", "remember": "cube_blue"},
    {"label": "its red", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/hit_groups.png", "pixels": [[0.27, 0.5]]}, "path": "rgb[0][0]", "op": "lt", "value_of": "cube_blue"},
    {"label": "a picture of the window", "expect": "screenshot", "path": "gui_rt_hit_groups_from_blank_window.png"}
  ]
}
