{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "graph_lift_line",
  "description": "GC-1: inside the definition body, a line from an output is connected normally, then two connected inputs are lifted and let go on empty canvas. Each lift is a cut sent as one graph edit, and one Undo brings the line back. The same document is read back after every step.",
  "tab": "graph",
  "probe_no_automation": false,
  "steps": [
    {"label": "the engine viewport answers editor RPC", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "the canvas has drawn the owned instance", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#left", "visible": true, "timeout_ms": 120000},
    {"label": "descend into the definition, which is where the lines are", "cmd": "double_click", "name": "pelican.graphCanvasView::graph_node#left"},
    {"label": "the canvas is inside the definition body", "cmd": "wait", "name": "pelican.graphCanvasBreadcrumb", "text": "root / gain_curve", "timeout_ms": 30000},
    {"label": "the body's three nodes are drawn", "expect": "list_count", "pattern": "pelican.graphCanvasView::graph_node#", "value": 3},
    {"label": "auto layout", "cmd": "action", "name": "pelican.graphCanvas.autoLayout"},
    {"label": "the placement was saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "the definition names its three nodes", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "definitions.gain_curve.layout.nodes.$len", "value": 3},
    {"label": "fit, so both ends of the drag are on screen", "cmd": "action", "name": "pelican.graphCanvas.fitView"},

    {"label": "a line from bias's value onto sum's a, which already has gain's line", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#bias/out:value"}, "to": {"name": "pelican.graphCanvasView::graph_socket#sum/in:a"}, "steps": 8},
    {"label": "the ordinary connection was saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "the document says a is bias now", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "definitions.gain_curve.nodes[2].inputs.a.node", "value": "bias", "retry_ms": 60000},

    {"label": "fit again after the connection", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "lift the connected a by its socket and let it go on empty canvas -- the canvas's top-left corner is in the fit margin", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#sum/in:a"}, "to": {"name": "pelican.graphCanvasView", "point": [2, 2]}, "steps": 12},
    {"label": "the cut was saved as one edit", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "the line into a is gone", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "definitions.gain_curve.nodes[2].inputs.a", "value": null, "retry_ms": 60000},
    {"label": "the line into a is not drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_edge#gain->sum", "missing": true, "timeout_ms": 30000},

    {"label": "Undo is offered", "cmd": "wait", "name": "pelican.graphCanvas.undoButton", "enabled": true, "timeout_ms": 30000},
    {"label": "Undo the cut", "cmd": "action", "name": "pelican.graphCanvas.undo"},
    {"label": "the undo was saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "the line into a is gain's again", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "definitions.gain_curve.nodes[2].inputs.a.node", "value": "gain", "retry_ms": 60000},
    {"label": "and it is drawn again", "cmd": "wait", "name": "pelican.graphCanvasView::graph_edge#gain->sum", "visible": true, "timeout_ms": 30000},

    {"label": "fit again", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "lift another connected input, b", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#sum/in:b"}, "to": {"name": "pelican.graphCanvasView", "point": [2, 2]}, "steps": 12},
    {"label": "the second cut was saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "b has no line", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "definitions.gain_curve.nodes[2].inputs.b", "value": null, "retry_ms": 60000},
    {"label": "a still has its line", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "definitions.gain_curve.nodes[2].inputs.a.node", "value": "gain"},
    {"label": "Undo is offered again", "cmd": "wait", "name": "pelican.graphCanvas.undoButton", "enabled": true, "timeout_ms": 30000},
    {"label": "Undo the second cut", "cmd": "action", "name": "pelican.graphCanvas.undo"},
    {"label": "the second undo was saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "b has bias's line again", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "definitions.gain_curve.nodes[2].inputs.b.node", "value": "bias", "retry_ms": 60000},
    {"label": "fit, and a picture of the two lines that came back", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "a picture of the body", "expect": "screenshot", "path": "graph_lift_line.png"}
  ]
}
