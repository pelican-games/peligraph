{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "project_tree",
  "description": "PRJ-1a: the Project dock lists the whole folder of a real project. Refresh picks up an outside file, a hidden dock reads when shown, and the kind and text filters narrow the tree to a known shader and a known material.",
  "tab": "graph",
  "viewport": null,
  "steps": [
    {"label": "the engine is up", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "the default layout raises Project", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "the shaders folder is listed", "cmd": "wait", "name": "pelican.projectTree::row#shaders", "visible": true, "timeout_ms": 30000},
    {"label": "the materials folder is listed", "cmd": "wait", "name": "pelican.projectTree::row#materials", "visible": true, "timeout_ms": 10000},
    {"label": "a folder Assets does not show is listed", "cmd": "wait", "name": "pelican.projectTree::row#input", "visible": true, "timeout_ms": 10000},
    {"label": "this small project isn't truncated", "cmd": "wait", "name": "pelican.project.truncated", "visible": false, "timeout_ms": 10000},
    {"label": "an editor outside Studio writes a file", "file": "write", "path": "{project}/probe_refresh/note.txt", "text": "probe\n"},
    {"label": "no watcher in this slice: not there yet", "cmd": "wait", "name": "pelican.projectTree::row#probe_refresh", "missing": true, "timeout_ms": 5000},
    {"label": "Refresh", "cmd": "click", "name": "pelican.project.refresh"},
    {"label": "the new folder is listed", "cmd": "wait", "name": "pelican.projectTree::row#probe_refresh", "visible": true, "timeout_ms": 30000},
    {"label": "hide the Project dock", "cmd": "action", "name": "pelican.view.panels.projectDock"},
    {"label": "it is hidden", "cmd": "wait", "name": "pelican.projectDock", "visible": false, "timeout_ms": 10000},
    {"label": "a file written while hidden", "file": "write", "path": "{project}/probe_hidden/note.txt", "text": "probe\n"},
    {"label": "the default layout shows and raises Project", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "it reads once shown, with no Refresh", "cmd": "wait", "name": "pelican.projectTree::row#probe_hidden", "visible": true, "timeout_ms": 30000},
    {"label": "show shaders only", "cmd": "select", "name": "pelican.project.kind", "text": "shader"},
    {"label": "the shaders folder stays", "cmd": "wait", "name": "pelican.projectTree::row#shaders", "visible": true, "timeout_ms": 10000},
    {"label": "the same materials row is gone", "cmd": "wait", "name": "pelican.projectTree::row#materials", "missing": true, "timeout_ms": 10000},
    {"label": "the known shader is on screen and can be picked", "cmd": "select", "name": "pelican.projectTree", "text": "toon.surface", "timeout_ms": 10000},
    {"label": "show materials only", "cmd": "select", "name": "pelican.project.kind", "text": "material"},
    {"label": "narrow by text as well", "cmd": "type", "name": "pelican.project.search", "text": "toon"},
    {"label": "the materials row is back", "cmd": "wait", "name": "pelican.projectTree::row#materials", "visible": true, "timeout_ms": 10000},
    {"label": "the shaders row is gone: its one toon file isn't a material", "cmd": "wait", "name": "pelican.projectTree::row#shaders", "missing": true, "timeout_ms": 10000},
    {"label": "the known material can be picked", "cmd": "select", "name": "pelican.projectTree", "text": "toon.material.json", "timeout_ms": 10000},
    {"label": "all kinds again", "cmd": "select", "name": "pelican.project.kind", "text": "All kinds"},
    {"label": "only the probe by text", "cmd": "type", "name": "pelican.project.search", "text": "probe_refresh"},
    {"label": "the probe remains", "cmd": "wait", "name": "pelican.projectTree::row#probe_refresh", "visible": true, "timeout_ms": 10000},
    {"label": "the shaders row is gone", "cmd": "wait", "name": "pelican.projectTree::row#shaders", "missing": true, "timeout_ms": 10000}
  ]
}
