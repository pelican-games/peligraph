{
  "invariants": {
    "undo": "known_red",
    "undo_ticket": "QD1-R25"
  },
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "gui_build_rt_from_blank",
  "description": "CT-6s: a ray tracing task of the project's own, from File > New Project > Blank with Studio's GUI only, on the Graph tab. Add Object > Cube gives the rays something to hit. The palette's render.compute row has New... beside its shader list (decision 3): pressed, it writes shaders/ray_tracing.rgen, .rmiss and .rchit -- the starting set, in the form of the engine's rt_shadow_mask_pipeline (pelican_sets.glsl and pelican_frame.glsl, the scene at the ray query binding, one storage image pelican_resource_color, rgba16f) -- under the name it proposes, and picks it. Placed, Studio asks the engine for the set's interface (get_shader_interface compiles the three stages on the GPU's compiler) and the task arrives tracing with it: ray_tracing raygen / miss / closesthit the set, its color port written into an image of its own (R16G16B16A16_SFLOAT, the format the shader declares) and as many rays as that image's pixels (dispatch.rays_from). The task's output dragged onto present's + input is taken, and the viewport shows the trace: the middle -- the cube -- is not the gradient, and not the sky the miss leaves in the corner. Decision 1: the task's ray_tracing is in its fields (More parameters), and Max recursion typed 2 is in the document, the engine still presenting the trace. Typed: the project folder and the name gb_rt in New Project, render.compute in the palette's filter, and 2 in Max recursion.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up, so the switch to the new project is something that happens", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "start from the default layout", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "visible": true, "timeout_ms": 10000},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "gb_rt"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "missing": true, "timeout_ms": 10000},
    {"label": "the blank project's present is on the Frame Plan canvas", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "visible": true, "timeout_ms": 180000},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "Add Object > Cube: something for the rays to hit", "cmd": "action", "name": "pelican.outliner.addObject.cube"},
    {"label": "the engine has a Cube", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[2].name", "value": "Cube", "retry_ms": 60000},
    {"label": "the Inspector has read the Cube", "cmd": "wait", "name": "pelican.inspectorModelChoice", "text": "Cube (built-in)", "timeout_ms": 60000},
    {"label": "File > Save Scene", "cmd": "action", "name": "pelican.file.saveScene"},
    {"label": "the save is done", "cmd": "wait", "name": "pelican.inspectorNotice", "contains": "Scene saved", "timeout_ms": 60000},
    {"label": "pick the camera, so no gizmo is drawn over the cube", "cmd": "select", "name": "pelican.outliner", "text": "MainCamera"},
    {"label": "the Inspector holds the camera", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "MainCamera\n", "timeout_ms": 30000},
    {"label": "the Graph tab is in front", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the canvas has read the new document and can edit it", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "Add: the palette opens", "cmd": "click", "name": "pelican.graphCanvasAddNode"},
    {"label": "the palette is on screen", "cmd": "wait", "name": "pelican.graphCanvasPalette", "visible": true, "timeout_ms": 10000},
    {"label": "the filter narrows the list to the compute task", "cmd": "type", "name": "pelican.graphCanvasPaletteFilter", "text": "render.compute"},
    {"label": "what it runs is offered", "cmd": "wait", "name": "pelican.graphCanvasPaletteComputeShader", "visible": true, "timeout_ms": 10000},
    {"label": "decision 3: New... beside it", "cmd": "wait", "name": "pelican.graphCanvasPaletteComputeNew", "visible": true, "enabled": true, "timeout_ms": 10000},
    {"label": "New...: the ray tracing set, under the name it proposes", "cmd": "click", "name": "pelican.graphCanvasPaletteComputeNew"},
    {"label": "written and picked: the set is the shader the task runs", "cmd": "wait", "name": "pelican.graphCanvasPaletteComputeShader", "text": "project://shaders/ray_tracing  (ray tracing)", "timeout_ms": 10000},
    {"label": "its raygen is in the project", "file": "exists", "path": "{artifacts}/gb_rt/shaders/ray_tracing.rgen", "value": true},
    {"label": "its miss", "file": "exists", "path": "{artifacts}/gb_rt/shaders/ray_tracing.rmiss", "value": true},
    {"label": "its closest hit", "file": "exists", "path": "{artifacts}/gb_rt/shaders/ray_tracing.rchit", "value": true},
    {"label": "the raygen is the engine's form: its frame include", "file": "contains", "path": "{artifacts}/gb_rt/shaders/ray_tracing.rgen", "text": "#include \"pelican_frame.glsl\"", "value": true},
    {"label": "Enter in the filter is OK", "cmd": "key", "name": "pelican.graphCanvasPaletteFilter", "sequence": "Return"},
    {"label": "the palette closed", "cmd": "wait", "name": "pelican.graphCanvasPalette", "missing": true, "timeout_ms": 10000},
    {"label": "once the engine has read the set (its three stages compiled), the task is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_compute", "visible": true, "timeout_ms": 180000},
    {"label": "and its image beside it", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_compute__color", "visible": true, "timeout_ms": 60000},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 120000},
    {"label": "the task is the second node, after its image", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].id", "value": "render_compute", "retry_ms": 60000},
    {"label": "it traces with the set: raygen", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.raygen", "value": "project://shaders/ray_tracing"},
    {"label": "miss", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.miss", "value": "project://shaders/ray_tracing"},
    {"label": "closest hit", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.closesthit", "value": "project://shaders/ray_tracing"},
    {"label": "as many rays as the image's pixels", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.dispatch.rays_from.port", "value": "color"},
    {"label": "the image the raygen writes, in the format it declares", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.format", "value": "R16G16B16A16_SFLOAT"},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "auto layout", "cmd": "action", "name": "pelican.graphCanvas.autoLayout"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "pick render_compute", "cmd": "click", "name": "pelican.graphCanvasView::graph_node#render_compute"},
    {"label": "its Shader field names the set", "cmd": "wait", "name": "pelican.graphCanvasCompute.shader", "text": "project://shaders/ray_tracing  (ray tracing)", "visible": true, "timeout_ms": 30000},
    {"label": "the engine read it: no reflection error line", "cmd": "wait", "name": "pelican.graphCanvasCompute.copyMessage", "visible": false, "timeout_ms": 10000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "present offers an empty + input", "cmd": "wait", "name": "pelican.graphCanvasView::graph_derived_socket#present/in:+", "visible": true, "timeout_ms": 60000},
    {"label": "before: the gradient's middle", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/before.png", "pixels": [[0.5, 0.5]]}, "path": "pixels[0]", "remember": "gradient_middle"},
    {"label": "the trace onto present's + input", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#render_compute/out:color"}, "to": {"name": "pelican.graphCanvasView::graph_derived_socket#present/in:+"}, "steps": 8},
    {"label": "the engine takes it: present's inputs saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Pass inputs saved.", "timeout_ms": 120000},
    {"label": "first the scene's acceleration structure is built", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "nodes[0].name", "value": "__scene_acceleration_structure", "retry_ms": 120000},
    {"label": "then the trace, a task of the frame plan", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "nodes[1].name", "value": "render_compute", "retry_ms": 120000},
    {"label": "and present stands after it", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "nodes[2].name", "value": "present", "retry_ms": 120000},
    {"label": "reading its image", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "nodes[2].reads[0]", "value": "render_compute__color"},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the middle is the trace, not the gradient", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/trace.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[0]", "op": "ne", "value_of": "gradient_middle", "retry_ms": 120000},
    {"label": "the corner: the sky the miss leaves", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/trace.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[1]", "remember": "sky"},
    {"label": "the middle -- the cube, coloured by its normal -- is not the sky", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/trace.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[0]", "op": "ne", "value_of": "sky"},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "pick render_compute", "cmd": "click", "name": "pelican.graphCanvasView::graph_node#render_compute"},
    {"label": "decision 1: the rest of its parameters", "cmd": "wait", "name": "pelican.graphCanvasParameters.more", "visible": true, "timeout_ms": 30000},
    {"label": "More parameters opens", "cmd": "click", "name": "pelican.graphCanvasParameters.more"},
    {"label": "ray_tracing is one of them", "cmd": "wait", "name": "pelican.graphCanvasParameters.ray_tracing.fold", "visible": true, "timeout_ms": 10000},
    {"label": "its fields open", "cmd": "click", "name": "pelican.graphCanvasParameters.ray_tracing.fold"},
    {"label": "its raygen is the set, from the project's raygen shaders", "cmd": "wait", "name": "pelican.graphCanvasParameters.ray_tracing.raygen", "text": "project://shaders/ray_tracing", "visible": true, "timeout_ms": 10000},
    {"label": "Max recursion: a spin", "cmd": "wait", "name": "pelican.graphCanvasParameters.ray_tracing.max_recursion", "visible": true, "enabled": true, "timeout_ms": 10000},
    {"label": "2 typed", "cmd": "type", "name": "pelican.graphCanvasParameters.ray_tracing.max_recursion", "text": "2"},
    {"label": "Return gives it", "cmd": "key", "name": "pelican.graphCanvasParameters.ray_tracing.max_recursion", "sequence": "Return"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 120000},
    {"label": "the engine has it: max_recursion 2", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.max_recursion", "value": 2, "retry_ms": 60000},
    {"label": "the rest of ray_tracing kept", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.raygen", "value": "project://shaders/ray_tracing"},
    {"label": "the engine has presented frames with it", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "and still traces: the middle is not the gradient", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/trace_recursion.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[0]", "op": "ne", "value_of": "gradient_middle", "retry_ms": 60000},
    {"label": "a picture of the window", "expect": "screenshot", "path": "gui_build_rt_from_blank_window.png"},
    {"label": "a picture of the Graph tab with the trace task", "expect": "screenshot", "name": "pelican.graphCanvas", "path": "gui_build_rt_from_blank_graph.png"}
  ]
}
