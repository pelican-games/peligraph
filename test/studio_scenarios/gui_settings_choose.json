{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "gui_settings_choose",
  "description": "UX-10: the settings a type already says are chosen, not typed. From File > New Project > Blank, gui_build_D's deferred pipeline with its lighting pass and shadow_directional (the same steps), then Features: shadow_directional's Parameters are fields made from its schema -- strength's slider pushed to its end with End, sent at once without Apply, and the shadowed floor changes; pcf_radius's spin takes 2 (cascade_count's 3 is refused on this graph: its shadow_map target_ref is declared two_d, graph.target_ref_type_mismatch@1). The KeyLight's direction is an azimuth and an elevation in the Inspector (its colour a swatch): the azimuth turned from -63.43 to 63.43 moves the shadow from the box's left to its right. Rendering settings: material_route_default picked Forward is sent as set_material_route_default and refused by the engine (material_route_unserved@1: this pipeline's only material pass is deferred); the tab says so and the field goes back to Auto. Snapshots' + sends one row, named and placed after the opaque pass, without typing; the engine refuses it here too (Execution dependency references an unknown node: post_ldr -- this graph has no post_ldr anchor), the tab says so and no row stays. Nothing is JSON. Where it stops: sky_ambient is refused on this pipeline (render target override references unknown render target scene_depth), so its colour row is not driven here (the widget test drives it). Typed: the project folder and the name gsc in New Project, material_pass in the palette's filter (as gui_build_D), and the numbers 2 and 63.43.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up, so the switch to the new project is something that happens", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "start from the default layout", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "visible": true, "timeout_ms": 10000},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "gsc"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "missing": true, "timeout_ms": 10000},
    {"label": "the blank project's present is on the Frame Plan canvas", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "visible": true, "timeout_ms": 180000},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the Graph tab is in front", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the canvas has read the new document and can edit it", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "Add: the palette opens", "cmd": "click", "name": "pelican.graphCanvasAddNode"},
    {"label": "the palette is on screen", "cmd": "wait", "name": "pelican.graphCanvasPalette", "visible": true, "timeout_ms": 10000},
    {"label": "the filter narrows the list to the material pass", "cmd": "type", "name": "pelican.graphCanvasPaletteFilter", "text": "material_pass"},
    {"label": "the contract combo is offered for it", "cmd": "wait", "name": "pelican.graphCanvasPaletteContract", "visible": true, "timeout_ms": 10000},
    {"label": "a deferred pass: the G-buffer", "cmd": "select", "name": "pelican.graphCanvasPaletteContract", "text": "deferred_geometry_v1"},
    {"label": "Enter in the filter is OK", "cmd": "key", "name": "pelican.graphCanvasPaletteFilter", "sequence": "Return"},
    {"label": "the palette closed", "cmd": "wait", "name": "pelican.graphCanvasPalette", "missing": true, "timeout_ms": 10000},
    {"label": "the pass's draw loop is drawn as a zone (after the restart the route default asks for)", "cmd": "wait", "name": "pelican.graphCanvasView::graph_zone#render_material_pass_draws", "visible": true, "timeout_ms": 180000},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the material pass is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_material_pass", "visible": true, "timeout_ms": 60000},
    {"label": "Add Object > Cube", "cmd": "action", "name": "pelican.outliner.addObject.cube"},
    {"label": "the engine has a Cube", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[2].name", "value": "Cube", "retry_ms": 60000},
    {"label": "the Inspector has read the Cube", "cmd": "wait", "name": "pelican.inspectorModelChoice", "text": "Cube (built-in)", "timeout_ms": 60000},
    {"label": "Add Object > Floor", "cmd": "action", "name": "pelican.outliner.addObject.floor"},
    {"label": "the engine has a Floor", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[3].name", "value": "Floor", "retry_ms": 60000},
    {"label": "the Floor is selected", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "Floor\n", "timeout_ms": 30000},
    {"label": "the Inspector has read the Floor", "cmd": "wait", "name": "pelican.inspectorVector.transform.pos.1", "contains": "-0.5000", "timeout_ms": 60000},
    {"label": "File > Save Scene", "cmd": "action", "name": "pelican.file.saveScene"},
    {"label": "the save is done", "cmd": "wait", "name": "pelican.inspectorNotice", "contains": "Scene saved", "timeout_ms": 60000},
    {"label": "pick the camera, so no gizmo is drawn over the box", "cmd": "select", "name": "pelican.outliner", "text": "MainCamera"},
    {"label": "the Inspector holds the camera", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "MainCamera\n", "timeout_ms": 30000},
    {"label": "the Graph tab is in front again", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "fit the graph", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "Add fullscreen pass: the lighting pass", "cmd": "action", "name": "pelican.graphCanvas.addFullscreenPass"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "auto layout", "cmd": "action", "name": "pelican.graphCanvas.autoLayout"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "the new pass is the document's tenth node", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].id", "value": "render_fullscreen", "retry_ms": 60000},
    {"label": "pick it", "cmd": "click", "name": "pelican.graphCanvasView::graph_node#render_fullscreen"},
    {"label": "its Frame data offers Uses scene lights", "cmd": "wait", "name": "pelican.graphCanvasPass.usesLightData", "visible": true, "enabled": true, "timeout_ms": 30000},
    {"label": "Uses scene lights: the pass is the frame's lighting pass", "cmd": "click", "name": "pelican.graphCanvasPass.usesLightData"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "it uses the scene lights", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].parameters.uses_light_data", "value": true, "retry_ms": 60000},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "Features tab", "cmd": "action", "name": "pelican.view.renderTools.render_features"},
    {"label": "catalog read", "cmd": "wait", "name": "pelican.renderFeatures.catalog", "visible": true, "timeout_ms": 60000},
    {"label": "pick shadow_directional", "cmd": "select", "name": "pelican.renderFeatures.catalog", "text": "shadow_directional"},
    {"label": "Add", "cmd": "click", "name": "pelican.renderFeatures.add"},
    {"label": "Apply ready", "cmd": "wait", "name": "pelican.renderFeatures.apply", "enabled": true, "timeout_ms": 30000},
    {"label": "Apply", "cmd": "click", "name": "pelican.renderFeatures.apply"},
    {"label": "RS-10: the root lists shadow_directional, the deferred pipeline with a lighting pass of its own is taken", "expect": "rpc_equals", "method": "get_render_features", "params": {}, "path": "features[0]", "value": "engine://features/shadow_directional.json", "retry_ms": 120000},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the frame plan draws the shadow map first", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "nodes[0].writes[0]", "value": "shadow_map", "retry_ms": 120000},
    {"label": "Graph tab", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "canvas editable", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "pick the lighting pass", "cmd": "click", "name": "pelican.graphCanvasView::graph_node#render_fullscreen"},
    {"label": "its Pass fields offer New... beside the fragment, once the graph takes edits", "cmd": "wait", "name": "pelican.graphCanvasPass.newFragmentShader", "visible": true, "timeout_ms": 180000, "enabled": true},
    {"label": "New...", "cmd": "click", "name": "pelican.graphCanvasPass.newFragmentShader"},
    {"label": "the Pass Editor's templates, once the graph takes edits again", "cmd": "wait", "name": "pelican.graphCanvasPass.shaderTemplateKind", "visible": true, "enabled": true, "timeout_ms": 180000},
    {"label": "start from Deferred lighting", "cmd": "select", "name": "pelican.graphCanvasPass.shaderTemplateKind", "text": "Deferred lighting"},
    {"label": "named after it, nothing typed", "expect": "text_equals", "name": "pelican.graphCanvasPass.shaderTemplateName", "value": "deferred_lighting"},
    {"label": "Create", "cmd": "click", "name": "pelican.graphCanvasPass.createFragmentShader"},
    {"label": "the shader is written and the pass takes it", "cmd": "wait", "name": "pelican.graphCanvasPass.shaderTemplateNotice", "contains": "the pass draws with project://shaders/deferred_lighting", "timeout_ms": 30000},
    {"label": "saved, as one edit", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 120000},
    {"label": "the pass draws with the new shader", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].parameters.shader.fragment", "value": "project://shaders/deferred_lighting", "retry_ms": 60000},
    {"label": "a line from the material pass's albedo output", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].inputs.albedo.node", "value": "render_material_pass"},
    {"label": "the edit added a reference to the feature's shadow map", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[10].parameters.name", "value": "shadow_map"},
    {"label": "and a line from it to the lighting pass", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[9].inputs.shadow_map.node", "value": "shadow_map_ref"},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "present offers an empty + input", "cmd": "wait", "name": "pelican.graphCanvasView::graph_derived_socket#present/in:+", "visible": true, "timeout_ms": 120000},
    {"label": "the lit colour onto present's + input", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#render_fullscreen/out:color"}, "to": {"name": "pelican.graphCanvasView::graph_derived_socket#present/in:+"}, "steps": 8},
    {"label": "present's inputs saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Pass inputs saved.", "timeout_ms": 120000},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the lighting pass reads the shadow map the feature drew", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "nodes[2].reads[5]", "value": "shadow_map", "retry_ms": 60000},
    {"label": "and present reads the lighting pass", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "nodes[3].reads[0]", "value": "render_fullscreen__color"},
    {"label": "the lit floor right of the box, read", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/lit.png", "pixels": [[0.69, 0.7], [0.31, 0.7], [0.5, 0.5]]}, "path": "pixels[0]", "remember": "lit_floor", "retry_ms": 120000},
    {"label": "the floor left of the box is in its shadow: not the lit floor's colour", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/lit.png", "pixels": [[0.69, 0.7], [0.31, 0.7], [0.5, 0.5]]}, "path": "pixels[1]", "op": "ne", "value_of": "lit_floor", "retry_ms": 120000},
    {"label": "and the box is not the floor either", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/lit.png", "pixels": [[0.69, 0.7], [0.31, 0.7], [0.5, 0.5]]}, "path": "pixels[2]", "op": "ne", "value_of": "lit_floor"},
    {"label": "Features tab", "cmd": "action", "name": "pelican.view.renderTools.render_features"},
    {"label": "the catalog is read", "cmd": "wait", "name": "pelican.renderFeatures.catalog", "visible": true, "timeout_ms": 60000},
    {"label": "the feature list has been read again", "cmd": "wait", "name": "pelican.renderFeatures.parameters", "visible": true, "timeout_ms": 60000},
    {"label": "pick shadow_directional", "cmd": "select", "name": "pelican.renderFeatures.current", "text": "shadow_directional"},
    {"label": "Parameters is offered for it", "cmd": "wait", "name": "pelican.renderFeatures.parameters", "enabled": true, "timeout_ms": 60000},
    {"label": "Parameters", "cmd": "click", "name": "pelican.renderFeatures.parameters"},
    {"label": "the parameters are on screen, as fields", "cmd": "wait", "name": "pelican.featureParameters", "visible": true, "timeout_ms": 30000},
    {"label": "strength has a slider (its range is 0 to 1)", "cmd": "wait", "name": "pelican.featureParameters.strength.slider", "visible": true, "timeout_ms": 30000},
    {"label": "the shadowed floor, read before", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/before_strength.png", "pixels": [[0.69, 0.7], [0.31, 0.7], [0.5, 0.5]]}, "path": "pixels[1]", "remember": "shadow_floor", "retry_ms": 60000},
    {"label": "strength: the slider to its end (End on the slider), a full shadow", "cmd": "key", "name": "pelican.featureParameters.strength.slider", "sequence": "End"},
    {"label": "sent at once, without Apply: the feature's strength is 1", "expect": "rpc_equals", "method": "get_render_features", "params": {}, "path": "feature_instances[0].parameters.strength", "value": 1.0, "retry_ms": 120000},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the shadow is darker: the floor left of the box changed", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/after_strength.png", "pixels": [[0.69, 0.7], [0.31, 0.7], [0.5, 0.5]]}, "path": "pixels[1]", "op": "ne", "value_of": "shadow_floor", "retry_ms": 120000},
    {"label": "Reset is offered on strength (not the default any more)", "cmd": "wait", "name": "pelican.featureParameters.strength.reset", "visible": true, "timeout_ms": 30000},
    {"label": "pcf_radius: a spin (an int, 0 to 2), 2 typed", "cmd": "type", "name": "pelican.featureParameters.pcf_radius", "text": "2"},
    {"label": "Return gives it", "cmd": "key", "name": "pelican.featureParameters.pcf_radius", "sequence": "Return"},
    {"label": "the feature's pcf_radius is 2, its strength kept", "expect": "rpc_equals", "method": "get_render_features", "params": {}, "path": "feature_instances[0].parameters.pcf_radius", "value": 2, "retry_ms": 180000},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "a picture of the shadow's parameters", "expect": "screenshot", "name": "pelican.featureParameters", "path": "gui_settings_choose_shadow.png"},
    {"label": "Close", "cmd": "click", "name": "pelican.featureParameters.close"},
    {"label": "the parameters closed", "cmd": "wait", "name": "pelican.featureParameters", "missing": true, "timeout_ms": 30000},
    {"label": "pick the key light", "cmd": "select", "name": "pelican.outliner", "text": "KeyLight"},
    {"label": "the Inspector holds it", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "KeyLight\n", "timeout_ms": 30000},
    {"label": "its direction is an azimuth and an elevation", "cmd": "wait", "name": "pelican.inspectorDirection.light.direction.azimuth", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "the template's light comes from the right: azimuth -63.43", "cmd": "wait", "name": "pelican.inspectorDirection.light.direction.azimuth", "contains": "-63.43", "timeout_ms": 30000},
    {"label": "its colour is a swatch", "cmd": "wait", "name": "pelican.inspectorColor.light.color", "visible": true, "timeout_ms": 30000},
    {"label": "the floor right of the box, read before (lit)", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/before_direction.png", "pixels": [[0.69, 0.7], [0.31, 0.7], [0.5, 0.5]]}, "path": "pixels[0]", "remember": "right_floor", "retry_ms": 60000},
    {"label": "the floor left of the box, read before (in shadow)", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/before_direction.png", "pixels": [[0.69, 0.7], [0.31, 0.7], [0.5, 0.5]]}, "path": "pixels[1]", "remember": "left_floor"},
    {"label": "the light turned to come from the left: azimuth 63.43", "cmd": "type", "name": "pelican.inspectorDirection.light.direction.azimuth", "text": "63.43"},
    {"label": "Return gives it", "cmd": "key", "name": "pelican.inspectorDirection.light.direction.azimuth", "sequence": "Return"},
    {"label": "the light's direction points the other way along x", "expect": "result", "command": {"cmd": "rpc", "method": "get_components", "params": {"name": "KeyLight"}}, "path": "result.components[0].authored_json.direction[0]", "op": "gt", "value": 0.3, "retry_ms": 60000},
    {"label": "and still down", "expect": "result", "command": {"cmd": "rpc", "method": "get_components", "params": {"name": "KeyLight"}}, "path": "result.components[0].authored_json.direction[1]", "op": "lt", "value": -0.5},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the shadow moved: the floor left of the box is lit now", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/after_direction.png", "pixels": [[0.69, 0.7], [0.31, 0.7], [0.5, 0.5]]}, "path": "pixels[1]", "op": "ne", "value_of": "left_floor", "retry_ms": 120000},
    {"label": "and the floor right of it is not the lit floor any more", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/after_direction.png", "pixels": [[0.69, 0.7], [0.31, 0.7], [0.5, 0.5]]}, "path": "pixels[0]", "op": "ne", "value_of": "right_floor", "retry_ms": 120000},
    {"label": "File > Save Scene", "cmd": "action", "name": "pelican.file.saveScene"},
    {"label": "the save is done", "cmd": "wait", "name": "pelican.inspectorNotice", "contains": "Scene saved", "timeout_ms": 60000},
    {"label": "View > Render Tools > Rendering settings", "cmd": "action", "name": "pelican.view.renderTools.rendering_settings"},
    {"label": "the tab has read the root", "cmd": "wait", "name": "pelican.renderingSettings.material_route_default", "enabled": true, "timeout_ms": 120000},
    {"label": "the route default is the engine's", "expect": "text_equals", "name": "pelican.renderingSettings.material_route_default", "value": "Auto (engine default)"},
    {"label": "Forward, picked", "cmd": "select", "name": "pelican.renderingSettings.material_route_default", "text": "Forward"},
    {"label": "sent: the engine answers that no material pass draws forward here, and the tab says so", "cmd": "wait", "name": "pelican.renderingSettings.notice", "contains": "material_route_unserved@1", "timeout_ms": 120000},
    {"label": "the field goes back to what the root holds", "cmd": "wait", "name": "pelican.renderingSettings.material_route_default", "text": "Auto (engine default)", "timeout_ms": 60000},
    {"label": "the root holds no route default", "expect": "result", "command": {"cmd": "rpc", "method": "get_render_documents", "params": {}}, "path": "result.documents[0].content", "op": "excludes", "value": "material_route_default"},
    {"label": "Snapshots: + is offered", "cmd": "wait", "name": "pelican.renderingSettings.snapshots.add", "enabled": true, "timeout_ms": 120000},
    {"label": "+", "cmd": "click", "name": "pelican.renderingSettings.snapshots.add"},
    {"label": "sent as one edit_rendering_keys: the engine answers that this graph has no post_ldr to copy after, and the tab says so", "cmd": "wait", "name": "pelican.renderingSettings.notice", "contains": "unknown node: post_ldr", "timeout_ms": 120000},
    {"label": "the root holds no snapshot", "expect": "result", "command": {"cmd": "rpc", "method": "get_render_documents", "params": {}}, "path": "result.documents[0].content", "op": "excludes", "value": "opaque_snapshot"},
    {"label": "no row is left behind, and + is offered again", "cmd": "wait", "name": "pelican.renderingSettings.snapshots.add", "enabled": true, "timeout_ms": 60000},
    {"label": "(no row 0)", "cmd": "wait", "name": "pelican.renderingSettings.snapshots.row0.name", "missing": true, "timeout_ms": 30000},
    {"label": "the engine draws", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "a picture of the Rendering settings tab", "expect": "screenshot", "name": "pelican.renderingSettings", "path": "gui_settings_choose_settings.png"},
    {"label": "a picture of the window", "expect": "screenshot", "path": "gui_settings_choose_window.png"}
  ]
}
