{
  "invariants": {
    "undo": "known_red",
    "undo_ticket": "QD1-R14"
  },
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "gui_build_A",
  "description": "GB-1 target A (forward), built from File > New Project > Blank with Studio's GUI only. The Graph tab's palette adds a render.material_pass of forward_opaque_v1 (the engine restarts for the route default), Add Object > Cube gives it something to draw, and the pass's colour output is dragged onto present's + input. The viewport's middle is then the box the pass drew -- not the gradient, and not the colour of the corner. Typed: the project folder and name in New Project, and material_pass in the palette's filter.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up, so the switch to the new project is something that happens", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "visible": true, "timeout_ms": 10000},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "gb_a"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "missing": true, "timeout_ms": 10000},
    {"label": "the blank project's present is on the Frame Plan canvas", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "visible": true, "timeout_ms": 180000},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the Graph tab is in front", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the canvas has read the new document and can edit it", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "Add: the palette opens", "cmd": "click", "name": "pelican.graphCanvasAddNode"},
    {"label": "the palette is on screen", "cmd": "wait", "name": "pelican.graphCanvasPalette", "visible": true, "timeout_ms": 10000},
    {"label": "the filter narrows the list to the material pass", "cmd": "type", "name": "pelican.graphCanvasPaletteFilter", "text": "material_pass"},
    {"label": "the contract combo is offered for it", "cmd": "wait", "name": "pelican.graphCanvasPaletteContract", "visible": true, "timeout_ms": 10000},
    {"label": "a forward pass", "cmd": "select", "name": "pelican.graphCanvasPaletteContract", "text": "forward_opaque_v1"},
    {"label": "Enter in the filter is OK", "cmd": "key", "name": "pelican.graphCanvasPaletteFilter", "sequence": "Return"},
    {"label": "the palette closed", "cmd": "wait", "name": "pelican.graphCanvasPalette", "missing": true, "timeout_ms": 10000},
    {"label": "the pass's draw loop is drawn as a zone (after the restart the route default asks for)", "cmd": "wait", "name": "pelican.graphCanvasView::graph_zone#render_material_pass_draws", "visible": true, "timeout_ms": 180000},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the material pass is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_material_pass", "visible": true, "timeout_ms": 60000},
    {"label": "the frame plan runs its draw loop", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "loops[0].tier", "value": "draw_loop", "retry_ms": 120000},
    {"label": "Add Object > Cube", "cmd": "action", "name": "pelican.outliner.addObject.cube"},
    {"label": "the engine has a Cube", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[2].name", "value": "Cube", "retry_ms": 60000},
    {"label": "the Inspector has read the Cube", "cmd": "wait", "name": "pelican.inspectorModelChoice", "text": "Cube (built-in)", "timeout_ms": 60000},
    {"label": "File > Save Scene", "cmd": "action", "name": "pelican.file.saveScene"},
    {"label": "the save is done", "cmd": "wait", "name": "pelican.inspectorNotice", "contains": "Scene saved", "timeout_ms": 60000},
    {"label": "pick the camera, so no gizmo is drawn over the box", "cmd": "select", "name": "pelican.outliner", "text": "MainCamera"},
    {"label": "the Inspector holds the camera", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "MainCamera\n", "timeout_ms": 30000},
    {"label": "the Graph tab is in front again", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "fit the graph", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "present offers an empty + input", "cmd": "wait", "name": "pelican.graphCanvasView::graph_derived_socket#present/in:+", "visible": true, "timeout_ms": 120000},
    {"label": "before: the gradient's middle", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/before.png", "pixels": [[0.5, 0.5]]}, "path": "pixels[0]", "remember": "gradient_middle"},
    {"label": "the material pass's colour output onto present's + input", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#render_material_pass/out:color"}, "to": {"name": "pelican.graphCanvasView::graph_derived_socket#present/in:+"}, "steps": 8},
    {"label": "present's inputs saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Pass inputs saved.", "timeout_ms": 120000},
    {"label": "the line is the document's", "cmd": "wait", "name": "pelican.graphCanvasView::graph_pass_input_edge#render_material_pass->present", "visible": true, "timeout_ms": 60000},
    {"label": "the middle is what the pass drew, not the gradient", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/after.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[0]", "op": "ne", "value_of": "gradient_middle", "retry_ms": 120000},
    {"label": "the corner, read", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/after.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[1]", "remember": "corner"},
    {"label": "the box: the middle is not the corner's colour", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/after.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[0]", "op": "ne", "value_of": "corner"},
    {"label": "a picture of the window", "expect": "screenshot", "path": "gui_build_A_window.png"}
  ]
}
