{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "forward_loop_from_scratch",
  "description": "G-5, story A, with T-1's defaults: a forward material loop built from a Blank pipeline with Studio alone. New Project (F-2) takes the folder and proposes the name (project_001); Add Object puts a Cube and a Floor (G-2 / T-1), the Floor already under the box and wide; Add material pass... on Blank's graph root is the Graph's palette (GL-5c): forward_opaque_v1 goes into the graph's nodes with its draw loop and its own images, and the forward route default goes with the edit. The scene is unsaved at that point, so before the engine restarts Studio asks Save / Discard / Cancel (G-5) and Save keeps the box and the floor. present reads the pass's colour image (its output dragged onto present's + input on the Graph) through the Blank pipeline's engine://passthrough, which shows its input 0 with no shader written (VI-2). The viewport then shows three colours where there was a gradient: the box, the floor and the background. Another project opened and this one opened again, the engine reads it all from disk and draws the same.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {
      "label": "the fixture's engine is up, so the switch to the new project is something that happens",
      "cmd": "wait_engine",
      "timeout_ms": 180000
    },
    {
      "label": "start from the default layout: the panel layout is the desktop's, saved by whichever Studio closed last",
      "cmd": "action",
      "name": "pelican.layout.resetDefault"
    },
    {
      "label": "step 1: File > New Project...",
      "cmd": "action",
      "name": "pelican.file.newProject"
    },
    {
      "label": "the dialog is on screen",
      "cmd": "wait",
      "name": "pelican.newProjectDialog",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "the folder: this run's own artifacts, never the repository",
      "cmd": "type",
      "name": "pelican.newProject.location",
      "text": "{artifacts}"
    },
    {
      "label": "the name is proposed, with nothing typed",
      "expect": "text_equals",
      "name": "pelican.newProject.name",
      "value": "project_001"
    },
    {
      "label": "the Blank pipeline template",
      "cmd": "select",
      "name": "pelican.newProject.template",
      "text": "Blank pipeline"
    },
    {
      "label": "Create",
      "cmd": "click",
      "name": "pelican.newProject.create"
    },
    {
      "label": "the dialog closed, because the template is on disk",
      "cmd": "wait",
      "name": "pelican.newProjectDialog",
      "missing": true,
      "timeout_ms": 10000
    },
    {
      "label": "the new project's frame plan has its one pass",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node#present",
      "visible": true,
      "timeout_ms": 180000
    },
    {
      "label": "the new engine answers editor RPC and has presented frames",
      "cmd": "wait_engine",
      "timeout_ms": 180000,
      "frames": 30
    },
    {
      "label": "before: present's gradient, read where the box will stand",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/before_gradient.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[0]",
      "remember": "gradient_middle"
    },
    {
      "label": "step 2: Add Object > Cube",
      "cmd": "action",
      "name": "pelican.outliner.addObject.cube"
    },
    {
      "label": "the engine has a third object, named Cube",
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects[2].name",
      "value": "Cube",
      "retry_ms": 60000
    },
    {
      "label": "the Inspector has read the Cube",
      "cmd": "wait",
      "name": "pelican.inspectorModelChoice",
      "text": "Cube (built-in)",
      "timeout_ms": 60000
    },
    {
      "label": "Add Object > Floor",
      "cmd": "action",
      "name": "pelican.outliner.addObject.floor"
    },
    {
      "label": "the engine has a fourth object, named Floor",
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects[3].name",
      "value": "Floor",
      "retry_ms": 60000
    },
    {
      "label": "the Floor is the one selected",
      "cmd": "wait",
      "name": "pelican.inspectorSelection",
      "contains": "Floor\n",
      "timeout_ms": 30000
    },
    {
      "label": "the Inspector has read the Floor: a Plane",
      "cmd": "wait",
      "name": "pelican.inspectorModelChoice",
      "text": "Plane (built-in)",
      "timeout_ms": 60000
    },
    {
      "label": "the floor is under the box, with nothing typed",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.pos.1",
      "contains": "-0.5000",
      "timeout_ms": 30000
    },
    {
      "label": "and wide",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.scale.0",
      "contains": "8.0000",
      "timeout_ms": 30000
    },
    {
      "label": "both ways",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.scale.2",
      "contains": "8.0000",
      "timeout_ms": 30000
    },
    {
      "label": "step 3: Add material pass..., with nothing picked",
      "cmd": "action",
      "name": "pelican.framePlan.addMaterialPass"
    },
    {
      "label": "the Graph tab comes forward with its palette open on the material pass (GL-5c: the root is a graph that selects no preset)",
      "cmd": "wait",
      "name": "pelican.graphCanvasPalette",
      "visible": true,
      "timeout_ms": 60000
    },
    {
      "label": "the palette is on render.material_pass",
      "expect": "text_equals",
      "name": "pelican.graphCanvasPaletteFilter",
      "value": "render.material_pass"
    },
    {
      "label": "the contract combo is offered for it",
      "cmd": "wait",
      "name": "pelican.graphCanvasPaletteContract",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "the contract: forward_opaque_v1",
      "cmd": "select",
      "name": "pelican.graphCanvasPaletteContract",
      "text": "forward_opaque_v1"
    },
    {
      "label": "Enter in the filter is OK",
      "cmd": "key",
      "name": "pelican.graphCanvasPaletteFilter",
      "sequence": "Return"
    },
    {
      "label": "the palette closed",
      "cmd": "wait",
      "name": "pelican.graphCanvasPalette",
      "missing": true,
      "timeout_ms": 10000
    },
    {
      "label": "G-5: the box and the floor are not saved, so Studio asks before the restart",
      "cmd": "wait",
      "name": "pelican.unsavedScenePrompt",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "the question names the restart",
      "expect": "result",
      "command": {
        "cmd": "text",
        "name": "pelican.unsavedScenePrompt"
      },
      "path": "text",
      "op": "contains",
      "value": "engine restarts"
    },
    {
      "label": "Save",
      "cmd": "click",
      "name": "pelican.unsavedScenePrompt.save"
    },
    {
      "label": "the scene is saved, and only then is a new engine started",
      "cmd": "wait",
      "name": "pelican.viewportStatus",
      "contains": "started; waiting for its window",
      "timeout_ms": 120000
    },
    {
      "label": "the restarted engine answers editor RPC and has presented frames",
      "cmd": "wait_engine",
      "timeout_ms": 180000,
      "frames": 30
    },
    {
      "label": "the pass's draw loop is drawn as a zone on the Graph (after a restart, if the route default asks for one)",
      "cmd": "wait",
      "name": "pelican.graphCanvasView::graph_zone#render_material_pass_draws",
      "visible": true,
      "timeout_ms": 180000
    },
    {
      "label": "the engine answers and has presented frames",
      "cmd": "wait_engine",
      "timeout_ms": 180000,
      "frames": 30
    },
    {
      "label": "the material pass is drawn, and picked: its detail column shows its contract",
      "cmd": "wait",
      "name": "pelican.graphCanvasDraw.contract",
      "visible": true,
      "text": "forward_opaque_v1",
      "timeout_ms": 60000
    },
    {
      "label": "the pass is the graph's node (GL-5c), not a managed fragment",
      "expect": "rpc_equals",
      "method": "get_graph_instances",
      "params": {},
      "path": "nodes[3].id",
      "value": "render_material_pass",
      "retry_ms": 60000
    },
    {
      "label": "no pass-<id>.json was made",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "managed_fragments.$len",
      "value": 0
    },
    {
      "label": "the saved scene holds the floor",
      "file": "contains",
      "path": "{artifacts}/project_001/scenes/main.scene.json",
      "text": "engine://primitives/plane",
      "value": true
    },
    {
      "label": "by the name Add Object gave it",
      "file": "contains",
      "path": "{artifacts}/project_001/scenes/main.scene.json",
      "text": "\"Floor\"",
      "value": true
    },
    {
      "label": "the root now routes the project's automatic materials forward",
      "file": "contains",
      "path": "{artifacts}/project_001/passes/main_rendering_config.json",
      "text": "material_route_default",
      "value": true
    },
    {
      "label": "the engine runs the graph's material pass after present, which reads nothing yet",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[1].name",
      "value": "render_material_pass",
      "retry_ms": 120000
    },
    {
      "label": "the restarted engine read the saved scene: the Floor is in it",
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects[3].name",
      "value": "Floor",
      "retry_ms": 60000
    },
    {
      "label": "step 4: the Graph tab; the canvas can edit again",
      "cmd": "wait",
      "name": "pelican.graphCanvasAddNode",
      "enabled": true,
      "timeout_ms": 120000
    },
    {
      "label": "fit the graph so both ends of the drag are on screen",
      "cmd": "action",
      "name": "pelican.graphCanvas.fitView"
    },
    {
      "label": "present offers an empty + input",
      "cmd": "wait",
      "name": "pelican.graphCanvasView::graph_derived_socket#present/in:+",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "present reads the pass's colour: its output dragged onto present's + input (GL-1e), one edit_preset_pass on the root",
      "cmd": "drag",
      "from": {
        "name": "pelican.graphCanvasView::graph_socket#render_material_pass/out:color"
      },
      "to": {
        "name": "pelican.graphCanvasView::graph_derived_socket#present/in:+"
      },
      "steps": 8
    },
    {
      "label": "edit_preset_pass on present committed",
      "cmd": "wait",
      "name": "pelican.graphCanvasNotice",
      "text": "Pass inputs saved.",
      "timeout_ms": 120000
    },
    {
      "label": "the root's present reads the pass's colour image",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[1].root_declaration.input[0]",
      "value": "render_material_pass__color",
      "retry_ms": 120000
    },
    {
      "label": "through the engine's pass-through, which shows input 0: no shader was written for present",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[1].root_declaration.shader.fragment",
      "value": "engine://passthrough"
    },
    {
      "label": "the Frame Plan tab is in front",
      "cmd": "action",
      "name": "pelican.view.renderTools.frame_plan"
    },
    {
      "label": "the Frame Plan draws the read",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node_socket#present/in:render_material_pass__color",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "step 5: pick the camera in the Outliner, so no gizmo is drawn over the shapes",
      "cmd": "select",
      "name": "pelican.outliner",
      "text": "MainCamera"
    },
    {
      "label": "step 5: the Inspector holds the camera",
      "cmd": "wait",
      "name": "pelican.inspectorSelection",
      "contains": "MainCamera\n",
      "timeout_ms": 30000
    },
    {
      "label": "step 5: the viewport holds a shape, not the gradient's thousands of colours",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "distinct_colors",
      "op": "le",
      "value": 64,
      "retry_ms": 120000
    },
    {
      "label": "step 5: the background, read above the box",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[2]",
      "remember": "background"
    },
    {
      "label": "step 5: the floor, read below the box",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[1]",
      "remember": "floor"
    },
    {
      "label": "step 5: the box, read in the middle",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[0]",
      "remember": "box"
    },
    {
      "label": "step 5: the box's middle is not the background",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[0]",
      "op": "ne",
      "value_of": "background"
    },
    {
      "label": "step 5: nor the floor",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[0]",
      "op": "ne",
      "value_of": "floor"
    },
    {
      "label": "step 5: and the floor is not the background",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[1]",
      "op": "ne",
      "value_of": "background"
    },
    {
      "label": "step 5: and the middle is not the gradient's colour there before",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[0]",
      "op": "ne",
      "value_of": "gradient_middle"
    },
    {
      "label": "a picture of the window after step 5",
      "expect": "screenshot",
      "path": "step5_window.png"
    },
    {
      "label": "RV-1b File > Save Scene: keep the forward loop and present input for reopening",
      "cmd": "action",
      "name": "pelican.file.saveScene"
    },
    {
      "label": "RV-1b explicit Save establishes the document baseline",
      "expect": "rpc_equals",
      "method": "get_document_journal",
      "path": "dirty",
      "value": false,
      "retry_ms": 30000
    },
    {
      "label": "step 6: open another project (the untouched fixture copy), so the next open is a real one",
      "cmd": "open_project",
      "dir": "{other_project}"
    },
    {
      "label": "step 6: that engine answers",
      "cmd": "wait_engine",
      "timeout_ms": 180000
    },
    {
      "label": "step 6: open the new project again, which the engine reads from disk",
      "cmd": "open_project",
      "dir": "{artifacts}/project_001"
    },
    {
      "label": "step 6: the re-read engine answers and has presented frames",
      "cmd": "wait_engine",
      "timeout_ms": 180000,
      "frames": 30
    },
    {
      "label": "step 6: the canvas has present again",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node#present",
      "visible": true,
      "timeout_ms": 180000
    },
    {
      "label": "step 6: the graph's material pass is still first",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[0].name",
      "value": "render_material_pass",
      "retry_ms": 120000
    },
    {
      "label": "step 6: and present still reads its colour image",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[1].root_declaration.input[0]",
      "value": "render_material_pass__color",
      "retry_ms": 120000
    },
    {
      "label": "step 6: through the engine's pass-through",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[1].root_declaration.shader.fragment",
      "value": "engine://passthrough",
      "retry_ms": 120000
    },
    {
      "label": "step 6: the canvas draws the material pass writing its colour image",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node_socket#render_material_pass/out:render_material_pass__color",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "step 6: and present reading it",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node_socket#present/in:render_material_pass__color",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "step 6: pick the camera in the Outliner, so no gizmo is drawn over the shapes",
      "cmd": "select",
      "name": "pelican.outliner",
      "text": "MainCamera"
    },
    {
      "label": "step 6: the Inspector holds the camera",
      "cmd": "wait",
      "name": "pelican.inspectorSelection",
      "contains": "MainCamera\n",
      "timeout_ms": 30000
    },
    {
      "label": "step 6: the viewport holds a shape, not the gradient's thousands of colours",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step6_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "distinct_colors",
      "op": "le",
      "value": 64,
      "retry_ms": 120000
    },
    {
      "label": "step 6: the background, read above the box",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step6_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[2]",
      "remember": "reopened_background"
    },
    {
      "label": "step 6: the floor, read below the box",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step6_forward.png",
        "pixels": [
          [
            0.5,
            0.5
