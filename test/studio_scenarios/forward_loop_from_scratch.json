{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "forward_loop_from_scratch",
  "description": "G-5, story A, with T-1's defaults: a forward material loop built from a Blank pipeline with Studio alone. New Project (F-2) takes the folder and proposes the name (project_001); Add Object puts a Cube and a Floor (G-2 / T-1), the Floor already under the box and wide; Add material pass... opens with its outputs filled and adds Forward opaque with the forward default (G-1 / G-4 / T-1). The scene is unsaved at that point, so before the engine restarts Studio asks Save / Discard / Cancel (G-5) and Save keeps the box and the floor. present reads scene_color through a shader New... writes from the Tone map template (F-6 / G-3), and the fragment list offers it. The viewport then shows three colours where there was a gradient: the box, the floor and the background. Another project opened and this one opened again, the engine reads it all from disk and draws the same.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {
      "label": "the fixture's engine is up, so the switch to the new project is something that happens",
      "cmd": "wait_engine",
      "timeout_ms": 180000
    },
    {
      "label": "start from the default layout: the panel layout is the desktop's, saved by whichever Studio closed last",
      "cmd": "action",
      "name": "pelican.layout.resetDefault"
    },
    {
      "label": "step 1: File > New Project...",
      "cmd": "action",
      "name": "pelican.file.newProject"
    },
    {
      "label": "the dialog is on screen",
      "cmd": "wait",
      "name": "pelican.newProjectDialog",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "the folder: this run's own artifacts, never the repository",
      "cmd": "type",
      "name": "pelican.newProject.location",
      "text": "{artifacts}"
    },
    {
      "label": "the name is proposed, with nothing typed",
      "expect": "text_equals",
      "name": "pelican.newProject.name",
      "value": "project_001"
    },
    {
      "label": "the Blank pipeline template",
      "cmd": "select",
      "name": "pelican.newProject.template",
      "text": "Blank pipeline"
    },
    {
      "label": "Create",
      "cmd": "click",
      "name": "pelican.newProject.create"
    },
    {
      "label": "the dialog closed, because the template is on disk",
      "cmd": "wait",
      "name": "pelican.newProjectDialog",
      "missing": true,
      "timeout_ms": 10000
    },
    {
      "label": "the new project's frame plan has its one pass",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node#present",
      "visible": true,
      "timeout_ms": 180000
    },
    {
      "label": "the new engine answers editor RPC and has presented frames",
      "cmd": "wait_engine",
      "timeout_ms": 180000,
      "frames": 30
    },
    {
      "label": "before: present's gradient, read where the box will stand",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/before_gradient.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[0]",
      "remember": "gradient_middle"
    },
    {
      "label": "step 2: Add Object > Cube",
      "cmd": "action",
      "name": "pelican.outliner.addObject.cube"
    },
    {
      "label": "the engine has a third object, named Cube",
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects[2].name",
      "value": "Cube",
      "retry_ms": 60000
    },
    {
      "label": "the Inspector has read the Cube",
      "cmd": "wait",
      "name": "pelican.inspectorModelChoice",
      "text": "Cube (built-in)",
      "timeout_ms": 60000
    },
    {
      "label": "Add Object > Floor",
      "cmd": "action",
      "name": "pelican.outliner.addObject.floor"
    },
    {
      "label": "the engine has a fourth object, named Floor",
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects[3].name",
      "value": "Floor",
      "retry_ms": 60000
    },
    {
      "label": "the Floor is the one selected",
      "cmd": "wait",
      "name": "pelican.inspectorSelection",
      "contains": "Floor\n",
      "timeout_ms": 30000
    },
    {
      "label": "the Inspector has read the Floor: a Plane",
      "cmd": "wait",
      "name": "pelican.inspectorModelChoice",
      "text": "Plane (built-in)",
      "timeout_ms": 60000
    },
    {
      "label": "the floor is under the box, with nothing typed",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.pos.1",
      "contains": "-0.5000",
      "timeout_ms": 30000
    },
    {
      "label": "and wide",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.scale.0",
      "contains": "8.0000",
      "timeout_ms": 30000
    },
    {
      "label": "both ways",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.scale.2",
      "contains": "8.0000",
      "timeout_ms": 30000
    },
    {
      "label": "step 3: Add material pass..., with nothing picked",
      "cmd": "action",
      "name": "pelican.framePlan.addMaterialPass"
    },
    {
      "label": "the form is open",
      "cmd": "wait",
      "name": "pelican.materialPassForm.name",
      "visible": true,
      "timeout_ms": 60000
    },
    {
      "label": "Forward opaque is the contract it opens on",
      "expect": "text_equals",
      "name": "pelican.materialPassForm.contract",
      "value": "Forward opaque"
    },
    {
      "label": "the pass is named after it, with nothing typed",
      "expect": "text_equals",
      "name": "pelican.materialPassForm.name",
      "value": "forward_opaque"
    },
    {
      "label": "the color output is a new scene_color, filled as the form opened",
      "expect": "text_equals",
      "name": "pelican.materialPassForm.target.color",
      "value": "scene_color"
    },
    {
      "label": "the depth output a new scene_depth, likewise",
      "expect": "text_equals",
      "name": "pelican.materialPassForm.target.depth",
      "value": "scene_depth"
    },
    {
      "label": "no pass takes deferred materials, so the form offers to draw them forward",
      "cmd": "wait",
      "name": "pelican.materialPassForm.forwardDefault",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "checked: the form says the engine restarts",
      "expect": "result",
      "command": {
        "cmd": "text",
        "name": "pelican.materialPassForm.notice"
      },
      "path": "text",
      "op": "contains",
      "value": "the engine restarts"
    },
    {
      "label": "Save: the targets, then the pass carrying material_route_default",
      "cmd": "click",
      "name": "pelican.materialPassForm.ok"
    },
    {
      "label": "the form closed",
      "cmd": "wait",
      "name": "pelican.materialPassForm.name",
      "visible": false,
      "timeout_ms": 10000
    },
    {
      "label": "G-5: the box and the floor are not saved, so Studio asks before the restart",
      "cmd": "wait",
      "name": "pelican.unsavedScenePrompt",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "the question names the restart",
      "expect": "result",
      "command": {
        "cmd": "text",
        "name": "pelican.unsavedScenePrompt"
      },
      "path": "text",
      "op": "contains",
      "value": "engine restarts"
    },
    {
      "label": "Save",
      "cmd": "click",
      "name": "pelican.unsavedScenePrompt.save"
    },
    {
      "label": "the scene is saved, and only then is a new engine started",
      "cmd": "wait",
      "name": "pelican.viewportStatus",
      "contains": "started; waiting for its window",
      "timeout_ms": 120000
    },
    {
      "label": "the restarted engine answers editor RPC and has presented frames",
      "cmd": "wait_engine",
      "timeout_ms": 180000,
      "frames": 30
    },
    {
      "label": "the saved scene holds the floor",
      "file": "contains",
      "path": "{artifacts}/project_001/scenes/main.scene.json",
      "text": "engine://primitives/plane",
      "value": true
    },
    {
      "label": "by the name Add Object gave it",
      "file": "contains",
      "path": "{artifacts}/project_001/scenes/main.scene.json",
      "text": "\"Floor\"",
      "value": true
    },
    {
      "label": "the root now routes the project's automatic materials forward",
      "file": "contains",
      "path": "{artifacts}/project_001/passes/main_rendering_config.json",
      "text": "material_route_default",
      "value": true
    },
    {
      "label": "the engine runs forward_opaque first",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[0].name",
      "value": "forward_opaque",
      "retry_ms": 120000
    },
    {
      "label": "the restarted engine read the saved scene: the Floor is in it",
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects[3].name",
      "value": "Floor",
      "retry_ms": 60000
    },
    {
      "label": "step 4: close nothing yet; show the whole graph",
      "cmd": "action",
      "name": "pelican.framePlan.fitView"
    },
    {
      "label": "fit the graph so present can be picked",
      "cmd": "action",
      "name": "pelican.framePlan.fitView"
    },
    {
      "label": "present is drawn",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node#present",
      "visible": true,
      "timeout_ms": 60000
    },
    {
      "label": "open present in the Pass Editor by its heading",
      "cmd": "double_click",
      "name": "pelican.framePlanLogicalView::node_header#present"
    },
    {
      "label": "the Pass Editor holds present",
      "cmd": "wait",
      "name": "pelican.fullscreenPass.name",
      "text": "present",
      "timeout_ms": 60000
    },
    {
      "label": "present reads scene_color",
      "cmd": "select",
      "name": "pelican.fullscreenPass.inputTarget",
      "text": "scene_color"
    },
    {
      "label": "as input 0",
      "cmd": "click",
      "name": "pelican.fullscreenPass.addInput"
    },
    {
      "label": "New... beside the fragment stem",
      "cmd": "click",
      "name": "pelican.fullscreenPass.newFragmentShader"
    },
    {
      "label": "start from Tone map",
      "cmd": "select",
      "name": "pelican.fullscreenPass.shaderTemplateKind",
      "text": "Tone map"
    },
    {
      "label": "present already reads shaders/present.frag, so the new shader gets a name of its own, with nothing typed",
      "expect": "text_equals",
      "name": "pelican.fullscreenPass.shaderTemplateName",
      "value": "present_tone_map"
    },
    {
      "label": "create the shader",
      "cmd": "click",
      "name": "pelican.fullscreenPass.createFragmentShader"
    },
    {
      "label": "the fragment field holds its stem",
      "expect": "text_equals",
      "name": "pelican.fullscreenPass.shader.fragment",
      "value": "project://shaders/present_tone_map"
    },
    {
      "label": "T-1: the fragment list offers it: picking it puts the same stem in the field",
      "cmd": "select",
      "name": "pelican.fullscreenPass.shader.fragmentChoice",
      "text": "project://shaders/present_tone_map"
    },
    {
      "label": "the field holds the picked stem",
      "expect": "text_equals",
      "name": "pelican.fullscreenPass.shader.fragment",
      "value": "project://shaders/present_tone_map"
    },
    {
      "label": "the shader reads scene_color as the scene colour",
      "file": "contains",
      "path": "{artifacts}/project_001/shaders/present_tone_map.frag",
      "text": "PELICAN_DECLARE_INPUT_0(in_scene_color);  // scene_color: scene colour",
      "value": true
    },
    {
      "label": "the gradient present had is still on disk: New... does not overwrite",
      "file": "contains",
      "path": "{artifacts}/project_001/shaders/present.frag",
      "text": "outColor = vec4(inUV.x, inUV.y, 0.5, 1.0);",
      "value": true
    },
    {
      "label": "Save is ready",
      "cmd": "wait",
      "name": "pelican.fullscreenPass.save",
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "save present: edit_preset_pass on the root",
      "cmd": "click",
      "name": "pelican.fullscreenPass.save"
    },
    {
      "label": "the root's present reads scene_color",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[1].root_declaration.input[0]",
      "value": "scene_color",
      "retry_ms": 120000
    },
    {
      "label": "close the Pass Editor (View > Panels) to look at the viewport",
      "cmd": "action",
      "name": "pelican.view.panels.fullscreenPassDock"
    },
    {
      "label": "the canvas draws the read",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node_socket#present/in:scene_color",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "step 5: pick the camera in the Outliner, so no gizmo is drawn over the shapes",
      "cmd": "select",
      "name": "pelican.outliner",
      "text": "MainCamera"
    },
    {
      "label": "step 5: the Inspector holds the camera",
      "cmd": "wait",
      "name": "pelican.inspectorSelection",
      "contains": "MainCamera\n",
      "timeout_ms": 30000
    },
    {
      "label": "step 5: the viewport holds a shape, not the gradient's thousands of colours",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "distinct_colors",
      "op": "le",
      "value": 64,
      "retry_ms": 120000
    },
    {
      "label": "step 5: the background, read above the box",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[2]",
      "remember": "background"
    },
    {
      "label": "step 5: the floor, read below the box",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[1]",
      "remember": "floor"
    },
    {
      "label": "step 5: the box, read in the middle",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[0]",
      "remember": "box"
    },
    {
      "label": "step 5: the box's middle is not the background",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[0]",
      "op": "ne",
      "value_of": "background"
    },
    {
      "label": "step 5: nor the floor",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[0]",
      "op": "ne",
      "value_of": "floor"
    },
    {
      "label": "step 5: and the floor is not the background",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[1]",
      "op": "ne",
      "value_of": "background"
    },
    {
      "label": "step 5: and the middle is not the gradient's colour there before",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[0]",
      "op": "ne",
      "value_of": "gradient_middle"
    },
    {
      "label": "a picture of the window after step 5",
      "expect": "screenshot",
      "path": "step5_window.png"
    },
    {
      "label": "step 6: open another project (the untouched fixture copy), so the next open is a real one",
      "cmd": "open_project",
      "dir": "{other_project}"
    },
    {
      "label": "step 6: that engine answers",
      "cmd": "wait_engine",
      "timeout_ms": 180000
    },
    {
      "label": "step 6: open the new project again, which the engine reads from disk",
      "cmd": "open_project",
      "dir": "{artifacts}/project_001"
    },
    {
      "label": "step 6: the re-read engine answers and has presented frames",
      "cmd": "wait_engine",
      "timeout_ms": 180000,
      "frames": 30
    },
    {
      "label": "step 6: the canvas has present again",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node#present",
      "visible": true,
      "timeout_ms": 180000
    },
    {
      "label": "step 6: forward_opaque is still first",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[0].name",
      "value": "forward_opaque",
      "retry_ms": 120000
    },
    {
      "label": "step 6: and present still reads scene_color",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[1].root_declaration.input[0]",
      "value": "scene_color",
      "retry_ms": 120000
    },
    {
      "label": "step 6: through the tone map shader",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[1].root_declaration.shader.fragment",
      "value": "project://shaders/present_tone_map",
      "retry_ms": 120000
    },
    {
      "label": "step 6: the canvas draws forward_opaque writing scene_color",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node_socket#forward_opaque/out:scene_color",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "step 6: and present reading it",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node_socket#present/in:scene_color",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "step 6: pick the camera in the Outliner, so no gizmo is drawn over the shapes",
      "cmd": "select",
      "name": "pelican.outliner",
      "text": "MainCamera"
    },
    {
      "label": "step 6: the Inspector holds the camera",
      "cmd": "wait",
      "name": "pelican.inspectorSelection",
      "contains": "MainCamera\n",
      "timeout_ms": 30000
    },
    {
      "label": "step 6: the viewport holds a shape, not the gradient's thousands of colours",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step6_forward.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "distinct_colors",
      "op": "le",
      "value": 64,
      "retry_ms": 120000
    },
    {
      "label": "step 6: the background, read above the box",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step6_forward.png",
