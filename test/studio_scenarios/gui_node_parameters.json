      "command": {
        "cmd": "rpc",
        "method": "get_graph_instances",
        "params": {}
      },
      "path": "result.nodes[0].parameters",
      "op": "excludes",
      "value": "lifetime",
      "retry_ms": 60000
    },
    {
      "label": "saved",
      "cmd": "wait",
      "name": "pelican.graphCanvasNotice",
      "timeout_ms": 120000,
      "text": "Graph change saved."
    },
    {
      "label": "the canvas takes edits",
      "cmd": "wait",
      "name": "pelican.graphCanvasAddNode",
      "timeout_ms": 120000,
      "enabled": true
    },
    {
      "label": "the field shows the default again",
      "cmd": "wait",
      "name": "pelican.graphCanvasParameters.lifetime",
      "timeout_ms": 30000,
      "contains": "persistent"
    },
    {
      "label": "size: -4 typed, below the table's 0",
      "cmd": "type",
      "name": "pelican.graphCanvasParameters.size",
      "text": "-4"
    },
    {
      "label": "Return gives it",
      "cmd": "key",
      "name": "pelican.graphCanvasParameters.size",
      "sequence": "Return"
    },
    {
      "label": "decision 4: refused in one sentence",
      "cmd": "wait",
      "name": "pelican.graphCanvasNotice",
      "timeout_ms": 120000,
      "contains": "render_buffer.size must be integer (range: at least 0)"
    },
    {
      "label": "decision 4: and the size row says it, red",
      "cmd": "wait",
      "name": "pelican.graphCanvasParameters.size.problem",
      "timeout_ms": 30000,
      "visible": true,
      "contains": "render_buffer.size must be integer"
    },
    {
      "label": "the document keeps 64",
      "expect": "rpc_equals",
      "method": "get_graph_instances",
      "params": {},
      "path": "nodes[0].parameters.size",
      "value": 64,
      "retry_ms": 60000
    },
    {
      "label": "size: 128 typed",
      "cmd": "type",
      "name": "pelican.graphCanvasParameters.size",
      "text": "128"
    },
    {
      "label": "Return gives it",
      "cmd": "key",
      "name": "pelican.graphCanvasParameters.size",
      "sequence": "Return"
    },
    {
      "label": "taken: 128",
      "expect": "rpc_equals",
      "method": "get_graph_instances",
      "params": {},
      "path": "nodes[0].parameters.size",
      "value": 128,
      "retry_ms": 60000
    },
    {
      "label": "saved",
      "cmd": "wait",
      "name": "pelican.graphCanvasNotice",
      "timeout_ms": 120000,
      "text": "Graph change saved."
    },
    {
      "label": "the row is not red any more",
      "cmd": "wait",
      "name": "pelican.graphCanvasParameters.size.problem",
      "timeout_ms": 30000,
      "visible": false
    },
    {
      "label": "the canvas takes edits",
      "cmd": "wait",
