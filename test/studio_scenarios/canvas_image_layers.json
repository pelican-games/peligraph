{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "canvas_image_layers",
  "description": "SG-2: picture layers and a PSD's conversion on a 2D canvas, from File > New Project > Blank with the Layers dock only. With no canvas in the document the dock offers + Canvas alone, which places a canvas.output and its 1280 x 720 stack in one edit and puts the output's image on present's inputs (the edit_preset_pass the drag onto present's + input sends). + Image copies a picture (the PSD fixture's 64 x 32 composite, opaque) into assets/canvas and makes it a canvas.image layer of its pixels at the canvas's middle; + Rect puts a rectangle on top, wider than the picture; the rectangle's clip mark clips it to the picture, after which the viewport beside the picture shows the empty canvas again while its middle keeps the rectangle's colour. Import PSD output reads the repository's psd-canvas fixture (canvas.graph.json, layers/, masks/): the files are copied into imports/psd_fixture, the definition is added, and its instance is the top layer, named PSD: fixture, drawn at the canvas's top left; the dot, the card and the squares of the fixture's reference show there. Open group shows the PSD's own layers, read only. Typed: the project folder and name, and the two file names in Qt's file dialogs (as the sound import's scenario does).",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "timeout_ms": 10000, "visible": true},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "canvas_images"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "timeout_ms": 10000, "missing": true},
    {"label": "the blank project's present is on the Frame Plan canvas", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "timeout_ms": 180000, "visible": true},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the Graph tab is in front (its notice says what each edit did)", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the canvas can edit the new document", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "the Layers dock is on screen", "cmd": "wait", "name": "pelican.layersDock", "timeout_ms": 10000, "visible": true},
    {"label": "no canvas yet: + Canvas alone", "cmd": "wait", "name": "pelican.canvasLayers.addCanvas", "timeout_ms": 60000, "visible": true, "enabled": true},
    {"label": "and no layer buttons", "cmd": "wait", "name": "pelican.canvasLayers.addImage", "timeout_ms": 10000, "visible": false},
    {"label": "the empty viewport: remember it", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.57, 0.5]]}, "path": "pixels[1]", "remember": "blank_side"},
    {"label": "+ Canvas", "cmd": "click", "name": "pelican.canvasLayers.addCanvas"},
    {"label": "the canvas is placed", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].op", "value": "canvas.output", "retry_ms": 120000},
    {"label": "a 1280 x 720 stack with no layer", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters", "value": {"size": [1280, 720], "layers": []}},
    {"label": "and put on present's inputs", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Pass inputs saved."},
    {"label": "the dock shows its stack", "cmd": "wait", "name": "pelican.canvasLayers.title", "timeout_ms": 60000, "visible": true, "contains": "canvas_stack"},
    {"label": "no layer yet", "cmd": "wait", "name": "pelican.canvasLayers.empty", "timeout_ms": 30000, "visible": true},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the empty canvas: remember the middle", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.57, 0.5]]}, "path": "pixels[0]", "remember": "empty"},
    {"label": "and beside it", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.57, 0.5]]}, "path": "pixels[1]", "remember": "empty_side"},
    {"label": "the dock takes edits", "cmd": "wait", "name": "pelican.canvasLayers.addImage", "timeout_ms": 120000, "visible": true, "enabled": true},
    {"label": "+ Image...", "cmd": "click", "name": "pelican.canvasLayers.addImage"},
    {"label": "the picture dialog", "cmd": "wait", "name": "pelican.canvasImageDialog", "timeout_ms": 20000, "visible": true},
    {"label": "the picture: the PSD fixture's composite", "cmd": "type", "name": "pelican.canvasImageDialog.fileName", "text": "{fixtures}/canvas_psd/reference.png"},
    {"label": "Return opens it", "cmd": "key", "name": "pelican.canvasImageDialog.fileName", "sequence": "Return"},
    {"label": "the dialog's loop ends", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "zz-never-shown", "timeout_ms": 400, "expect_error": "automation.wait_timeout@1"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.canvasImageDialog", "timeout_ms": 20000, "missing": true},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "a canvas.image of the copy", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[2].parameters.asset", "value": "project://assets/canvas/reference.png", "retry_ms": 60000},
    {"label": "at its pixels, in the middle of the canvas", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[2].parameters", "value": {"asset": "project://assets/canvas/reference.png", "offset": [608, 344], "size": [64, 32]}},
    {"label": "the copy is in the project", "file": "exists", "path": "{artifacts}/canvas_images/assets/canvas/reference.png", "value": true},
    {"label": "its row, named after the file", "cmd": "wait", "name": "pelican.canvasLayers.row0.name", "timeout_ms": 60000, "visible": true, "text": "reference"},
    {"label": "an image row", "cmd": "wait", "name": "pelican.canvasLayers.row0.pick", "timeout_ms": 10000, "text": "Image"},
    {"label": "its fields: offset and size", "cmd": "wait", "name": "pelican.canvasLayers.field.imageSize.x", "timeout_ms": 30000, "visible": true},
    {"label": "nothing below it to clip to", "cmd": "wait", "name": "pelican.canvasLayers.row0.clip", "timeout_ms": 10000, "enabled": false},
    {"label": "the picture covers the middle", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.57, 0.5]]}, "path": "pixels[0]", "op": "ne", "value_of": "empty", "retry_ms": 60000},
    {"label": "and not beside it", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.57, 0.5]]}, "path": "pixels[1]", "value_of": "empty_side"},
    {"label": "remember the picture in the middle", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.57, 0.5]]}, "path": "pixels[0]", "remember": "picture"},
    {"label": "the dock takes edits", "cmd": "wait", "name": "pelican.canvasLayers.addRect", "timeout_ms": 120000, "enabled": true},
    {"label": "+ Rect on top", "cmd": "click", "name": "pelican.canvasLayers.addRect"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the rectangle is the top layer", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers[1].input", "value": "rect_1", "retry_ms": 60000},
    {"label": "the top row is the rectangle", "cmd": "wait", "name": "pelican.canvasLayers.row0.name", "timeout_ms": 60000, "visible": true, "text": "Rect 1"},
    {"label": "the rectangle reaches beside the picture", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.57, 0.5]]}, "path": "pixels[1]", "op": "ne", "value_of": "empty_side", "retry_ms": 60000},
    {"label": "remember its colour in the middle", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.57, 0.5]]}, "path": "pixels[0]", "remember": "rect"},
    {"label": "the clip mark can be pressed: the picture is below", "cmd": "wait", "name": "pelican.canvasLayers.row0.clip", "timeout_ms": 120000, "visible": true, "enabled": true},
    {"label": "clip the rectangle to the picture", "cmd": "click", "name": "pelican.canvasLayers.row0.clip"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the layer is a clip layer", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers[1]", "value": {"input": "rect_1", "name": "Rect 1", "clip": true}, "retry_ms": 60000},
    {"label": "outside the picture's alpha the rectangle is gone", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.57, 0.5]]}, "path": "pixels[1]", "value_of": "empty_side", "retry_ms": 60000},
    {"label": "inside it the rectangle is still drawn, not the picture", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.57, 0.5]]}, "path": "pixels[0]", "op": "ne", "value_of": "picture", "retry_ms": 60000},
    {"label": "remember the clipped rectangle", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.57, 0.5]]}, "path": "pixels[0]", "remember": "clipped"},
    {"label": "before the import: the top left, where the PSD will be", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.0039, 0.0608], [0.039, 0.0818], [0.0039, 0.0892]]}, "path": "pixels[0]", "remember": "corner_dot"},
    {"label": "the dock takes edits", "cmd": "wait", "name": "pelican.canvasLayers.importPsdOutput", "timeout_ms": 120000, "visible": true, "enabled": true},
    {"label": "Import PSD output...", "cmd": "click", "name": "pelican.canvasLayers.importPsdOutput"},
    {"label": "the dialog", "cmd": "wait", "name": "pelican.canvasPsdOutputDialog", "timeout_ms": 20000, "visible": true},
    {"label": "the conversion: the repository's psd-canvas fixture", "cmd": "type", "name": "pelican.canvasPsdOutputDialog.fileName", "text": "{fixtures}/canvas_psd/canvas.graph.json"},
    {"label": "Return opens it", "cmd": "key", "name": "pelican.canvasPsdOutputDialog.fileName", "sequence": "Return"},
    {"label": "the dialog's loop ends", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "zz-never-shown", "timeout_ms": 400, "expect_error": "automation.wait_timeout@1"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.canvasPsdOutputDialog", "timeout_ms": 20000, "missing": true},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the files are in the project", "file": "exists", "path": "{artifacts}/canvas_images/imports/psd_fixture/layers/0002_Card.png", "value": true},
    {"label": "and the conversion", "file": "exists", "path": "{artifacts}/canvas_images/imports/psd_fixture/canvas.graph.json", "value": true},
    {"label": "its instance is the top layer", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers[2]", "value": {"input": "psd_fixture", "name": "PSD: fixture"}, "retry_ms": 60000},
    {"label": "the import says what it brought", "cmd": "wait", "name": "pelican.canvasLayers.imports", "timeout_ms": 30000, "visible": true, "contains": "imported"},
    {"label": "the top row is the PSD", "cmd": "wait", "name": "pelican.canvasLayers.row0.name", "timeout_ms": 60000, "visible": true, "text": "PSD: fixture"},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the PSD's dot is drawn at the top left", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.0039, 0.0608], [0.039, 0.0818], [0.0039, 0.0892]]}, "path": "pixels[0]", "op": "ne", "value_of": "corner_dot", "retry_ms": 60000},
    {"label": "remember the dot", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.0039, 0.0608], [0.039, 0.0818], [0.0039, 0.0892]]}, "path": "pixels[0]", "remember": "dot"},
    {"label": "the squares are another colour", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.0039, 0.0608], [0.039, 0.0818], [0.0039, 0.0892]]}, "path": "pixels[1]", "op": "ne", "value_of": "dot"},
    {"label": "and so is the background under the card", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.0039, 0.0608], [0.039, 0.0818], [0.0039, 0.0892]]}, "path": "pixels[2]", "op": "ne", "value_of": "dot"},
    {"label": "the middle is the clipped rectangle still", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.57, 0.5]]}, "path": "pixels[0]", "value_of": "clipped"},
    {"label": "pick the PSD's row", "cmd": "click", "name": "pelican.canvasLayers.row0.pick"},
    {"label": "Open group", "cmd": "wait", "name": "pelican.canvasLayers.openGroup", "timeout_ms": 30000, "visible": true},
    {"label": "open it", "cmd": "click", "name": "pelican.canvasLayers.openGroup"},
    {"label": "its own layers, read only", "cmd": "wait", "name": "pelican.canvasLayers.title", "timeout_ms": 30000, "contains": "read only"},
    {"label": "the PSD's top layer is its dot", "cmd": "wait", "name": "pelican.canvasLayers.row0.name", "timeout_ms": 30000, "text": "Dot"},
    {"label": "an edit there", "cmd": "click", "name": "pelican.canvasLayers.row0.visible"},
    {"label": "says it is read only", "cmd": "wait", "name": "pelican.canvasLayers.note", "timeout_ms": 30000, "visible": true, "contains": "read only"},
    {"label": "the document's own definition is untouched", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers[2].name", "value": "PSD: fixture"},
    {"label": "Back", "cmd": "click", "name": "pelican.canvasLayers.back"},
    {"label": "the canvas again", "cmd": "wait", "name": "pelican.canvasLayers.title", "timeout_ms": 30000, "contains": "canvas_stack"},
    {"label": "a picture of the window", "expect": "screenshot", "path": "canvas_image_layers_window.png"}
  ]
}
