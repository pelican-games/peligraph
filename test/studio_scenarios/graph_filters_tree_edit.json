{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "graph_filters_tree_edit",
  "description": "GF-1e: add a child in the dialog and save, see it in the closed Filter menu and use it, move it out and back in with Save each time while it stays active and selected, then remove the parent with its child after two presses, which returns the Graph to All. The engine instance never changes.",
  "tab": "graph",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "the default layout", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "the Graph tab", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "no file still means Filter All", "cmd": "wait", "name": "pelican.graphCanvasFilter", "text": "Filter: All", "visible": true, "timeout_ms": 30000},
    {"label": "turn on Value before looking for value nodes", "cmd": "click", "name": "pelican.graphCanvasShow.value"},
    {"label": "clock is drawn before filtering", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#clock", "visible": true, "timeout_ms": 30000},
    {"label": "the engine before any filter save", "expect": "result", "command": {"cmd": "rpc", "method": "get_status", "params": {}}, "path": "result.instance_id", "remember": "engine_before"},

    {"label": "Edit filters opens from the real menu action", "cmd": "action", "name": "pelican.graphCanvasFilter.edit"},
    {"label": "the dialog is visible", "cmd": "wait", "name": "pelican.graphFiltersDialog", "visible": true, "timeout_ms": 30000},
    {"label": "the initial load has finished", "cmd": "wait", "name": "pelican.graphFiltersDialog.addFilter", "enabled": true, "timeout_ms": 30000},
    {"label": "add a top-level filter", "cmd": "click", "name": "pelican.graphFiltersDialog.addFilter"},
    {"label": "it's selected", "cmd": "wait", "name": "pelican.graphFiltersDialog.id", "text": "filter", "timeout_ms": 30000},
    {"label": "label the parent", "cmd": "type", "name": "pelican.graphFiltersDialog.label", "text": "Tree parent"},

    {"label": "add a child to it", "cmd": "click", "name": "pelican.graphFiltersDialog.addChild"},
    {"label": "the child's row is on screen, under an open parent", "cmd": "wait", "name": "pelican.graphFiltersDialog.filters::row#Filter", "visible": true, "timeout_ms": 30000},
    {"label": "the child is the selected filter", "cmd": "wait", "name": "pelican.graphFiltersDialog.id", "text": "filter_2", "timeout_ms": 30000},
    {"label": "label the child", "cmd": "type", "name": "pelican.graphFiltersDialog.label", "text": "Tree child"},
    {"label": "the child's own row follows the label", "cmd": "wait", "name": "pelican.graphFiltersDialog.filters::row#Tree child", "visible": true, "timeout_ms": 30000},
    {"label": "enter its node id", "cmd": "type", "name": "pelican.graphFiltersDialog.nodeIds.edit", "text": "left"},
    {"label": "add the node id", "cmd": "click", "name": "pelican.graphFiltersDialog.nodeIds.add"},
    {"label": "the preview sees left", "cmd": "wait", "name": "pelican.graphFiltersDialog.preview", "contains": "left", "timeout_ms": 30000},

    {"label": "save the tree", "cmd": "click", "name": "pelican.graphFiltersDialog.save"},
    {"label": "the engine accepted it", "cmd": "wait", "name": "pelican.graphFiltersDialog.state", "text": "Saved", "timeout_ms": 30000},
    {"label": "the file has the nesting", "file": "contains", "path": "{project}/graph_filters.json", "text": "\"children\"", "value": true},
    {"label": "the file has the child's id", "file": "contains", "path": "{project}/graph_filters.json", "text": "\"id\": \"filter_2\"", "value": true},
    {"label": "a picture of the tree", "expect": "screenshot", "name": "pelican.graphFiltersDialog", "path": "graph_filters_tree_dialog.png"},
    {"label": "saving did not restart the engine", "expect": "result", "command": {"cmd": "rpc", "method": "get_status", "params": {}}, "path": "result.instance_id", "value_of": "engine_before"},
    {"label": "close the dialog", "cmd": "click", "name": "pelican.graphFiltersDialog.close"},

    {"label": "the closed Filter menu lists the child", "expect": "result", "command": {"cmd": "menu_list", "pattern": "pelican.graphCanvasFilter.filter.filter_2"}, "path": "count", "value": 1, "retry_ms": 30000},
    {"label": "the parent became a submenu with its All row", "expect": "result", "command": {"cmd": "menu_list", "pattern": "All Tree parent"}, "path": "count", "value": 1, "retry_ms": 30000},
    {"label": "the child sits inside that submenu", "expect": "result", "command": {"cmd": "menu_list", "pattern": "pelican.graphCanvasFilter.filter.filter_2"}, "path": "actions[0].menu", "op": "contains", "value": "Tree parent"},
    {"label": "choose the child by its action", "cmd": "action", "name": "pelican.graphCanvasFilter.filter.filter_2"},
    {"label": "the button names it", "cmd": "wait", "name": "pelican.graphCanvasFilter", "text": "Filter: Tree child", "timeout_ms": 30000},
    {"label": "clock was seen and is now gone", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#clock", "missing": true, "timeout_ms": 30000},

    {"label": "reopen the dialog", "cmd": "action", "name": "pelican.graphCanvasFilter.edit"},
    {"label": "the child is still the selected filter", "cmd": "wait", "name": "pelican.graphFiltersDialog.id", "text": "filter_2", "visible": true, "timeout_ms": 30000},
    {"label": "Move out", "cmd": "click", "name": "pelican.graphFiltersDialog.moveOut"},
    {"label": "the moved filter stays selected", "cmd": "wait", "name": "pelican.graphFiltersDialog.id", "text": "filter_2", "timeout_ms": 30000},
    {"label": "the move is a draft", "cmd": "wait", "name": "pelican.graphFiltersDialog.state", "text": "Unsaved changes", "timeout_ms": 30000},
    {"label": "save the move out", "cmd": "click", "name": "pelican.graphFiltersDialog.save"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphFiltersDialog.state", "text": "Saved", "timeout_ms": 30000},
    {"label": "the file has no nesting", "file": "contains", "path": "{project}/graph_filters.json", "text": "\"children\"", "value": false},
    {"label": "the parent is no longer a submenu", "expect": "result", "command": {"cmd": "menu_list", "pattern": "All Tree parent"}, "path": "count", "value": 0, "retry_ms": 30000},
    {"label": "the child is outside any submenu", "expect": "result", "command": {"cmd": "menu_list", "pattern": "pelican.graphCanvasFilter.filter.filter_2"}, "path": "actions[0].menu", "op": "excludes", "value": "Tree parent"},
    {"label": "the moved filter is still active", "cmd": "wait", "name": "pelican.graphCanvasFilter", "text": "Filter: Tree child", "timeout_ms": 30000},
    {"label": "and still filters", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#clock", "missing": true, "timeout_ms": 30000},
    {"label": "it's still selected after the save", "cmd": "wait", "name": "pelican.graphFiltersDialog.id", "text": "filter_2", "timeout_ms": 30000},

    {"label": "Move in", "cmd": "click", "name": "pelican.graphFiltersDialog.moveIn"},
    {"label": "the moved filter stays selected again", "cmd": "wait", "name": "pelican.graphFiltersDialog.id", "text": "filter_2", "timeout_ms": 30000},
    {"label": "save the move in", "cmd": "click", "name": "pelican.graphFiltersDialog.save"},
    {"label": "saved again", "cmd": "wait", "name": "pelican.graphFiltersDialog.state", "text": "Saved", "timeout_ms": 30000},
    {"label": "the file is nested again", "file": "contains", "path": "{project}/graph_filters.json", "text": "\"children\"", "value": true},
    {"label": "the submenu is back", "expect": "result", "command": {"cmd": "menu_list", "pattern": "All Tree parent"}, "path": "count", "value": 1, "retry_ms": 30000},
    {"label": "the child is inside it again", "expect": "result", "command": {"cmd": "menu_list", "pattern": "pelican.graphCanvasFilter.filter.filter_2"}, "path": "actions[0].menu", "op": "contains", "value": "Tree parent"},
    {"label": "still active", "cmd": "wait", "name": "pelican.graphCanvasFilter", "text": "Filter: Tree child", "timeout_ms": 30000},
    {"label": "still filtering", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#clock", "missing": true, "timeout_ms": 30000},
    {"label": "two saves, the same engine", "expect": "result", "command": {"cmd": "rpc", "method": "get_status", "params": {}}, "path": "result.instance_id", "value_of": "engine_before"},
    {"label": "close before reopening", "cmd": "click", "name": "pelican.graphFiltersDialog.close"},

    {"label": "reopen once more", "cmd": "action", "name": "pelican.graphCanvasFilter.edit"},
    {"label": "the same filter is selected after reopening", "cmd": "wait", "name": "pelican.graphFiltersDialog.id", "text": "filter_2", "visible": true, "timeout_ms": 30000},
    {"label": "select the parent's row", "cmd": "select", "name": "pelican.graphFiltersDialog.filters", "text": "Tree parent"},
    {"label": "the parent is selected", "cmd": "wait", "name": "pelican.graphFiltersDialog.id", "text": "filter", "timeout_ms": 30000},
    {"label": "the first press of Remove", "cmd": "click", "name": "pelican.graphFiltersDialog.removeFilter"},
    {"label": "it names what is lost", "cmd": "wait", "name": "pelican.graphFiltersDialog.state", "contains": "and 1 more", "timeout_ms": 30000},
    {"label": "the button says it's armed", "cmd": "wait", "name": "pelican.graphFiltersDialog.removeFilter", "text": "Confirm remove", "timeout_ms": 30000},
    {"label": "the row is still there", "cmd": "wait", "name": "pelican.graphFiltersDialog.filters::row#Tree child", "visible": true, "timeout_ms": 30000},
    {"label": "the second press", "cmd": "click", "name": "pelican.graphFiltersDialog.removeFilter"},
    {"label": "removed from the draft", "cmd": "wait", "name": "pelican.graphFiltersDialog.state", "text": "Unsaved changes", "timeout_ms": 30000},
    {"label": "save the removal", "cmd": "click", "name": "pelican.graphFiltersDialog.save"},
    {"label": "the removal is saved", "cmd": "wait", "name": "pelican.graphFiltersDialog.state", "text": "Saved", "timeout_ms": 30000},
    {"label": "close it", "cmd": "click", "name": "pelican.graphFiltersDialog.close"},

    {"label": "the menu has lost the child", "expect": "result", "command": {"cmd": "menu_list", "pattern": "pelican.graphCanvasFilter.filter.filter_2"}, "path": "count", "value": 0, "retry_ms": 30000},
    {"label": "a removed active filter returns to All", "cmd": "wait", "name": "pelican.graphCanvasFilter", "text": "Filter: All", "timeout_ms": 30000},
    {"label": "clock is drawn again", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#clock", "visible": true, "timeout_ms": 30000},
    {"label": "the file holds no filters", "file": "contains", "path": "{project}/graph_filters.json", "text": "\"filters\": []", "value": true},
    {"label": "the engine never restarted", "expect": "result", "command": {"cmd": "rpc", "method": "get_status", "params": {}}, "path": "result.instance_id", "value_of": "engine_before"}
  ],
  "invariants": {
    "undo": false,
    "reason": "the filter dialog's Undo leaves a valid file by design, and it isn't on the Graph's history"
  }
}
