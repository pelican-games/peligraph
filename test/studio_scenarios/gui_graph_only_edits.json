{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "gui_graph_only_edits",
  "description": "GL-5d, from File > New Project > Blank with Studio's GUI only, and the Frame Plan's tab never brought forward: what only the Frame Plan offered is on the Graph. (a) A forward material pass from the palette and the Graph's Add fullscreen pass. (b) The material pass's colour dropped on the fullscreen pass's + input (its shader, engine://passthrough, takes one input more) and that pass on present's + input; Fix sockets in the pass's detail column is the Frame Plan's, which copies engine://passthrough into shaders/render_fullscreen.frag with one fixed declaration, and the Graph moves the node onto the copy: the document names it, the band is gone, the picture is the same. (c) A render.target_ref placed with New render target…; Edit target… opens the Frame Plan's form on it and the format is changed to R8G8B8A8_UNORM; a second one is made and Delete target takes the reference and the declaration away. Each step reads the document and the picture. Order… (d) is gui_graph_order, on the fixture: Blank's rendering section has one pass. Typed: the project folder and name in New Project.",
  "tab": "graph",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up, so the switch to the new project is something that happens", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "start from the default layout", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "the Graph tab is in front (the Frame Plan's is never brought forward in this run)", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "visible": true, "timeout_ms": 10000},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "graph_only"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "missing": true, "timeout_ms": 10000},
    {"label": "the blank project's present is on the Graph canvas", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#present", "visible": true, "timeout_ms": 180000},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "Add Object > Cube, something for the pass to draw", "cmd": "action", "name": "pelican.outliner.addObject.cube"},
    {"label": "the engine has a third object, named Cube", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[2].name", "value": "Cube", "retry_ms": 60000},
    {"label": "the Inspector has read the Cube before Save (Save waits for an idle editor session)", "cmd": "wait", "name": "pelican.inspectorModelChoice", "text": "Cube (built-in)", "timeout_ms": 60000},
    {"label": "File > Save Scene, so the restart the material pass asks for has nothing to ask", "cmd": "action", "name": "pelican.file.saveScene"},
    {"label": "the save is done", "cmd": "wait", "name": "pelican.inspectorNotice", "contains": "Scene saved", "timeout_ms": 60000},
    {"label": "pick the camera in the Outliner, so no gizmo is drawn over the box", "cmd": "select", "name": "pelican.outliner", "text": "MainCamera"},
    {"label": "the Inspector holds the camera", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "MainCamera\n", "timeout_ms": 30000},
    {"label": "the Graph tab is in front", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the canvas has read the new document and can edit it", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "the picture before: present reads nothing and passthrough draws its gradient", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/gui_graph_only_edits_before.png", "pixels": [[0.5, 0.5]]}, "path": "pixels[0]", "remember": "gradient"},

    {"label": "(a) Add: the palette opens", "cmd": "click", "name": "pelican.graphCanvasAddNode"},
    {"label": "the palette is on screen", "cmd": "wait", "name": "pelican.graphCanvasPalette", "visible": true, "timeout_ms": 10000},
    {"label": "the filter narrows the list to the material pass", "cmd": "type", "name": "pelican.graphCanvasPaletteFilter", "text": "material_pass"},
    {"label": "the contract combo is offered for it", "cmd": "wait", "name": "pelican.graphCanvasPaletteContract", "visible": true, "timeout_ms": 10000},
    {"label": "a forward pass (Studio sends the route default; the engine restarts)", "cmd": "select", "name": "pelican.graphCanvasPaletteContract", "text": "forward_opaque_v1"},
    {"label": "Enter in the filter is OK", "cmd": "key", "name": "pelican.graphCanvasPaletteFilter", "sequence": "Return"},
    {"label": "the palette closed", "cmd": "wait", "name": "pelican.graphCanvasPalette", "missing": true, "timeout_ms": 10000},
    {"label": "the pass's draw loop is drawn as a zone (after the engine restarts)", "cmd": "wait", "name": "pelican.graphCanvasView::graph_zone#render_material_pass_draws", "visible": true, "timeout_ms": 180000},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the material pass is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_material_pass", "visible": true, "timeout_ms": 60000},
    {"label": "the document: a render.material_pass among the graph's nodes", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[3].op", "value": "render.material_pass", "retry_ms": 60000},
    {"label": "the canvas can edit again", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "fit the graph", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "the Graph's Add fullscreen pass, in the root", "cmd": "action", "name": "pelican.graphCanvas.addFullscreenPass"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "the document: the fullscreen pass after its image", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[5].id", "value": "render_fullscreen", "retry_ms": 60000},
    {"label": "drawing with engine://passthrough", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[5].parameters.shader.fragment", "value": "engine://passthrough"},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the picture: present still reads nothing, the gradient", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/gui_graph_only_edits_a.png", "pixels": [[0.5, 0.5]]}, "path": "pixels[0]", "op": "eq", "value_of": "gradient", "retry_ms": 60000},

    {"label": "(b) auto layout", "cmd": "action", "name": "pelican.graphCanvas.autoLayout"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "the material pass's colour onto the fullscreen pass's + input: one input more for its shader", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#render_material_pass/out:color"}, "to": {"name": "pelican.graphCanvasView::graph_socket#render_fullscreen/in:variadic"}, "steps": 8},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "the document: the fullscreen pass reads the material pass's colour", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[5].inputs.color_2.node", "value": "render_material_pass", "retry_ms": 60000},
    {"label": "the canvas can edit again", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "present offers an empty + input", "cmd": "wait", "name": "pelican.graphCanvasView::graph_derived_socket#present/in:+", "visible": true, "timeout_ms": 120000},
    {"label": "the fullscreen pass's output onto present's + input", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#render_fullscreen/out:color"}, "to": {"name": "pelican.graphCanvasView::graph_derived_socket#present/in:+"}, "steps": 8},
    {"label": "edit_preset_pass on present committed", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Pass inputs saved.", "timeout_ms": 120000},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the box is on screen through the fullscreen pass: the middle is not the gradient", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/gui_graph_only_edits_drawn.png", "pixels": [[0.5, 0.5]]}, "path": "pixels[0]", "op": "ne", "value_of": "gradient", "retry_ms": 120000},
    {"label": "the box, read", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/gui_graph_only_edits_drawn.png", "pixels": [[0.5, 0.5]]}, "path": "pixels[0]", "remember": "drawn"},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "pick the fullscreen pass", "cmd": "click", "name": "pelican.graphCanvasView::graph_node#render_fullscreen"},
    {"label": "decision 2: Fix sockets in its detail column, offered once the plan shows the input", "cmd": "wait", "name": "pelican.graphCanvasNodeActions.fixSockets", "visible": true, "enabled": true, "timeout_ms": 120000},
    {"label": "Fix sockets (the Frame Plan's, which reads the plan and the context first)", "cmd": "click", "name": "pelican.graphCanvasNodeActions.fixSockets"},
    {"label": "the document: the node draws with the project's copy", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[5].parameters.shader.fragment", "value": "project://shaders/render_fullscreen", "retry_ms": 120000},
    {"label": "the copy holds one fixed declaration, named for the input", "file": "contains", "path": "{artifacts}/graph_only/shaders/render_fullscreen.frag", "text": "uniform sampler2D in_render_material_pass", "value": true},
    {"label": "and the variadic line is the comment Make sockets variadic puts back", "file": "contains", "path": "{artifacts}/graph_only/shaders/render_fullscreen.frag", "text": "// pelican: fixed sockets, was PELICAN_DECLARE_VARIADIC_INPUTS", "value": true},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "the band's open end is gone: the group is fixed", "cmd": "wait", "name": "pelican.graphCanvasView::graph_socket#render_fullscreen/in:variadic", "missing": true, "timeout_ms": 120000},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the picture is the same: the copy shows its input as passthrough did", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/gui_graph_only_edits_fixed.png", "pixels": [[0.5, 0.5]]}, "path": "pixels[0]", "op": "eq", "value_of": "drawn", "retry_ms": 120000},

    {"label": "(c) the canvas can edit again", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "Add: the palette opens", "cmd": "click", "name": "pelican.graphCanvasAddNode"},
    {"label": "the palette is on screen", "cmd": "wait", "name": "pelican.graphCanvasPalette", "visible": true, "timeout_ms": 10000},
    {"label": "the filter narrows the list to the target reference", "cmd": "type", "name": "pelican.graphCanvasPaletteFilter", "text": "target_ref"},
    {"label": "the target combo is offered", "cmd": "wait", "name": "pelican.graphCanvasPaletteTarget", "visible": true, "timeout_ms": 10000},
    {"label": "New render target… in the combo", "cmd": "select", "name": "pelican.graphCanvasPaletteTarget", "text": "New render target…"},
    {"label": "Enter in the filter is OK", "cmd": "key", "name": "pelican.graphCanvasPaletteFilter", "sequence": "Return"},
    {"label": "the palette closed", "cmd": "wait", "name": "pelican.graphCanvasPalette", "missing": true, "timeout_ms": 10000},
    {"label": "the form opens", "cmd": "wait", "name": "pelican.renderTargetForm.name", "visible": true, "timeout_ms": 60000},
    {"label": "on the name Studio proposes", "expect": "text_equals", "name": "pelican.renderTargetForm.name", "value": "render_target"},
    {"label": "OK", "cmd": "click", "name": "pelican.renderTargetForm.ok"},
    {"label": "the engine declares it", "expect": "rpc_equals", "method": "get_render_authoring_context", "params": {}, "path": "render_targets[0].name", "value": "render_target", "retry_ms": 120000},
    {"label": "and the reference is placed", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_target_ref", "visible": true, "timeout_ms": 120000},
    {"label": "the canvas can edit again", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "pick the reference", "cmd": "click", "name": "pelican.graphCanvasView::graph_node#render_target_ref"},
    {"label": "decision 3: Edit target… in its detail column", "cmd": "wait", "name": "pelican.graphCanvasNodeActions.editTarget", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "Edit target…", "cmd": "click", "name": "pelican.graphCanvasNodeActions.editTarget"},
    {"label": "the Frame Plan's form opens on the target", "cmd": "wait", "name": "pelican.renderTargetForm.name", "visible": true, "text": "render_target", "timeout_ms": 60000},
    {"label": "chosen from the list: Explicit format", "cmd": "select", "name": "pelican.renderTargetForm.kind", "text": "Explicit format"},
    {"label": "the format list is open to it", "cmd": "wait", "name": "pelican.renderTargetForm.format", "enabled": true, "timeout_ms": 10000},
    {"label": "eight-bit, chosen from the list", "cmd": "select", "name": "pelican.renderTargetForm.format", "text": "R8G8B8A8_UNORM"},
    {"label": "OK", "cmd": "click", "name": "pelican.renderTargetForm.ok"},
    {"label": "the Graph says it is saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Render target render_target saved.", "timeout_ms": 120000},
    {"label": "the document: the declaration's format", "expect": "rpc_equals", "method": "get_render_authoring_context", "params": {}, "path": "render_targets[0].authored_declaration.format", "value": "R8G8B8A8_UNORM", "retry_ms": 120000},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the picture is the same: nothing reads the target", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/gui_graph_only_edits_edited.png", "pixels": [[0.5, 0.5]]}, "path": "pixels[0]", "op": "eq", "value_of": "drawn", "retry_ms": 120000},

    {"label": "the canvas can edit again", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "Add: the palette opens", "cmd": "click", "name": "pelican.graphCanvasAddNode"},
    {"label": "the palette is on screen", "cmd": "wait", "name": "pelican.graphCanvasPalette", "visible": true, "timeout_ms": 10000},
    {"label": "the filter narrows the list to the target reference", "cmd": "type", "name": "pelican.graphCanvasPaletteFilter", "text": "target_ref"},
    {"label": "the target combo is offered", "cmd": "wait", "name": "pelican.graphCanvasPaletteTarget", "visible": true, "timeout_ms": 10000},
    {"label": "New render target… in the combo", "cmd": "select", "name": "pelican.graphCanvasPaletteTarget", "text": "New render target…"},
    {"label": "Enter in the filter is OK", "cmd": "key", "name": "pelican.graphCanvasPaletteFilter", "sequence": "Return"},
    {"label": "the palette closed", "cmd": "wait", "name": "pelican.graphCanvasPalette", "missing": true, "timeout_ms": 10000},
    {"label": "the form opens", "cmd": "wait", "name": "pelican.renderTargetForm.name", "visible": true, "timeout_ms": 60000},
    {"label": "on the next name Studio proposes", "expect": "text_equals", "name": "pelican.renderTargetForm.name", "value": "render_target_2"},
    {"label": "OK", "cmd": "click", "name": "pelican.renderTargetForm.ok"},
    {"label": "the engine declares it", "expect": "rpc_equals", "method": "get_render_authoring_context", "params": {}, "path": "render_targets[1].name", "value": "render_target_2", "retry_ms": 120000},
    {"label": "how many targets the context lists with both", "expect": "result", "command": {"cmd": "rpc", "method": "get_render_authoring_context", "params": {}}, "path": "result.render_targets.$len", "remember": "targets"},
    {"label": "and its reference is placed", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_target_2_ref", "visible": true, "timeout_ms": 120000},
    {"label": "the canvas can edit again", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "pick the second reference", "cmd": "click", "name": "pelican.graphCanvasView::graph_node#render_target_2_ref"},
    {"label": "Delete target in its detail column", "cmd": "wait", "name": "pelican.graphCanvasNodeActions.deleteTarget", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "Delete target: nothing reads it, so the reference goes first, then the declaration", "cmd": "click", "name": "pelican.graphCanvasNodeActions.deleteTarget"},
    {"label": "the reference is gone", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_target_2_ref", "missing": true, "timeout_ms": 120000},
    {"label": "and the declaration", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Render target render_target_2 deleted.", "timeout_ms": 120000},
    {"label": "the document: one target fewer", "expect": "result", "command": {"cmd": "rpc", "method": "get_render_authoring_context", "params": {}}, "path": "result.render_targets.$len", "value_of": "targets", "plus": -1, "retry_ms": 120000},
    {"label": "the first is still there", "expect": "rpc_equals", "method": "get_render_authoring_context", "params": {}, "path": "render_targets[0].name", "value": "render_target"},
    {"label": "the targets' file no longer names it", "file": "contains", "path": "{artifacts}/graph_only/passes/authoring/render-targets.json", "text": "render_target_2", "value": false},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the picture is the same", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/gui_graph_only_edits_deleted.png", "pixels": [[0.5, 0.5]]}, "path": "pixels[0]", "op": "eq", "value_of": "drawn", "retry_ms": 120000},
    {"label": "the canvas can edit again", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "the Graph's Add fullscreen pass: a second pass, to write the first target", "cmd": "action", "name": "pelican.graphCanvas.addFullscreenPass"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "the canvas can edit again", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "the first target onto its colour: the pass writes render_target", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#render_target_ref/out:resource"}, "to": {"name": "pelican.graphCanvasView::graph_socket#render_fullscreen_2/in:color"}, "steps": 8},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 120000},
    {"label": "the canvas can edit again", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "pick the first reference", "cmd": "click", "name": "pelican.graphCanvasView::graph_node#render_target_ref"},
    {"label": "Delete target in its detail column", "cmd": "wait", "name": "pelican.graphCanvasNodeActions.deleteTarget", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "Delete target on a target a pass writes: sent as it is", "cmd": "click", "name": "pelican.graphCanvasNodeActions.deleteTarget"},
    {"label": "the engine refuses it, in one sentence", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "render_target is still", "timeout_ms": 120000},
    {"label": "which says what still uses it", "expect": "result", "command": {"cmd": "text", "name": "pelican.graphCanvasNotice"}, "path": "text", "op": "contains", "value": "used by render_fullscreen_2", "remember": "refusal"},
    {"label": "the target is still declared", "expect": "rpc_equals", "method": "get_render_authoring_context", "params": {}, "path": "render_targets[0].name", "value": "render_target"},
    {"label": "and its reference is still there", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_target_ref", "visible": true, "timeout_ms": 10000},
    {"label": "the picture is the same", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/gui_graph_only_edits_refused.png", "pixels": [[0.5, 0.5]]}, "path": "pixels[0]", "op": "eq", "value_of": "drawn", "retry_ms": 120000},
    {"label": "a picture of the window", "expect": "screenshot", "path": "gui_graph_only_edits_window.png"}
  ]
}
