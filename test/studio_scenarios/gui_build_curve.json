{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "gui_build_curve",
  "description": "UX-8 (GB-4 target 1, the part that stopped): a curve drives a shader's value, from File > New Project > Blank with Studio's GUI only. The scenario writes the fragment shader (an editor of one's own): it declares a storage buffer at its first pass-input binding, named as the port header names the port level (pelican_resource_level), and draws its float as a grey under a fixed 0.5 band. A fullscreen pass draws with it onto present. The palette places a render.buffer (float, one element) and a value.curve, which arrives as a ramp from 0 to 1 on the scene clock (decision 3) and is placed clear of what is drawn (decision 8). The three places GB-4 wrote by hand are drags: the curve onto the buffer's value socket (decision 1), the buffer onto the pass's buffer binding socket, which adds the named buffer port with its element and its line in one edit (decision 2). The Keys table makes the ramp 0.1 to 0.9 (decision 4). The Timeline follows the curve with no instance in Values from (decision 6); a press at its right end draws scene time 1 and the grey brightens, at its left end it darkens again; Play runs the clock and the grey brightens on its own. Typed: the project folder and name, the two palette filters, and the two key values.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "timeout_ms": 10000, "visible": true},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "gb_curve"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "timeout_ms": 10000, "missing": true},
    {"label": "the blank project's present is on the Frame Plan canvas", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "timeout_ms": 180000, "visible": true},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the Graph tab is in front", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the canvas can edit the new document", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "write shaders/curve_level.frag (an editor of one's own)", "file": "write", "path": "{artifacts}/gb_curve/shaders/curve_level.frag", "text": "#version 460\n#extension GL_GOOGLE_include_directive : require\n#include \"pelican_sets.glsl\"\n// UX-8: one number the graph hands the pass, drawn as a grey. The top band\n// is a fixed reference grey.\nlayout(std430, set = PELICAN_SET_PASS_INPUT, binding = 0) readonly buffer Level { float values[]; } pelican_resource_level;\n\nlayout(location = 0) in vec2 inTexCoord;\nlayout(location = 0) out vec4 outColor;\n\nvoid main() {\n    float level = pelican_resource_level.values[0];\n    float shown = inTexCoord.y < 0.1 ? 0.5 : clamp(level, 0.0, 1.0);\n    outColor = vec4(vec3(shown), 1.0);\n}\n"},
    {"label": "Show: Value (the root's value nodes are drawn)", "cmd": "click", "name": "pelican.graphCanvasShow.value"},
    {"label": "Add fullscreen pass", "cmd": "action", "name": "pelican.graphCanvas.addFullscreenPass"},
    {"label": "the pass is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_fullscreen", "timeout_ms": 120000, "visible": true},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "pick the pass", "cmd": "click", "name": "pelican.graphCanvasView::graph_node_header#render_fullscreen"},
    {"label": "its Fragment field", "cmd": "wait", "name": "pelican.graphCanvasPass.shader.fragment", "timeout_ms": 60000, "visible": true, "enabled": true},
    {"label": "Fragment: curve_level", "cmd": "select", "name": "pelican.graphCanvasPass.shader.fragment", "text": "project://shaders/curve_level"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "present's + input", "cmd": "wait", "name": "pelican.graphCanvasView::graph_derived_socket#present/in:+", "timeout_ms": 120000, "visible": true},
    {"label": "the pass's colour onto present's + input", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#render_fullscreen/out:color"}, "to": {"name": "pelican.graphCanvasView::graph_derived_socket#present/in:+"}, "steps": 8},
    {"label": "present's inputs saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Pass inputs saved."},
    {"label": "the pass's buffer binding has a socket (the reflection shows it)", "cmd": "wait", "name": "pelican.graphCanvasView::graph_socket#render_fullscreen/in@0", "timeout_ms": 120000, "visible": true},
    {"label": "nothing feeds the binding: the engine's zeros, black under the 0.5 band", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/level.png", "pixels": [[0.5, 0.5], [0.5, 0.03]]}, "path": "pixels[0]", "remember": "black"},
    {"label": "the canvas takes edits", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "Add: the palette opens (render.buffer)", "cmd": "click", "name": "pelican.graphCanvasAddNode"},
    {"label": "the palette is on screen", "cmd": "wait", "name": "pelican.graphCanvasPalette", "timeout_ms": 10000, "visible": true},
    {"label": "the filter: render.buffer", "cmd": "type", "name": "pelican.graphCanvasPaletteFilter", "text": "render.buffer"},
    {"label": "Enter in the filter is OK", "cmd": "key", "name": "pelican.graphCanvasPaletteFilter", "sequence": "Return"},
    {"label": "the palette's loop ends", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "zz-never-shown", "timeout_ms": 400, "expect_error": "automation.wait_timeout@1"},
    {"label": "render_buffer is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_buffer", "timeout_ms": 120000, "visible": true},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "a float buffer of one element", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[2].parameters", "value": {"element": "float", "size": 4}, "retry_ms": 60000},
    {"label": "the canvas takes edits", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "Add: the palette opens (value.curve)", "cmd": "click", "name": "pelican.graphCanvasAddNode"},
    {"label": "the palette is on screen", "cmd": "wait", "name": "pelican.graphCanvasPalette", "timeout_ms": 10000, "visible": true},
    {"label": "the filter: value.curve", "cmd": "type", "name": "pelican.graphCanvasPaletteFilter", "text": "value.curve"},
    {"label": "Enter in the filter is OK", "cmd": "key", "name": "pelican.graphCanvasPaletteFilter", "sequence": "Return"},
    {"label": "the palette's loop ends", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "zz-never-shown", "timeout_ms": 400, "expect_error": "automation.wait_timeout@1"},
    {"label": "value_curve is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#value_curve", "timeout_ms": 120000, "visible": true},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the curve's ramp (decision 3)", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[4].parameters.keys", "value": [{"time": 0, "value": 0}, {"time": 1, "value": 1}], "retry_ms": 60000},
    {"label": "on the scene clock the palette put beside it", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[4].inputs.time.node", "value": "scene_time"},
    {"label": "the curve is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#value_curve", "timeout_ms": 60000, "visible": true},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "let it settle", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "zz-never-shown", "timeout_ms": 800, "expect_error": "automation.wait_timeout@1"},
    {"label": "the curve's value onto the buffer's value socket (decision 1)", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#value_curve/out:value"}, "to": {"name": "pelican.graphCanvasView::graph_socket#render_buffer/in:value"}, "steps": 10},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the buffer reads the curve", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[2].inputs.value.node", "value": "value_curve", "retry_ms": 60000},
    {"label": "the canvas takes edits", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "let it settle", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "zz-never-shown", "timeout_ms": 800, "expect_error": "automation.wait_timeout@1"},
    {"label": "the buffer onto the pass's buffer binding (decision 2)", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#render_buffer/out:resource"}, "to": {"name": "pelican.graphCanvasView::graph_socket#render_fullscreen/in@0"}, "steps": 10},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the pass's buffer port, with its element", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ports.level", "value": {"access": "read", "element": "float", "kind": "buffer"}, "retry_ms": 60000},
    {"label": "and its line", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].inputs.level.node", "value": "render_buffer"},
    {"label": "scene time 0: the curve's 0", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/level.png", "pixels": [[0.5, 0.5], [0.5, 0.03]]}, "path": "pixels[0]", "remember": "ramp0"},
    {"label": "the canvas takes edits", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "let it settle", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "zz-never-shown", "timeout_ms": 800, "expect_error": "automation.wait_timeout@1"},
    {"label": "pick the curve", "cmd": "click", "name": "pelican.graphCanvasView::graph_node_header#value_curve"},
    {"label": "its Keys table", "cmd": "wait", "name": "pelican.graphCanvasCurve.key0.value", "timeout_ms": 30000, "visible": true, "enabled": true},
    {"label": "key 0's value: 0.1", "cmd": "type", "name": "pelican.graphCanvasCurve.key0.value", "text": "0.1"},
    {"label": "Return", "cmd": "key", "name": "pelican.graphCanvasCurve.key0.value", "sequence": "Return"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "key 0 is 0.1", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[4].parameters.keys[0].value", "value": 0.1, "retry_ms": 60000},
    {"label": "the canvas takes edits", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "key 1's field", "cmd": "wait", "name": "pelican.graphCanvasCurve.key1.value", "timeout_ms": 30000, "visible": true, "enabled": true},
    {"label": "key 1's value: 0.9", "cmd": "type", "name": "pelican.graphCanvasCurve.key1.value", "text": "0.9"},
    {"label": "Return", "cmd": "key", "name": "pelican.graphCanvasCurve.key1.value", "sequence": "Return"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "key 1 is 0.9", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[4].parameters.keys[1].value", "value": 0.9, "retry_ms": 60000},
    {"label": "scene time 0 now draws 0.1", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/level.png", "pixels": [[0.5, 0.5], [0.5, 0.03]]}, "path": "pixels[0]", "remember": "dark", "op": "ne", "value_of": "black", "retry_ms": 30000},
    {"label": "Timeline", "cmd": "click", "name": "pelican.graphTimelineToggle"},
    {"label": "the strip", "cmd": "wait", "name": "pelican.graphTimeline", "timeout_ms": 20000, "visible": true},
    {"label": "Live", "cmd": "click", "name": "pelican.graphCanvasLive"},
    {"label": "the strip reads the curve with nothing in Values from (decision 6)", "cmd": "wait", "name": "pelican.graphTimelineSummary", "timeout_ms": 60000, "contains": "value_curve.value"},
    {"label": "scrub: a press at the strip's right end", "cmd": "click", "name": "pelican.graphTimeline", "point": [4000, 20]},
    {"label": "scene time 1: the curve's 0.9, brighter", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/level.png", "pixels": [[0.5, 0.5], [0.5, 0.03]]}, "path": "pixels[0]", "remember": "bright", "op": "ne", "value_of": "dark", "retry_ms": 30000},
    {"label": "scrub: a press at the strip's left end", "cmd": "click", "name": "pelican.graphTimeline", "point": [0, 20]},
    {"label": "scene time 0 again: dark, not the bright one", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/level.png", "pixels": [[0.5, 0.5], [0.5, 0.03]]}, "path": "pixels[0]", "op": "ne", "value_of": "bright", "retry_ms": 30000},
    {"label": "a picture of the window (scrubbed back)", "expect": "screenshot", "path": "gui_build_curve_window.png"},
    {"label": "Live off", "cmd": "click", "name": "pelican.graphCanvasLive"},
    {"label": "press Play", "cmd": "click", "name": "pelican.play.play"},
    {"label": "playing", "cmd": "wait", "name": "pelican.playStatus", "timeout_ms": 30000, "contains": "Playing"},
    {"label": "playing: the clock runs the ramp up, brighter", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/level.png", "pixels": [[0.5, 0.5], [0.5, 0.03]]}, "path": "pixels[0]", "value_of": "bright", "retry_ms": 60000},
    {"label": "press Stop", "cmd": "click", "name": "pelican.play.play"},
    {"label": "edit again", "cmd": "wait", "name": "pelican.playStatus", "timeout_ms": 30000, "text": "Edit"},
    {"label": "a picture of the Graph tab", "expect": "screenshot", "name": "pelican.graphCanvas", "path": "gui_build_curve_graph.png"}
  ]
}
