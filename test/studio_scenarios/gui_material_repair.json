{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "gui_material_repair",
  "description": "FO-1s, decisions 2 and 3 (engines FO-1 and EB-1), from Blank with the GUI only. A Cube and a forward material pass, New material… made red and bound to every Cube: the box is red. The material document is then saved outside Studio without its last }, and the project opened again: the engine starts without it (FO-1), Problems lists an error (the document, with its line) and a warning (the cube's binding), and the box draws with the model's own material. The warning's row shows the cube's bindings in the Materials dock; the error's row the document, with the line and the column. Show the document opens its bytes, the } is typed back and Save writes the file. Register again (register_material) is refused as listed already -- the engine registers a document it refused at its start only when it starts again (reported) -- and the dock offers Restart engine: after it nothing is wrong and the box is red again. Delete… on the material is refused in one sentence (the bindings of Cube use it) with a button to that place: the cube's bindings in the dock, set to Model default; Delete… then takes the document off the list (the file stays) and Undo registers it again. Typed: the project folder and name in New Project, the red's hex.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up, so the switch to the new project is something that happens", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "start from the default layout", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "visible": true, "timeout_ms": 10000},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "material_repair"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "missing": true, "timeout_ms": 10000},
    {"label": "the new project's frame plan has its one pass", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "visible": true, "timeout_ms": 180000},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the Outliner is on screen", "cmd": "wait", "name": "pelican.outliner", "visible": true, "timeout_ms": 10000},
    {"label": "Add Object > Cube", "cmd": "action", "name": "pelican.outliner.addObject.cube"},
    {"label": "the engine has a third object, named Cube", "expect": "rpc_equals", "method": "scene_tree", "params": {"scene_id": "default_scene"}, "path": "objects[2].name", "value": "Cube", "retry_ms": 60000},
    {"label": "the Inspector names it", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "Cube\n", "timeout_ms": 30000},
    {"label": "the Inspector's model field reads the engine primitive (its session is idle again)", "cmd": "wait", "name": "pelican.inspectorModelChoice", "text": "Cube (built-in)", "timeout_ms": 60000},
    {"label": "File > Save Scene", "cmd": "action", "name": "pelican.file.saveScene"},
    {"label": "the save is done", "cmd": "wait", "name": "pelican.inspectorNotice", "contains": "Scene saved", "timeout_ms": 60000},
    {"label": "Add material pass...", "cmd": "action", "name": "pelican.framePlan.addMaterialPass"},
    {"label": "the Graph's palette opens on the material pass", "cmd": "wait", "name": "pelican.graphCanvasPalette", "visible": true, "timeout_ms": 60000},
    {"label": "the contract combo is offered", "cmd": "wait", "name": "pelican.graphCanvasPaletteContract", "visible": true, "timeout_ms": 10000},
    {"label": "the contract: forward_opaque_v1", "cmd": "select", "name": "pelican.graphCanvasPaletteContract", "text": "forward_opaque_v1"},
    {"label": "Enter in the filter is OK", "cmd": "key", "name": "pelican.graphCanvasPaletteFilter", "sequence": "Return"},
    {"label": "the palette closed", "cmd": "wait", "name": "pelican.graphCanvasPalette", "missing": true, "timeout_ms": 10000},
    {"label": "the pass's draw loop is drawn (after a restart, if the route default asks for one)", "cmd": "wait", "name": "pelican.graphCanvasView::graph_zone#render_material_pass_draws", "visible": true, "timeout_ms": 180000},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the canvas can edit again", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "fit the graph", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "present's + input", "cmd": "wait", "name": "pelican.graphCanvasView::graph_derived_socket#present/in:+", "visible": true, "timeout_ms": 120000},
    {"label": "the pass's colour onto present's + input", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#render_material_pass/out:color"}, "to": {"name": "pelican.graphCanvasView::graph_derived_socket#present/in:+"}, "steps": 8},
    {"label": "present's inputs saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Pass inputs saved.", "timeout_ms": 120000},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the Frame Plan tab is in front again", "cmd": "action", "name": "pelican.view.renderTools.frame_plan"},
    {"label": "the viewport holds the grey box: a handful of colours", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/grey_box.png", "pixels": [[0.5, 0.5]]}, "path": "distinct_colors", "op": "le", "value": 64, "retry_ms": 120000},
    {"label": "View > Materials", "cmd": "action", "name": "pelican.view.materials"},
    {"label": "the dock is on screen", "cmd": "wait", "name": "pelican.materials.list", "visible": true, "timeout_ms": 10000},
    {"label": "New material...", "cmd": "click", "name": "pelican.materials.newMaterial"},
    {"label": "the row under it is open", "cmd": "wait", "name": "pelican.materials.new.surface", "visible": true, "timeout_ms": 10000},
    {"label": "OpenPBR's opaque one-sided variant", "cmd": "select", "name": "pelican.materials.new.surface", "text": "openpbr / opaque_single_sided"},
    {"label": "Create (the name proposed, nothing typed)", "cmd": "click", "name": "pelican.materials.new.create"},
    {"label": "registered live", "expect": "rpc_equals", "method": "list_materials", "params": {}, "path": "documents[0].materials[0].registered", "value": true, "retry_ms": 30000},
    {"label": "base_color's swatch", "cmd": "wait", "name": "pelican.materials.param.base_color.swatch", "visible": true, "timeout_ms": 30000},
    {"label": "the swatch opens the colour dialog", "cmd": "click", "name": "pelican.materials.param.base_color.swatch"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.materials.colorDialog", "visible": true, "timeout_ms": 10000},
    {"label": "red, in its hex field", "cmd": "type", "name": "pelican.materials.colorDialog.hex", "text": "#ff0000"},
    {"label": "OK", "cmd": "click", "name": "pelican.materials.colorDialog.ok"},
    {"label": "the document holds red", "expect": "rpc_equals", "method": "get_material", "params": {"path": "materials/material.material.json"}, "path": "material.values.base_color", "value": [1.0, 0.0, 0.0, 1.0], "retry_ms": 30000},
    {"label": "pick the Cube in the Outliner", "cmd": "select", "name": "pelican.outliner", "text": "Cube"},
    {"label": "the Inspector names it", "cmd": "wait", "name": "pelican.inspectorSelection", "contains": "Cube\n", "timeout_ms": 30000},
    {"label": "its Material rows are read", "cmd": "wait", "name": "pelican.inspectorMaterialChoice", "enabled": true, "timeout_ms": 60000},
    {"label": "the model's binding: Every Cube", "cmd": "select", "name": "pelican.inspectorMaterialTarget", "text": "Every Cube"},
    {"label": "the line under it says so", "cmd": "wait", "name": "pelican.inspectorMaterialScope", "contains": "Applies to every Cube", "timeout_ms": 30000},
    {"label": "the new material on every Cube: one bind_material", "cmd": "select", "name": "pelican.inspectorMaterialChoice", "text": "material"},
    {"label": "the engine binds it", "expect": "rpc_equals", "method": "get_material_bindings", "params": {"model": "engine://primitives/cube"}, "path": "primitives[0].material", "value": "material", "retry_ms": 30000},
    {"label": "read the green of the box's middle", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/red_box.png", "pixels": [[0.5, 0.5]]}, "path": "rgb[0][1]", "remember": "green_red"},
    {"label": "read its blue", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/red_box.png", "pixels": [[0.5, 0.5]]}, "path": "rgb[0][2]", "remember": "blue_red"},
    {"label": "the box's front is red: red well above green", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/red_box.png", "pixels": [[0.5, 0.5]]}, "path": "rgb[0][0]", "op": "gt", "value_of": "green_red", "plus": 40, "retry_ms": 120000},
    {"label": "and well above blue", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/red_box.png", "pixels": [[0.5, 0.5]]}, "path": "rgb[0][0]", "op": "gt", "value_of": "blue_red", "plus": 40},
    {"label": "the document as the engine wrote it ends with its last }", "file": "contains", "path": "{artifacts}/material_repair/materials/material.material.json", "text": "  ]\n}\n", "value": true},
    {"label": "the document saved outside Studio without its last }", "file": "replace", "path": "{artifacts}/material_repair/materials/material.material.json", "old": "  ]\n}\n", "new": "  ]\n"},
    {"label": "open another project, so the next open is a real one", "cmd": "open_project", "dir": "{other_project}"},
    {"label": "that engine answers", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "open the project again: its engine starts on the broken document", "cmd": "open_project", "dir": "{artifacts}/material_repair"},
    {"label": "the engine does not stop (engine FO-1): it answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "View > Problems", "cmd": "action", "name": "pelican.view.problems"},
    {"label": "the list is on screen", "cmd": "wait", "name": "pelican.problems.list", "visible": true, "timeout_ms": 10000},
    {"label": "the engine's start left an error and a warning", "cmd": "wait", "name": "pelican.problemsCount", "text": "1 error, 1 warning", "timeout_ms": 60000},
    {"label": "the error: the document did not load", "expect": "rpc_equals", "method": "get_problems", "params": {}, "path": "problems[0].code", "value": "material.document_invalid@1"},
    {"label": "the warning: the cube's binding names a material no loaded document holds", "expect": "rpc_equals", "method": "get_problems", "params": {}, "path": "problems[1].code", "value": "material.binding_unresolved@1"},
    {"label": "list_materials says the engine refused it", "expect": "rpc_equals", "method": "list_materials", "params": {}, "path": "documents[0].status", "value": "invalid"},
    {"label": "the Frame Plan tab is in front", "cmd": "action", "name": "pelican.view.renderTools.frame_plan"},
    {"label": "read the green of the box's middle", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/default_box.png", "pixels": [[0.5, 0.5]]}, "path": "rgb[0][1]", "remember": "green_broken"},
    {"label": "the cube draws with the model's own material: not red", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/default_box.png", "pixels": [[0.5, 0.5]]}, "path": "rgb[0][0]", "op": "lt", "value_of": "green_broken", "plus": 40, "retry_ms": 120000},
    {"label": "a picture of the window with the two problems", "expect": "screenshot", "path": "gui_material_repair_problems.png"},
    {"label": "decision 2: the warning's row", "cmd": "select", "name": "pelican.problems.list", "index": 1},
    {"label": "it is the binding's", "cmd": "wait", "name": "pelican.problems.detail", "contains": "Cube binds material, which no loaded material document holds", "timeout_ms": 10000},
    {"label": "the Materials dock shows the cube's bindings", "cmd": "wait", "name": "pelican.materials.model", "visible": true, "timeout_ms": 10000},
    {"label": "with what is wrong with them", "cmd": "wait", "name": "pelican.materials.model.notice", "contains": "Cube binds material, which no loaded material document holds", "timeout_ms": 10000},
    {"label": "close the bindings", "cmd": "click", "name": "pelican.materials.model.close"},
    {"label": "decision 2: the error's row", "cmd": "select", "name": "pelican.problems.list", "index": 0},
    {"label": "it is the document's", "cmd": "wait", "name": "pelican.problems.detail", "contains": "materials/material.material.json", "timeout_ms": 10000},
    {"label": "the Materials dock shows the document, with the line and the column", "cmd": "wait", "name": "pelican.materials.broken", "contains": "materials/material.material.json would not load at line ", "timeout_ms": 30000},
    {"label": "Show the document", "cmd": "click", "name": "pelican.materials.showDocument"},
    {"label": "it opens on the bytes on disk", "cmd": "wait", "name": "pelican.materials.documentDialog", "visible": true, "timeout_ms": 10000},
    {"label": "not JSON yet", "cmd": "wait", "name": "pelican.materials.documentDialog.notice", "contains": "Not valid JSON yet at line ", "timeout_ms": 10000},
    {"label": "to the end of the text", "cmd": "key", "name": "pelican.materials.documentDialog.text", "sequence": "Ctrl+End"},
    {"label": "the } that was lost, typed", "cmd": "type", "name": "pelican.materials.documentDialog.text", "text": "}", "select_all": false},
    {"label": "it is JSON now", "cmd": "wait", "name": "pelican.materials.documentDialog.notice", "contains": "Valid JSON", "timeout_ms": 10000},
    {"label": "Save writes the file whole", "cmd": "click", "name": "pelican.materials.documentDialog.save"},
    {"label": "the window closes", "cmd": "wait", "name": "pelican.materials.documentDialog", "missing": true, "timeout_ms": 10000},
    {"label": "the file has its } again", "file": "contains", "path": "{artifacts}/material_repair/materials/material.material.json", "text": "  ]\n}", "value": true},
    {"label": "the dock says what comes next", "cmd": "wait", "name": "pelican.materials.notice", "text": "Saved materials/material.material.json; Register again takes it in.", "timeout_ms": 10000},
    {"label": "Register again (register_material)", "cmd": "click", "name": "pelican.materials.registerAgain"},
    {"label": "the engine holds the document it refused at its start: listed already, only a restart takes it in (reported to the engine)", "cmd": "wait", "name": "pelican.materials.notice", "text": "The engine refused materials/material.material.json at its start; only a restart takes it in (material.path_conflict@1).", "timeout_ms": 30000},
    {"label": "the dock offers the restart", "cmd": "wait", "name": "pelican.materials.restartEngine", "visible": true, "timeout_ms": 10000},
    {"label": "a picture of the dock with the restart", "expect": "screenshot", "path": "gui_material_repair_register.png"},
    {"label": "Restart engine", "cmd": "click", "name": "pelican.materials.restartEngine"},
    {"label": "the restarted engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "nothing is wrong any more", "cmd": "wait", "name": "pelican.problemsCount", "text": "No problems", "timeout_ms": 60000},
    {"label": "the document is loaded", "expect": "rpc_equals", "method": "list_materials", "params": {}, "path": "documents[0].status", "value": "loaded", "retry_ms": 30000},
    {"label": "the dock shows its material again", "cmd": "wait", "name": "pelican.materials.heading", "contains": "material — materials/material.material.json", "timeout_ms": 30000},
    {"label": "the Frame Plan tab is in front", "cmd": "action", "name": "pelican.view.renderTools.frame_plan"},
    {"label": "read the green of the box's middle", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/red_again.png", "pixels": [[0.5, 0.5]]}, "path": "rgb[0][1]", "remember": "green_again"},
    {"label": "read its blue", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/red_again.png", "pixels": [[0.5, 0.5]]}, "path": "rgb[0][2]", "remember": "blue_again"},
    {"label": "the box's front is red: red well above green", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/red_again.png", "pixels": [[0.5, 0.5]]}, "path": "rgb[0][0]", "op": "gt", "value_of": "green_again", "plus": 40, "retry_ms": 120000},
    {"label": "and well above blue", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/red_again.png", "pixels": [[0.5, 0.5]]}, "path": "rgb[0][0]", "op": "gt", "value_of": "blue_again", "plus": 40},
    {"label": "View > Materials", "cmd": "action", "name": "pelican.view.materials"},
    {"label": "pick the material", "cmd": "select", "name": "pelican.materials.list", "text": "material"},
    {"label": "decision 3: Delete... (the list's right-click)", "cmd": "action", "name": "pelican.materials.delete"},
    {"label": "it asks first", "cmd": "wait", "name": "pelican.materials.deleteConfirm", "visible": true, "contains": "Delete material material?", "timeout_ms": 10000},
    {"label": "Delete", "cmd": "click", "name": "pelican.materials.deleteConfirmed"},
    {"label": "the engine refuses it: the cube's bindings name it, in one sentence", "cmd": "wait", "name": "pelican.materials.notice", "text": "material is used by the bindings of Cube; take it off them first (material.in_use@1).", "timeout_ms": 30000},
    {"label": "still listed", "expect": "rpc_equals", "method": "list_materials", "params": {}, "path": "documents.$len", "value": 1},
    {"label": "the place it is used: the bindings of Cube", "cmd": "click", "name": "pelican.materials.uses.model#engine://primitives/cube"},
    {"label": "the cube's bindings, in the dock", "cmd": "wait", "name": "pelican.materials.model", "visible": true, "timeout_ms": 10000},
    {"label": "every primitive on material", "cmd": "wait", "name": "pelican.materials.model.choice", "enabled": true, "text": "material", "timeout_ms": 30000},
    {"label": "Model default: the binding taken off", "cmd": "select", "name": "pelican.materials.model.choice", "text": "Model default"},
    {"label": "the engine binds the model's own material", "expect": "rpc_equals", "method": "get_material_bindings", "params": {"model": "engine://primitives/cube"}, "path": "primitives[0].material", "value": "pelican.primitive.default", "retry_ms": 30000},
    {"label": "the Frame Plan tab is in front", "cmd": "action", "name": "pelican.view.renderTools.frame_plan"},
    {"label": "read the green of the box's middle", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/unbound_box.png", "pixels": [[0.5, 0.5]]}, "path": "rgb[0][1]", "remember": "green_unbound"},
    {"label": "the cube is not red any more", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/unbound_box.png", "pixels": [[0.5, 0.5]]}, "path": "rgb[0][0]", "op": "lt", "value_of": "green_unbound", "plus": 40, "retry_ms": 120000},
    {"label": "View > Materials", "cmd": "action", "name": "pelican.view.materials"},
    {"label": "pick the material", "cmd": "select", "name": "pelican.materials.list", "text": "material"},
    {"label": "Delete... again", "cmd": "action", "name": "pelican.materials.delete"},
    {"label": "it asks first", "cmd": "wait", "name": "pelican.materials.deleteConfirm", "visible": true, "timeout_ms": 10000},
    {"label": "Delete", "cmd": "click", "name": "pelican.materials.deleteConfirmed"},
    {"label": "deleted: the document stays on disk", "cmd": "wait", "name": "pelican.materials.notice", "text": "Deleted material; materials/material.material.json stays on disk.", "timeout_ms": 30000},
    {"label": "the engine lists no material document", "expect": "rpc_equals", "method": "list_materials", "params": {}, "path": "documents.$len", "value": 0, "retry_ms": 30000},
    {"label": "the file is still there", "file": "exists", "path": "{artifacts}/material_repair/materials/material.material.json", "value": true},
    {"label": "the dock's Undo is ready", "cmd": "wait", "name": "pelican.materials.undoButton", "enabled": true, "timeout_ms": 30000},
    {"label": "Undo: register_material of the document", "cmd": "action", "name": "pelican.materials.undo"},
    {"label": "put back", "cmd": "wait", "name": "pelican.materials.notice", "text": "Put material back from materials/material.material.json.", "timeout_ms": 30000},
    {"label": "the engine lists it again, registered live", "expect": "rpc_equals", "method": "list_materials", "params": {}, "path": "documents[0].materials[0].registered", "value": true, "retry_ms": 30000},
    {"label": "nothing left to undo", "cmd": "wait", "name": "pelican.materials.undoButton", "enabled": false, "timeout_ms": 30000},
    {"label": "a picture of the window", "expect": "screenshot", "path": "gui_material_repair_window.png"}
  ]
}
