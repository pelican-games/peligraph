{
  "invariants": {
    "undo": "known_red",
    "undo_ticket": "QD1-R38"
  },
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "lighting_pass_template",
  "description": "G-3: a lighting pass built in Studio from the Deferred lighting starting point. The Pass Editor's New pass on this graph root is the Graph's (GL-5f): a render.fullscreen in the graph's nodes. render.target_ref nodes from the palette name the five G-buffer targets and the lit colour; the lit colour goes on the pass's colour, so the pass writes what the viewport shows. New... in its Pass fields with Deferred lighting writes a shader that reads the G-buffer and the scene lights, connects the five references to the pass (UX-5a's match) and turns on Uses scene lights and Camera position, in one edit. The viewport then shows the box lit by the scene's one light: not one colour. The light loop of the shader cut in the author's editor, the picture goes black; restored, the lit box comes back.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {
      "label": "the engine viewport answers editor RPC",
      "cmd": "wait_engine",
      "timeout_ms": 180000
    },
    {
      "label": "the first frame plan has arrived",
      "cmd": "wait",
      "name": "pelican.framePlanStatus",
      "timeout_ms": 180000,
      "contains": "main_render"
    },
    {
      "label": "View > Pass Editor",
      "cmd": "action",
      "name": "pelican.view.passEditor"
    },
    {
      "label": "the Pass Editor has the engine's authoring context: a root that selects no preset",
      "cmd": "wait",
      "name": "pelican.fullscreenPass.authoringStatus",
      "contains": "direct",
      "timeout_ms": 60000
    },
    {
      "label": "New pass: on this graph root it is the Graph's (GL-5f, decision 1)",
      "cmd": "click",
      "name": "pelican.fullscreenPass.new"
    },
    {
      "label": "the Graph places a fullscreen pass",
      "cmd": "wait",
      "name": "pelican.graphCanvasView::graph_node#render_fullscreen",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "in the graph's nodes, after the image it writes",
      "expect": "rpc_equals",
      "method": "get_graph_instances",
      "params": {},
      "path": "nodes[3].id",
      "value": "render_fullscreen",
      "retry_ms": 60000
    },
    {
      "label": "not as a managed fragment",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "managed_fragments.$len",
      "value": 0
    },
    {
      "label": "the canvas can edit again",
      "cmd": "wait",
      "name": "pelican.graphCanvasAddNode",
      "enabled": true,
      "timeout_ms": 120000
    },
    {
      "label": "Add: the palette opens (a G-buffer target the lighting reads)",
      "cmd": "click",
      "name": "pelican.graphCanvasAddNode"
    },
    {
      "label": "the palette is on screen",
      "cmd": "wait",
      "name": "pelican.graphCanvasPalette",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "the filter narrows the list to the target reference",
      "cmd": "type",
      "name": "pelican.graphCanvasPaletteFilter",
      "text": "target_ref"
    },
    {
      "label": "the target combo is offered",
      "cmd": "wait",
      "name": "pelican.graphCanvasPaletteTarget",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "gbuffer_albedo, from the declared targets",
      "cmd": "select",
      "name": "pelican.graphCanvasPaletteTarget",
      "text": "gbuffer_albedo"
    },
    {
      "label": "Enter in the filter is OK",
      "cmd": "key",
      "name": "pelican.graphCanvasPaletteFilter",
      "sequence": "Return"
    },
    {
      "label": "the reference is placed",
      "cmd": "wait",
      "name": "pelican.graphCanvasView::graph_node#gbuffer_albedo_ref",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "the canvas can edit again",
      "cmd": "wait",
      "name": "pelican.graphCanvasAddNode",
      "enabled": true,
      "timeout_ms": 120000
    },
    {
      "label": "Add: the palette opens (a G-buffer target the lighting reads)",
      "cmd": "click",
      "name": "pelican.graphCanvasAddNode"
    },
    {
      "label": "the palette is on screen",
      "cmd": "wait",
      "name": "pelican.graphCanvasPalette",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "the filter narrows the list to the target reference",
      "cmd": "type",
      "name": "pelican.graphCanvasPaletteFilter",
      "text": "target_ref"
    },
    {
      "label": "the target combo is offered",
      "cmd": "wait",
      "name": "pelican.graphCanvasPaletteTarget",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "gbuffer_normal, from the declared targets",
      "cmd": "select",
      "name": "pelican.graphCanvasPaletteTarget",
      "text": "gbuffer_normal"
    },
    {
      "label": "Enter in the filter is OK",
      "cmd": "key",
      "name": "pelican.graphCanvasPaletteFilter",
      "sequence": "Return"
    },
    {
      "label": "the reference is placed",
      "cmd": "wait",
      "name": "pelican.graphCanvasView::graph_node#gbuffer_normal_ref",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "the canvas can edit again",
      "cmd": "wait",
      "name": "pelican.graphCanvasAddNode",
      "enabled": true,
      "timeout_ms": 120000
    },
    {
      "label": "Add: the palette opens (a G-buffer target the lighting reads)",
      "cmd": "click",
      "name": "pelican.graphCanvasAddNode"
    },
    {
      "label": "the palette is on screen",
      "cmd": "wait",
      "name": "pelican.graphCanvasPalette",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "the filter narrows the list to the target reference",
      "cmd": "type",
      "name": "pelican.graphCanvasPaletteFilter",
      "text": "target_ref"
    },
    {
      "label": "the target combo is offered",
      "cmd": "wait",
      "name": "pelican.graphCanvasPaletteTarget",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "gbuffer_material, from the declared targets",
      "cmd": "select",
      "name": "pelican.graphCanvasPaletteTarget",
      "text": "gbuffer_material"
    },
    {
      "label": "Enter in the filter is OK",
      "cmd": "key",
      "name": "pelican.graphCanvasPaletteFilter",
      "sequence": "Return"
    },
    {
      "label": "the reference is placed",
      "cmd": "wait",
      "name": "pelican.graphCanvasView::graph_node#gbuffer_material_ref",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "the canvas can edit again",
      "cmd": "wait",
      "name": "pelican.graphCanvasAddNode",
      "enabled": true,
      "timeout_ms": 120000
    },
    {
      "label": "Add: the palette opens (a G-buffer target the lighting reads)",
      "cmd": "click",
      "name": "pelican.graphCanvasAddNode"
    },
    {
      "label": "the palette is on screen",
      "cmd": "wait",
      "name": "pelican.graphCanvasPalette",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "the filter narrows the list to the target reference",
      "cmd": "type",
      "name": "pelican.graphCanvasPaletteFilter",
      "text": "target_ref"
    },
    {
      "label": "the target combo is offered",
      "cmd": "wait",
      "name": "pelican.graphCanvasPaletteTarget",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "gbuffer_worldpos, from the declared targets",
      "cmd": "select",
      "name": "pelican.graphCanvasPaletteTarget",
      "text": "gbuffer_worldpos"
    },
    {
      "label": "Enter in the filter is OK",
      "cmd": "key",
      "name": "pelican.graphCanvasPaletteFilter",
      "sequence": "Return"
    },
    {
      "label": "the reference is placed",
      "cmd": "wait",
      "name": "pelican.graphCanvasView::graph_node#gbuffer_worldpos_ref",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "the canvas can edit again",
      "cmd": "wait",
      "name": "pelican.graphCanvasAddNode",
      "enabled": true,
      "timeout_ms": 120000
    },
    {
      "label": "Add: the palette opens (a G-buffer target the lighting reads)",
      "cmd": "click",
      "name": "pelican.graphCanvasAddNode"
    },
    {
      "label": "the palette is on screen",
      "cmd": "wait",
      "name": "pelican.graphCanvasPalette",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "the filter narrows the list to the target reference",
      "cmd": "type",
      "name": "pelican.graphCanvasPaletteFilter",
      "text": "target_ref"
    },
    {
      "label": "the target combo is offered",
      "cmd": "wait",
      "name": "pelican.graphCanvasPaletteTarget",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "g_emissive, from the declared targets",
      "cmd": "select",
      "name": "pelican.graphCanvasPaletteTarget",
      "text": "g_emissive"
    },
    {
      "label": "Enter in the filter is OK",
      "cmd": "key",
      "name": "pelican.graphCanvasPaletteFilter",
      "sequence": "Return"
    },
    {
      "label": "the reference is placed",
      "cmd": "wait",
      "name": "pelican.graphCanvasView::graph_node#g_emissive_ref",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "the canvas can edit again",
      "cmd": "wait",
      "name": "pelican.graphCanvasAddNode",
      "enabled": true,
      "timeout_ms": 120000
    },
    {
      "label": "Add: the palette opens (the lit colour the viewport shows)",
      "cmd": "click",
      "name": "pelican.graphCanvasAddNode"
    },
    {
      "label": "the palette is on screen",
      "cmd": "wait",
      "name": "pelican.graphCanvasPalette",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "the filter narrows the list to the target reference",
      "cmd": "type",
      "name": "pelican.graphCanvasPaletteFilter",
      "text": "target_ref"
    },
    {
      "label": "the target combo is offered",
      "cmd": "wait",
      "name": "pelican.graphCanvasPaletteTarget",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "lit_color, from the declared targets",
      "cmd": "select",
      "name": "pelican.graphCanvasPaletteTarget",
      "text": "lit_color"
    },
    {
      "label": "Enter in the filter is OK",
      "cmd": "key",
      "name": "pelican.graphCanvasPaletteFilter",
      "sequence": "Return"
    },
    {
      "label": "the reference is placed",
      "cmd": "wait",
      "name": "pelican.graphCanvasView::graph_node#lit_color_ref",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "the canvas can edit again",
      "cmd": "wait",
      "name": "pelican.graphCanvasAddNode",
      "enabled": true,
      "timeout_ms": 120000
    },
    {
      "label": "auto layout",
      "cmd": "action",
      "name": "pelican.graphCanvas.autoLayout"
    },
    {
      "label": "saved",
      "cmd": "wait",
      "name": "pelican.graphCanvasNotice",
      "text": "Graph change saved.",
      "timeout_ms": 120000
    },
    {
      "label": "fit",
      "cmd": "action",
      "name": "pelican.graphCanvas.fitView"
    },
    {
      "label": "the lit colour onto the pass's colour: the pass writes it",
      "cmd": "drag",
      "from": {
        "name": "pelican.graphCanvasView::graph_socket#lit_color_ref/out:resource"
      },
      "to": {
        "name": "pelican.graphCanvasView::graph_socket#render_fullscreen/in:color"
      },
      "steps": 8
    },
    {
      "label": "saved",
      "cmd": "wait",
      "name": "pelican.graphCanvasNotice",
      "text": "Graph change saved.",
      "timeout_ms": 120000
    },
    {
      "label": "the document: the pass writes the lit colour",
      "expect": "rpc_equals",
      "method": "get_graph_instances",
      "params": {},
      "path": "nodes[3].inputs.color.node",
      "value": "lit_color_ref",
      "retry_ms": 60000
    },
    {
      "label": "the canvas can edit again",
      "cmd": "wait",
      "name": "pelican.graphCanvasAddNode",
      "enabled": true,
      "timeout_ms": 120000
    },
    {
      "label": "pick the pass",
      "cmd": "click",
      "name": "pelican.graphCanvasView::graph_node#render_fullscreen"
    },
    {
      "label": "its Pass fields offer New... beside the fragment",
      "cmd": "wait",
      "name": "pelican.graphCanvasPass.newFragmentShader",
      "visible": true,
      "enabled": true,
      "timeout_ms": 120000
    },
    {
      "label": "New... beside the fragment stem",
      "cmd": "click",
      "name": "pelican.graphCanvasPass.newFragmentShader"
    },
    {
      "label": "the templates, once the graph takes edits",
      "cmd": "wait",
      "name": "pelican.graphCanvasPass.shaderTemplateKind",
      "visible": true,
      "enabled": true,
      "timeout_ms": 120000
    },
    {
      "label": "start from Deferred lighting",
      "cmd": "select",
      "name": "pelican.graphCanvasPass.shaderTemplateKind",
      "text": "Deferred lighting"
    },
    {
      "label": "the shader is named after what it is, nothing typed",
      "expect": "text_equals",
      "name": "pelican.graphCanvasPass.shaderTemplateName",
      "value": "deferred_lighting"
    },
    {
      "label": "Create",
      "cmd": "click",
      "name": "pelican.graphCanvasPass.createFragmentShader"
    },
    {
      "label": "the shader is written for the five G-buffer targets the references name, and the pass takes it",
      "cmd": "wait",
      "name": "pelican.graphCanvasPass.shaderTemplateNotice",
      "contains": "reading 5 input(s); the pass draws with project://shaders/deferred_lighting",
      "timeout_ms": 30000
    },
    {
      "label": "saved, as one edit",
      "cmd": "wait",
      "name": "pelican.graphCanvasNotice",
      "text": "Graph change saved.",
      "timeout_ms": 120000
    },
    {
      "label": "the pass draws with the new shader",
      "expect": "rpc_equals",
      "method": "get_graph_instances",
      "params": {},
      "path": "nodes[3].parameters.shader.fragment",
      "value": "project://shaders/deferred_lighting",
      "retry_ms": 60000
    },
    {
      "label": "with the scene lights",
      "expect": "rpc_equals",
      "method": "get_graph_instances",
      "params": {},
      "path": "nodes[3].parameters.uses_light_data",
      "value": true
    },
    {
      "label": "and the camera position, as a lighting pass does",
      "expect": "rpc_equals",
      "method": "get_graph_instances",
      "params": {},
      "path": "nodes[3].parameters.push_constants",
      "value": "camera_position"
    },
    {
      "label": "the inputs filled themselves from the references (UX-5a's match): five beside the colour it writes",
      "expect": "rpc_equals",
      "method": "get_graph_instances",
      "params": {},
      "path": "nodes[3].inputs.$len",
      "value": 6
    },
    {
      "label": "the shader reads the scene lights",
      "file": "contains",
      "path": "{project}/shaders/deferred_lighting.frag",
      "text": "#include \"pelican_lighting_v1.glsl\""
    },
    {
      "label": "and the world position at input 3",
      "file": "contains",
      "path": "{project}/shaders/deferred_lighting.frag",
      "text": "PELICAN_DECLARE_INPUT_3(in_gbuffer_worldpos);"
    },
    {
      "label": "the viewport shows the box the scene's light lights: black around it and its faces in more than one shade",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/lighting_pass_template_lit.png"
      },
      "path": "distinct_colors",
      "op": "gt",
      "value": 2,
      "retry_ms": 60000
    },
    {
      "label": "the light loop cut, in the author's editor",
      "file": "replace",
      "path": "{project}/shaders/deferred_lighting.frag",
      "old": "index < pelican_light_count()",
      "new": "index < 0u"
    },
    {
      "label": "with no light the picture is one colour, black",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/lighting_pass_template_unlit.png"
      },
      "path": "distinct_colors",
      "op": "lt",
      "value": 2,
      "retry_ms": 30000
    },
    {
      "label": "the light loop back",
      "file": "replace",
      "path": "{project}/shaders/deferred_lighting.frag",
      "old": "index < 0u",
      "new": "index < pelican_light_count()"
    },
    {
      "label": "and the lit box is back",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/lighting_pass_template_relit.png"
      },
      "path": "distinct_colors",
      "op": "gt",
      "value": 2,
      "retry_ms": 30000
    },
    {
      "label": "a picture of the Graph with the lighting pass",
      "expect": "screenshot",
      "path": "lighting_pass_template_graph.png"
    }
  ]
}
