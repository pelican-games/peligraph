{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "canvas_layer_opacity_from_blank",
  "description": "NB-2c: a layer's opacity set on the canvas.stack node's opened row, with Studio's GUI only. From File > New Project > Blank, the palette's Canvas, Show: Canvas and the output on present's + input (as canvas_layer_node_from_blank), + on the node puts a Rect on the stack and the centre of the viewport changes. The row's triangle opens it: the Opacity stage with the `rect_1.opacity` socket and the slider, and the document's layout keeps `open_rows`. The slider dragged from 100 % all the way left is one edit (opacity 0) and the rectangle leaves the centre; a double-click on it, 100 and Enter is one edit that writes no opacity, and the centre is the rectangle's again. The triangle closes the row and its stage and line-less socket go. Typed: the project folder and name, and the percent.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "timeout_ms": 10000, "visible": true},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "canvas_layer_opacity"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "timeout_ms": 10000, "missing": true},
    {"label": "the blank project's present is on the Frame Plan canvas", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "timeout_ms": 180000, "visible": true},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the Graph tab is in front", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the canvas can edit the new document", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "the domain filter has Canvas", "cmd": "wait", "name": "pelican.graphCanvasShow.canvas", "timeout_ms": 10000, "visible": true},
    {"label": "Add: the palette opens", "cmd": "click", "name": "pelican.graphCanvasAddNode"},
    {"label": "the palette is on screen", "cmd": "wait", "name": "pelican.graphCanvasPalette", "timeout_ms": 10000, "visible": true},
    {"label": "the canvas domain", "cmd": "select", "name": "pelican.graphCanvasPaletteDomain", "text": "canvas"},
    {"label": "the Canvas", "cmd": "select", "name": "pelican.graphCanvasPaletteList", "text": "Canvas   (canvas.output + canvas.stack)"},
    {"label": "Enter is OK", "cmd": "key", "name": "pelican.graphCanvasPaletteFilter", "sequence": "Return"},
    {"label": "the palette closed", "cmd": "wait", "name": "pelican.graphCanvasPalette", "timeout_ms": 10000, "missing": true},
    {"label": "the output is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#canvas", "timeout_ms": 120000, "visible": true},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "a stack with no layer", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers", "value": [], "retry_ms": 60000},
    {"label": "Show: Canvas", "cmd": "click", "name": "pelican.graphCanvasShow.canvas"},
    {"label": "the stack's body: its composite", "cmd": "wait", "name": "pelican.graphCanvasView::graph_stack_composite#canvas_stack", "timeout_ms": 60000, "visible": true},
    {"label": "and its + on the band", "cmd": "wait", "name": "pelican.graphCanvasView::graph_stack_add#canvas_stack", "timeout_ms": 60000, "visible": true},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "present's + input", "cmd": "wait", "name": "pelican.graphCanvasView::graph_derived_socket#present/in:+", "timeout_ms": 120000, "visible": true},
    {"label": "let it settle", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "zz-never-shown", "timeout_ms": 800, "expect_error": "automation.wait_timeout@1"},
    {"label": "the canvas's image onto present's + input", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#canvas/out:image"}, "to": {"name": "pelican.graphCanvasView::graph_derived_socket#present/in:+"}, "steps": 8},
    {"label": "present's inputs saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Pass inputs saved."},
    {"label": "the engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the empty canvas: remember the centre", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "remember": "empty"},
    {"label": "and a corner", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[1]", "remember": "corner"},
    {"label": "the node takes edits", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "+ on the node: its menu", "cmd": "click", "name": "pelican.graphCanvasView::graph_stack_add#canvas_stack"},
    {"label": "Rect", "cmd": "action", "name": "pelican.graphCanvas.layerAdd.rect"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "the layer on the stack", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers", "value": [{"input": "rect_1", "name": "Rect 1"}], "retry_ms": 60000},
    {"label": "its row on the node", "cmd": "wait", "name": "pelican.graphCanvasView::graph_stack_row#canvas_stack/rect_1", "timeout_ms": 60000, "visible": true},
    {"label": "the rectangle covers the centre", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "op": "ne", "value_of": "empty", "retry_ms": 60000},
    {"label": "remember it", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "remember": "rect"},
    {"label": "the node takes edits", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "the rectangle's row is closed: no stage", "cmd": "wait", "name": "pelican.graphCanvasView::graph_stack_stage#canvas_stack/rect_1", "timeout_ms": 10000, "missing": true},
    {"label": "its triangle opens the row", "cmd": "click", "name": "pelican.graphCanvasView::graph_stack_expand#canvas_stack/rect_1"},
    {"label": "the Opacity stage under it", "cmd": "wait", "name": "pelican.graphCanvasView::graph_stack_stage#canvas_stack/rect_1", "timeout_ms": 60000, "visible": true},
    {"label": "with the opacity's socket", "cmd": "wait", "name": "pelican.graphCanvasView::graph_socket#canvas_stack/in:rect_1.opacity", "timeout_ms": 10000, "visible": true},
    {"label": "and the slider", "cmd": "wait", "name": "pelican.graphCanvasView::graph_stack_opacity_field#canvas_stack/rect_1", "timeout_ms": 10000, "visible": true},
    {"label": "the document keeps the row open", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "layout.nodes.canvas_stack.open_rows", "value": ["rect_1"], "retry_ms": 60000},
    {"label": "let it settle", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "zz-never-shown", "timeout_ms": 800, "expect_error": "automation.wait_timeout@1"},
    {"label": "the slider dragged from 100 % past its left end (to the row's own socket)", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_stack_opacity_field#canvas_stack/rect_1"}, "to": {"name": "pelican.graphCanvasView::graph_socket#canvas_stack/rect_1"}, "steps": 12},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "one edit: the layer's opacity is 0", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers[0].opacity", "value": 0, "retry_ms": 60000},
    {"label": "the rectangle is gone from the centre", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "op": "ne", "value_of": "rect", "retry_ms": 60000},
    {"label": "the node takes edits", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "the slider is on the stage again", "cmd": "wait", "name": "pelican.graphCanvasView::graph_stack_opacity_field#canvas_stack/rect_1", "timeout_ms": 60000, "visible": true},
    {"label": "a double-click types the opacity", "cmd": "double_click", "name": "pelican.graphCanvasView::graph_stack_opacity_field#canvas_stack/rect_1"},
    {"label": "the field is open", "cmd": "wait", "name": "pelican.graphCanvasLayerOpacity", "timeout_ms": 10000, "visible": true},
    {"label": "100", "cmd": "type", "name": "pelican.graphCanvasLayerOpacity", "text": "100"},
    {"label": "Enter", "cmd": "key", "name": "pelican.graphCanvasLayerOpacity", "sequence": "Return"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "timeout_ms": 120000, "text": "Graph change saved."},
    {"label": "a hundred percent is the layer with no opacity written", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[0].parameters.layers", "value": [{"input": "rect_1", "name": "Rect 1"}], "retry_ms": 60000},
    {"label": "the centre is the rectangle's again", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[0]", "value_of": "rect", "retry_ms": 60000},
    {"label": "the node takes edits", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "timeout_ms": 120000, "enabled": true},
    {"label": "the triangle closes the row", "cmd": "click", "name": "pelican.graphCanvasView::graph_stack_expand#canvas_stack/rect_1"},
    {"label": "the stage is gone", "cmd": "wait", "name": "pelican.graphCanvasView::graph_stack_stage#canvas_stack/rect_1", "timeout_ms": 60000, "missing": true},
    {"label": "and the row's socket with no line with it", "cmd": "wait", "name": "pelican.graphCanvasView::graph_socket#canvas_stack/in:rect_1.opacity", "timeout_ms": 10000, "missing": true},
    {"label": "the corner is still empty", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/canvas.png", "pixels": [[0.5, 0.5], [0.04, 0.06]]}, "path": "pixels[1]", "value_of": "corner"},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "a picture of the Graph tab", "expect": "screenshot", "name": "pelican.graphCanvas", "path": "canvas_layer_opacity_graph.png"},
    {"label": "a picture of the window", "expect": "screenshot", "path": "canvas_layer_opacity_window.png"}
  ]
}
