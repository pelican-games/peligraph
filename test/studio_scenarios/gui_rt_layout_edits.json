{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "gui_rt_layout_edits",
  "description": "RTL-2s-c: the Ray layout section's taking away, with Studio's GUI only. The fixture (test/fixtures/studio_gui_rt_layout_edits) is a project as Enable hit groups leaves it, with a ray type, a hit group and a miss more than the task needs. A ray type moved up and back down (the layout's order), the extra hit group removed (its cells in the task with it, the confirmation counting the assignments that go), the second miss removed (the task's row with it), the shadow ray type removed: each one edit, the picture still drawn. Disable hit groups is offered once one hit group is left and the task's shaders have the files Enable made them from beside them: the layout comes out, the task goes back to the form without one, and the engine starts again to run it. Typed: nothing.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "start from the default layout", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "the engine runs the ray group layout", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "mode", "value": "layout", "retry_ms": 60000},
    {"label": "the picture: the middle is the cube, the corner the sky", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/start.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[1]", "remember": "sky", "retry_ms": 60000},
    {"label": "the cube is drawn", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/start.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[0]", "op": "ne", "value_of": "sky", "retry_ms": 60000},
    {"label": "the Rendering settings tab", "cmd": "action", "name": "pelican.view.renderTools.rendering_settings"},

    {"label": "RTL-2s decision 5: Acceleration structures... opens the scene's settings, the Task Editor's own", "cmd": "click", "name": "pelican.rayLayout.accelerationStructures"},
    {"label": "its window is on screen", "cmd": "wait", "name": "pelican.sceneAccelerationStructures", "visible": true, "timeout_ms": 30000},
    {"label": "a picture of it", "expect": "screenshot", "name": "pelican.sceneAccelerationStructures", "path": "gui_rt_layout_edits_acceleration.png"},
    {"label": "Escape closes it", "cmd": "key", "name": "pelican.sceneAccelerationStructures", "sequence": "Escape"},
    {"label": "closed", "cmd": "wait", "name": "pelican.sceneAccelerationStructures", "missing": true, "timeout_ms": 10000},

    {"label": "RTL-2s decision 6: the layout broken on disk, outside Studio (its last brace taken away)", "file": "replace", "path": "{project}/passes/ray_layout.json", "old": "\"record\": []\n}", "new": "\"record\": []\n"},
    {"label": "the Graph tab", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the Rendering settings tab again: the section reads the layout as it is now", "cmd": "action", "name": "pelican.view.renderTools.rendering_settings"},
    {"label": "it says the layout cannot be read", "cmd": "wait", "name": "pelican.rayLayout.state", "contains": "cannot be read", "timeout_ms": 60000},
    {"label": "Show the document is offered", "cmd": "wait", "name": "pelican.rayLayout.showDocument", "visible": true, "enabled": true, "timeout_ms": 10000},
    {"label": "a picture of the section", "expect": "screenshot", "name": "pelican.rayLayout", "path": "gui_rt_layout_edits_broken.png"},
    {"label": "Show the document", "cmd": "click", "name": "pelican.rayLayout.showDocument"},
    {"label": "its window is on screen", "cmd": "wait", "name": "pelican.renderDocumentDialog", "visible": true, "timeout_ms": 30000},
    {"label": "it reads the layout as it is on disk, and says it is not JSON yet", "cmd": "wait", "name": "pelican.renderDocumentDialog.notice", "contains": "Not valid JSON yet at line ", "timeout_ms": 30000},
    {"label": "to the end of the text", "cmd": "key", "name": "pelican.renderDocumentDialog.text", "sequence": "Ctrl+End"},
    {"label": "the } that was taken away, typed", "cmd": "type", "name": "pelican.renderDocumentDialog.text", "text": "}", "select_all": false},
    {"label": "it is JSON now", "cmd": "wait", "name": "pelican.renderDocumentDialog.notice", "contains": "Valid JSON", "timeout_ms": 10000},
    {"label": "Save: one restore_render_documents of the layout", "cmd": "click", "name": "pelican.renderDocumentDialog.save"},
    {"label": "the restore commits and the window closes", "cmd": "wait", "name": "pelican.renderDocumentDialog", "missing": true, "timeout_ms": 60000},
    {"label": "the engine reads the layout again", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "names.ray_types.$len", "value": 2, "retry_ms": 60000},
    {"label": "the file closes again (the line the brace was on stays empty)", "file": "contains", "path": "{project}/passes/ray_layout.json", "text": "\"record\": []\n\n}", "value": true},
    {"label": "nothing refused: the pipeline is ready", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready", "retry_ms": 60000},
    {"label": "the Graph tab", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the Rendering settings tab again", "cmd": "action", "name": "pelican.view.renderTools.rendering_settings"},

    {"label": "the Ray types table: shadow can move up", "cmd": "wait", "name": "pelican.rayLayout.rayType.shadow.up", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "Disable is not offered while two hit groups are there", "expect": "result", "command": {"cmd": "list", "pattern": "pelican.rayLayout.disable"}, "path": "widgets[0].enabled", "value": false},

    {"label": "shadow up", "cmd": "click", "name": "pelican.rayLayout.rayType.shadow.up"},
    {"label": "saved", "cmd": "wait", "name": "pelican.rayLayout.notice", "contains": "Saved: Move shadow.", "timeout_ms": 120000},
    {"label": "the layout's first ray type", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "names.ray_types[0]", "value": "shadow", "retry_ms": 30000},
    {"label": "the table is read again", "cmd": "wait", "name": "pelican.rayLayout.rayType.shadow.down", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "and back down", "cmd": "click", "name": "pelican.rayLayout.rayType.shadow.down"},
    {"label": "the layout's order as it was", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "names.ray_types[1]", "value": "shadow", "retry_ms": 60000},
    {"label": "nothing refused: the pipeline is ready", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready", "retry_ms": 60000},

    {"label": "the extra hit group's ×", "cmd": "wait", "name": "pelican.rayLayout.group.extra.remove", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "remove extra", "cmd": "click", "name": "pelican.rayLayout.group.extra.remove"},
    {"label": "the confirmation counts the assignments that go", "cmd": "wait", "name": "pelican.rayLayout.confirm.text", "contains": "0 assignment(s)", "timeout_ms": 30000},
    {"label": "OK", "cmd": "click", "name": "pelican.rayLayout.confirm.ok"},
    {"label": "saved", "cmd": "wait", "name": "pelican.rayLayout.notice", "contains": "Saved: Remove hit group extra.", "timeout_ms": 120000},
    {"label": "the layout's one hit group", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "names.groups.$len", "value": 1, "retry_ms": 30000},
    {"label": "the task's row has one cell", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.hit_shaders.primary.$len", "value": 1, "retry_ms": 30000},

    {"label": "miss_2's ×", "cmd": "wait", "name": "pelican.rayLayout.miss.miss_2.remove", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "remove miss_2", "cmd": "click", "name": "pelican.rayLayout.miss.miss_2.remove"},
    {"label": "the confirmation", "cmd": "wait", "name": "pelican.rayLayout.confirm.text", "contains": "PELICAN_MISS_miss_2", "timeout_ms": 30000},
    {"label": "OK", "cmd": "click", "name": "pelican.rayLayout.confirm.ok"},
    {"label": "saved", "cmd": "wait", "name": "pelican.rayLayout.notice", "contains": "Saved: Remove miss shader miss_2.", "timeout_ms": 120000},
    {"label": "the layout's one miss", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "names.misses.$len", "value": 1, "retry_ms": 30000},
    {"label": "the task's one miss", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.misses.$len", "value": 1, "retry_ms": 30000},

    {"label": "shadow's ×", "cmd": "wait", "name": "pelican.rayLayout.rayType.shadow.remove", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "remove shadow", "cmd": "click", "name": "pelican.rayLayout.rayType.shadow.remove"},
    {"label": "the confirmation", "cmd": "wait", "name": "pelican.rayLayout.confirm.text", "contains": "Remove ray type shadow?", "timeout_ms": 30000},
    {"label": "OK", "cmd": "click", "name": "pelican.rayLayout.confirm.ok"},
    {"label": "saved", "cmd": "wait", "name": "pelican.rayLayout.notice", "contains": "Saved: Remove ray type shadow.", "timeout_ms": 120000},
    {"label": "the layout's one ray type", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "names.ray_types.$len", "value": 1, "retry_ms": 30000},
    {"label": "nothing refused: the pipeline is ready", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready", "retry_ms": 60000},
    {"label": "the cube is still drawn", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/removed.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[0]", "op": "ne", "value_of": "sky", "retry_ms": 60000},

    {"label": "RTL-2s decision 4: the Frame Plan tab", "cmd": "action", "name": "pelican.view.renderTools.frame_plan"},
    {"label": "read the plan again", "cmd": "click", "name": "pelican.framePlanRefresh"},
    {"label": "its Physical plan", "cmd": "action", "name": "pelican.framePlan.tab.physical-plan"},
    {"label": "the hit groups' table lists the cube, from get_ray_occurrences", "cmd": "wait", "name": "pelican.framePlanPhysical::row#Cube", "visible": true, "timeout_ms": 60000},
    {"label": "and the floor", "cmd": "wait", "name": "pelican.framePlanPhysical::row#Floor", "visible": true, "timeout_ms": 10000},
    {"label": "a picture of the acceleration structures and the SBT rows", "expect": "screenshot", "name": "pelican.framePlanPhysical", "path": "gui_rt_layout_edits_sbt.png"},
    {"label": "the Rendering settings tab", "cmd": "action", "name": "pelican.view.renderTools.rendering_settings"},

    {"label": "Disable hit groups is offered now", "cmd": "wait", "name": "pelican.rayLayout.disable", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "the engine running before", "expect": "result", "command": {"cmd": "rpc", "method": "get_status", "params": {}}, "path": "result.instance_id", "remember": "engine_before"},
    {"label": "Disable hit groups", "cmd": "click", "name": "pelican.rayLayout.disable"},
    {"label": "the confirmation says the engine starts again", "cmd": "wait", "name": "pelican.rayLayout.confirm.text", "contains": "the engine starts again", "timeout_ms": 30000},
    {"label": "OK", "cmd": "click", "name": "pelican.rayLayout.confirm.ok"},
    {"label": "committed for the next start: the section says the engine starts again without the ray layout", "cmd": "wait", "name": "pelican.rayLayout.notice", "contains": "ray_layout_mode_changed", "timeout_ms": 120000},
    {"label": "the new engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "it is another engine", "expect": "result", "command": {"cmd": "rpc", "method": "get_status", "params": {}}, "path": "result.instance_id", "op": "ne", "value_of": "engine_before", "retry_ms": 120000},
    {"label": "it runs without a ray layout", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "mode", "value": "none", "retry_ms": 60000},
    {"label": "the root names none", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "layout", "value": null},
    {"label": "the task back in the form without one", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.closesthit", "value": "project://shaders/ray_tracing", "retry_ms": 60000},
    {"label": "the section offers Enable hit groups again", "cmd": "wait", "name": "pelican.rayLayout.enable", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "the cube is drawn", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.viewportHost", "mode": "screen", "path": "{artifacts}/disabled.png", "pixels": [[0.5, 0.5], [0.04, 0.04]]}, "path": "pixels[0]", "op": "ne", "value_of": "sky", "retry_ms": 120000},
    {"label": "a picture of the window", "expect": "screenshot", "path": "gui_rt_layout_edits_window.png"}
  ]
}
