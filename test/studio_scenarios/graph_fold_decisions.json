{
  "invariants": {
    "undo": "known_red",
    "undo_ticket": "QD1-R10"
  },
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "graph_fold_decisions",
  "description": "GL-3a, from File > New Project > Blank with Studio's GUI only. Two fullscreen passes chained on the Graph tab and the second onto present; both picked and folded into a group (Fold into group..., named fold_1 by Studio, no question). The group's heading says it is not verified, get_fold_groups lists it as unverified and the frame plan's diagnostics carry fold_unverified. Its Decisions add an Isolate by choosing the node in a combo (fold_nodes writes it into the root). Fold draws the group as one folded node and Open brings the nodes back -- only how it is looked at. GL-4a: Verify with Quick check runs verify_fold; the group comes back verified, its heading loses its words, the second pass's band says isolate (fold fold_1), its Decisions row says where the decision landed, and the frame plan's decision carries from_fold. Unfold, confirmed, deletes the group. Last, the Frame Plan's Resources row of the second pass's image takes No alias from its right-click entry (edit_target_planning) and the root's target_planning holds it. Typed: the project folder and name in New Project.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {"label": "the fixture's engine is up, so the switch to the new project is something that happens", "cmd": "wait_engine", "timeout_ms": 180000},
    {"label": "start from the default layout", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "File > New Project...", "cmd": "action", "name": "pelican.file.newProject"},
    {"label": "the dialog is on screen", "cmd": "wait", "name": "pelican.newProjectDialog", "visible": true, "timeout_ms": 10000},
    {"label": "the folder: this run's own artifacts", "cmd": "type", "name": "pelican.newProject.location", "text": "{artifacts}"},
    {"label": "the name", "cmd": "type", "name": "pelican.newProject.name", "text": "fold_a"},
    {"label": "the Blank pipeline template", "cmd": "select", "name": "pelican.newProject.template", "text": "Blank pipeline"},
    {"label": "Create", "cmd": "click", "name": "pelican.newProject.create"},
    {"label": "the dialog closed", "cmd": "wait", "name": "pelican.newProjectDialog", "missing": true, "timeout_ms": 10000},
    {"label": "the blank project's present is on the Frame Plan canvas", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#present", "visible": true, "timeout_ms": 180000},
    {"label": "the new engine answers and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the Graph tab is in front", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the canvas has read the new document and can edit it", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},

    {"label": "Add fullscreen pass: the first pass", "cmd": "action", "name": "pelican.graphCanvas.addFullscreenPass"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "the first pass is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_fullscreen", "visible": true, "timeout_ms": 60000},
    {"label": "pick it by its heading, so the second lands after it", "cmd": "click", "name": "pelican.graphCanvasView::graph_node_header#render_fullscreen"},
    {"label": "let the canvas settle (it reads the engine's shader list after an edit)", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "zz-never-shown", "timeout_ms": 2500, "expect_error": "automation.wait_timeout@1"},
    {"label": "the canvas takes input", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "visible": true, "enabled": true, "timeout_ms": 120000},
    {"label": "Add fullscreen pass: the second pass", "cmd": "action", "name": "pelican.graphCanvas.addFullscreenPass"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "auto layout", "cmd": "action", "name": "pelican.graphCanvas.autoLayout"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "the second pass offers its + input", "cmd": "wait", "name": "pelican.graphCanvasView::graph_socket#render_fullscreen_2/in:variadic", "visible": true, "timeout_ms": 120000},
    {"label": "the first pass's colour into the second's + input", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#render_fullscreen/out:color"}, "to": {"name": "pelican.graphCanvasView::graph_socket#render_fullscreen_2/in:variadic"}, "steps": 8},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Graph change saved.", "timeout_ms": 60000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "present offers an empty + input", "cmd": "wait", "name": "pelican.graphCanvasView::graph_derived_socket#present/in:+", "visible": true, "timeout_ms": 120000},
    {"label": "the second pass's colour onto present's + input", "cmd": "drag", "from": {"name": "pelican.graphCanvasView::graph_socket#render_fullscreen_2/out:color"}, "to": {"name": "pelican.graphCanvasView::graph_derived_socket#present/in:+"}, "steps": 8},
    {"label": "present's inputs saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "text": "Pass inputs saved.", "timeout_ms": 120000},
    {"label": "the engine has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "present reads the second pass", "expect": "rpc_equals", "method": "get_frame_plan", "params": {}, "path": "nodes[2].reads[0]", "value": "render_fullscreen_2__color", "retry_ms": 120000},
    {"label": "no fold group yet", "expect": "rpc_equals", "method": "get_fold_groups", "params": {}, "path": "fold_groups.$len", "value": 0},

    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "pick the first pass by its heading", "cmd": "click", "name": "pelican.graphCanvasView::graph_node_header#render_fullscreen"},
    {"label": "and the second, with Ctrl", "cmd": "click", "name": "pelican.graphCanvasView::graph_node_header#render_fullscreen_2", "modifiers": ["ctrl"]},
    {"label": "Fold into group... (no question; Studio names it)", "cmd": "action", "name": "pelican.graphCanvas.foldIntoGroup"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "Folded render_fullscreen, render_fullscreen_2 into fold_1", "timeout_ms": 120000},
    {"label": "the engine answers", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 10},
    {"label": "fold_nodes wrote the group: get_fold_groups lists it", "expect": "rpc_equals", "method": "get_fold_groups", "params": {}, "path": "fold_groups[0].group", "value": "fold_1", "retry_ms": 60000},
    {"label": "with both passes", "expect": "rpc_equals", "method": "get_fold_groups", "params": {}, "path": "fold_groups[0].nodes", "value": ["render_fullscreen", "render_fullscreen_2"]},
    {"label": "unverified: FG-2 is not there yet", "expect": "rpc_equals", "method": "get_fold_groups", "params": {}, "path": "fold_groups[0].state", "value": "unverified"},
    {"label": "the group's frame is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_fold_group#fold_1", "visible": true, "timeout_ms": 60000},
    {"label": "its heading says the decisions are not applied", "cmd": "wait", "name": "pelican.graphCanvasView::graph_fold_state#fold_1", "text": "not verified — decisions are not applied yet", "timeout_ms": 60000},
    {"label": "the group just made is picked: its Decisions say they are requests", "cmd": "wait", "name": "pelican.graphCanvasFold.note", "contains": "Decisions are requests", "timeout_ms": 60000},

    {"label": "Isolate: the node is chosen, not typed", "cmd": "select", "name": "pelican.graphCanvasFold.isolate.node", "text": "render_fullscreen_2"},
    {"label": "Add", "cmd": "click", "name": "pelican.graphCanvasFold.isolate.add"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "fold_1: decisions saved", "timeout_ms": 120000},
    {"label": "the row is listed", "cmd": "wait", "name": "pelican.graphCanvasFold.isolate.row0", "text": "render_fullscreen_2", "timeout_ms": 60000},
    {"label": "the root holds the decision in the group's own names", "expect": "result", "command": {"cmd": "rpc", "method": "get_render_documents", "params": {}}, "path": "result.documents[0].content", "op": "contains", "value": "\"isolate\"", "retry_ms": 30000},
    {"label": "still unverified", "expect": "rpc_equals", "method": "get_fold_groups", "params": {}, "path": "fold_groups[0].state", "value": "unverified"},

    {"label": "the Frame Plan tab", "cmd": "action", "name": "pelican.view.renderTools.frame_plan"},
    {"label": "the automatic plan read has finished", "cmd": "wait", "name": "pelican.framePlanRefresh", "enabled": true, "timeout_ms": 120000},
    {"label": "read the plan again", "cmd": "click", "name": "pelican.framePlanRefresh"},
    {"label": "its Raw JSON", "cmd": "action", "name": "pelican.framePlan.tab.raw-json"},
    {"label": "the plan's diagnostics carry fold_unverified (the decisions are not applied)", "cmd": "wait", "name": "pelican.framePlanRawJson", "contains": "fold_unverified", "timeout_ms": 120000},

    {"label": "the Graph tab", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "Fold: one folded node in place of the two", "cmd": "click", "name": "pelican.graphCanvasView::graph_fold_toggle#fold_1"},
    {"label": "the folded node is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#fold:fold_1", "visible": true, "timeout_ms": 30000},
    {"label": "the passes are not", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_fullscreen", "visible": false, "timeout_ms": 30000},
    {"label": "the line onto present is a row of the folded node", "cmd": "wait", "name": "pelican.graphCanvasView::graph_derived_socket#fold:fold_1/render_fullscreen_2.color", "visible": true, "timeout_ms": 30000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "a picture of the folded group", "expect": "screenshot", "path": "graph_fold_decisions_folded.png"},
    {"label": "the document did not change: still two nodes in the group", "expect": "rpc_equals", "method": "get_fold_groups", "params": {}, "path": "fold_groups[0].nodes.$len", "value": 2},
    {"label": "Open", "cmd": "click", "name": "pelican.graphCanvasView::graph_fold_toggle#fold_1"},
    {"label": "the folded node is gone", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#fold:fold_1", "missing": true, "timeout_ms": 30000},
    {"label": "the passes are back", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#render_fullscreen", "visible": true, "timeout_ms": 30000},
    {"label": "a picture of the open group", "expect": "screenshot", "path": "graph_fold_decisions_open.png"},

    {"label": "GL-4a: pick the group by its heading", "cmd": "click", "name": "pelican.graphCanvasView::graph_fold_heading#fold_1"},
    {"label": "its Decisions offer Verify", "cmd": "wait", "name": "pelican.graphCanvasFold.verify", "visible": true, "enabled": true, "timeout_ms": 30000},
    {"label": "Quick check (2 frames after 1 s)", "cmd": "click", "name": "pelican.graphCanvasFold.quickCheck"},
    {"label": "Verify", "cmd": "click", "name": "pelican.graphCanvasFold.verify"},
    {"label": "the heading counts the seconds", "cmd": "wait", "name": "pelican.graphCanvasView::graph_fold_state#fold_1", "contains": "verifying", "timeout_ms": 10000},
    {"label": "the engine's runs agree: verified", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "fold_1 verified", "timeout_ms": 600000},
    {"label": "get_fold_groups says verified", "expect": "rpc_equals", "method": "get_fold_groups", "params": {}, "path": "fold_groups[0].state", "value": "verified", "retry_ms": 30000},
    {"label": "the heading has no mark and no words any more", "cmd": "wait", "name": "pelican.graphCanvasView::graph_fold_state#fold_1", "missing": true, "timeout_ms": 60000},
    {"label": "the decision applies: the second pass's band says so", "cmd": "wait", "name": "pelican.graphCanvasView::graph_layer_band#render_fullscreen_2", "contains": "isolate (fold fold_1)", "timeout_ms": 120000},
    {"label": "and its Decisions row says where it landed", "cmd": "wait", "name": "pelican.graphCanvasFold.isolate.applied0", "text": "applied → render_fullscreen_2", "timeout_ms": 60000},
    {"label": "a picture of the verified group", "expect": "screenshot", "path": "graph_fold_decisions_verified.png"},
    {"label": "the Frame Plan tab", "cmd": "action", "name": "pelican.view.renderTools.frame_plan"},
    {"label": "the automatic plan read has finished", "cmd": "wait", "name": "pelican.framePlanRefresh", "enabled": true, "timeout_ms": 120000},
    {"label": "read the plan again", "cmd": "click", "name": "pelican.framePlanRefresh"},
    {"label": "its Raw JSON", "cmd": "action", "name": "pelican.framePlan.tab.raw-json"},
    {"label": "the plan's decision carries from_fold", "cmd": "wait", "name": "pelican.framePlanRawJson", "contains": "\"from_fold\": \"fold_1\"", "timeout_ms": 120000},
    {"label": "the Graph tab", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "pick the group by its heading", "cmd": "click", "name": "pelican.graphCanvasView::graph_fold_heading#fold_1"},
    {"label": "Unfold (delete group)", "cmd": "action", "name": "pelican.graphCanvas.unfoldGroup"},
    {"label": "it asks first", "cmd": "wait", "name": "pelican.graphCanvasFold.unfoldConfirm", "visible": true, "timeout_ms": 10000},
    {"label": "Unfold", "cmd": "click", "name": "pelican.graphCanvasFold.unfoldConfirm.ok"},
    {"label": "saved", "cmd": "wait", "name": "pelican.graphCanvasNotice", "contains": "Unfolded fold_1", "timeout_ms": 120000},
    {"label": "the group is gone", "expect": "rpc_equals", "method": "get_fold_groups", "params": {}, "path": "fold_groups.$len", "value": 0, "retry_ms": 60000},
    {"label": "and its frame", "cmd": "wait", "name": "pelican.graphCanvasView::graph_fold_group#fold_1", "missing": true, "timeout_ms": 60000},

    {"label": "the Frame Plan tab", "cmd": "action", "name": "pelican.view.renderTools.frame_plan"},
    {"label": "the automatic plan read has finished", "cmd": "wait", "name": "pelican.framePlanRefresh", "enabled": true, "timeout_ms": 120000},
    {"label": "read the plan again", "cmd": "click", "name": "pelican.framePlanRefresh"},
    {"label": "its Logical graph", "cmd": "action", "name": "pelican.framePlan.tab.logical-graph"},
    {"label": "the plan is read: the second pass is drawn", "cmd": "wait", "name": "pelican.framePlanLogicalView::node#render_fullscreen_2", "visible": true, "timeout_ms": 120000},
    {"label": "its Resources", "cmd": "action", "name": "pelican.framePlan.tab.resources"},
    {"label": "pick its row", "cmd": "select", "name": "pelican.framePlanResources", "text": "render_fullscreen_2__color"},
    {"label": "the row's No alias (its right-click entry)", "cmd": "action", "name": "pelican.framePlan.planning.noAlias"},
    {"label": "committed", "cmd": "wait", "name": "pelican.framePlanStatus", "contains": "No alias set on render_fullscreen_2__color.", "timeout_ms": 120000},
    {"label": "the root's target_planning holds it by its expanded name", "expect": "result", "command": {"cmd": "rpc", "method": "get_render_documents", "params": {}}, "path": "result.documents[0].content", "op": "contains", "value": "\"no_alias\": true", "retry_ms": 30000},
    {"label": "a picture of the window", "expect": "screenshot", "path": "graph_fold_decisions_window.png"}
  ]
}
