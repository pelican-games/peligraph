{
  "schema": "pelican.studio_scenario",
  "version": 1,
  "name": "deferred_loop_from_scratch",
  "description": "G-5, story B: a deferred material loop built from a Blank pipeline with Studio alone. New Project (F-2); a Cube turned about the vertical so two faces meet the camera, and a Plane made a floor, both with the Inspector (G-2). Add material pass... adds Deferred geometry with Create missing (five G-buffer targets and depth, G-1). New render target... makes lit_color (F-1); Add fullscreen pass... after the geometry, reading the five targets, with New... > Deferred lighting (G-3), which turns on Uses scene lights and Camera position. present reads lit_color through a Tone map shader. The light paints the two faces in different colours; turning the light in the Inspector changes them.",
  "tab": "frame_plan",
  "probe_no_automation": false,
  "steps": [
    {
      "label": "the fixture's engine is up, so the switch to the new project is something that happens",
      "cmd": "wait_engine",
      "timeout_ms": 180000
    },
    {
      "label": "start from the default layout: the panel layout is the desktop's, saved by whichever Studio closed last",
      "cmd": "action",
      "name": "pelican.layout.resetDefault"
    },
    {
      "label": "step 1: File > New Project...",
      "cmd": "action",
      "name": "pelican.file.newProject"
    },
    {
      "label": "the dialog is on screen",
      "cmd": "wait",
      "name": "pelican.newProjectDialog",
      "visible": true,
      "timeout_ms": 10000
    },
    {
      "label": "the folder: this run's own artifacts, never the repository",
      "cmd": "type",
      "name": "pelican.newProject.location",
      "text": "{artifacts}"
    },
    {
      "label": "the name",
      "cmd": "type",
      "name": "pelican.newProject.name",
      "text": "deferred_loop"
    },
    {
      "label": "the Blank pipeline template",
      "cmd": "select",
      "name": "pelican.newProject.template",
      "text": "Blank pipeline"
    },
    {
      "label": "Create",
      "cmd": "click",
      "name": "pelican.newProject.create"
    },
    {
      "label": "the dialog closed, because the template is on disk",
      "cmd": "wait",
      "name": "pelican.newProjectDialog",
      "missing": true,
      "timeout_ms": 10000
    },
    {
      "label": "the new project's frame plan has its one pass",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node#present",
      "visible": true,
      "timeout_ms": 180000
    },
    {
      "label": "the new engine answers editor RPC and has presented frames",
      "cmd": "wait_engine",
      "timeout_ms": 180000,
      "frames": 30
    },
    {
      "label": "before: present's gradient, read where the box will stand",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/before_gradient.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[0]",
      "remember": "gradient_middle"
    },
    {
      "label": "step 2: Add Object > Cube",
      "cmd": "action",
      "name": "pelican.outliner.addObject.cube"
    },
    {
      "label": "the engine has a third object, named Cube",
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects[2].name",
      "value": "Cube",
      "retry_ms": 60000
    },
    {
      "label": "the Inspector has read the Cube",
      "cmd": "wait",
      "name": "pelican.inspectorModelChoice",
      "text": "Cube (built-in)",
      "timeout_ms": 60000
    },
    {
      "label": "Add Object > Plane",
      "cmd": "action",
      "name": "pelican.outliner.addObject.plane"
    },
    {
      "label": "the engine has a fourth object, named Plane",
      "expect": "rpc_equals",
      "method": "scene_tree",
      "params": {
        "scene_id": "default_scene"
      },
      "path": "objects[3].name",
      "value": "Plane",
      "retry_ms": 60000
    },
    {
      "label": "the Plane is the one selected",
      "cmd": "wait",
      "name": "pelican.inspectorSelection",
      "contains": "Plane\n",
      "timeout_ms": 30000
    },
    {
      "label": "the Inspector has read the Plane",
      "cmd": "wait",
      "name": "pelican.inspectorModelChoice",
      "text": "Plane (built-in)",
      "timeout_ms": 60000
    },
    {
      "label": "its position is in the Inspector",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.pos.1",
      "visible": true,
      "timeout_ms": 30000
    },
    {
      "label": "let the Inspector settle",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "zz-never-shown",
      "timeout_ms": 1500,
      "expect_error": "automation.wait_timeout@1"
    },
    {
      "label": "the field is on screen and takes input",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.pos.1",
      "visible": true,
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "the floor: under the box",
      "cmd": "type",
      "name": "pelican.inspectorVector.transform.pos.1",
      "text": "-0.5"
    },
    {
      "label": "commit it",
      "cmd": "key",
      "name": "pelican.inspectorVector.transform.pos.1",
      "sequence": "Return"
    },
    {
      "label": "let the commit land",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "zz-never-shown",
      "timeout_ms": 1500,
      "expect_error": "automation.wait_timeout@1"
    },
    {
      "label": "the field holds the value",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.pos.1",
      "contains": "-0.5000",
      "timeout_ms": 30000
    },
    {
      "label": "let the Inspector settle",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "zz-never-shown",
      "timeout_ms": 1500,
      "expect_error": "automation.wait_timeout@1"
    },
    {
      "label": "the field is on screen and takes input",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.scale.0",
      "visible": true,
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "wide: scale x",
      "cmd": "type",
      "name": "pelican.inspectorVector.transform.scale.0",
      "text": "8"
    },
    {
      "label": "commit it",
      "cmd": "key",
      "name": "pelican.inspectorVector.transform.scale.0",
      "sequence": "Return"
    },
    {
      "label": "let the commit land",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "zz-never-shown",
      "timeout_ms": 1500,
      "expect_error": "automation.wait_timeout@1"
    },
    {
      "label": "the field holds the value",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.scale.0",
      "contains": "8.0000",
      "timeout_ms": 30000
    },
    {
      "label": "let the Inspector settle",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "zz-never-shown",
      "timeout_ms": 1500,
      "expect_error": "automation.wait_timeout@1"
    },
    {
      "label": "the field is on screen and takes input",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.scale.2",
      "visible": true,
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "and scale z",
      "cmd": "type",
      "name": "pelican.inspectorVector.transform.scale.2",
      "text": "8"
    },
    {
      "label": "commit it",
      "cmd": "key",
      "name": "pelican.inspectorVector.transform.scale.2",
      "sequence": "Return"
    },
    {
      "label": "let the commit land",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "zz-never-shown",
      "timeout_ms": 1500,
      "expect_error": "automation.wait_timeout@1"
    },
    {
      "label": "the field holds the value",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.scale.2",
      "contains": "8.0000",
      "timeout_ms": 30000
    },
    {
      "label": "pick the Cube in the Outliner",
      "cmd": "select",
      "name": "pelican.outliner",
      "text": "Cube"
    },
    {
      "label": "the Inspector holds the Cube",
      "cmd": "wait",
      "name": "pelican.inspectorSelection",
      "contains": "Cube\n",
      "timeout_ms": 30000
    },
    {
      "label": "the Cube's rotation is in the Inspector",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.rotation.1",
      "visible": true,
      "timeout_ms": 30000
    },
    {
      "label": "let the Inspector settle",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "zz-never-shown",
      "timeout_ms": 1500,
      "expect_error": "automation.wait_timeout@1"
    },
    {
      "label": "the field is on screen and takes input",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.rotation.1",
      "visible": true,
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "turn the box about the vertical: rotation 1",
      "cmd": "type",
      "name": "pelican.inspectorVector.transform.rotation.1",
      "text": "0.3827"
    },
    {
      "label": "commit it",
      "cmd": "key",
      "name": "pelican.inspectorVector.transform.rotation.1",
      "sequence": "Return"
    },
    {
      "label": "let the commit land",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "zz-never-shown",
      "timeout_ms": 1500,
      "expect_error": "automation.wait_timeout@1"
    },
    {
      "label": "the field holds the value",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.rotation.1",
      "contains": "0.3827",
      "timeout_ms": 30000
    },
    {
      "label": "let the Inspector settle",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "zz-never-shown",
      "timeout_ms": 1500,
      "expect_error": "automation.wait_timeout@1"
    },
    {
      "label": "the field is on screen and takes input",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.rotation.3",
      "visible": true,
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "turn the box about the vertical: rotation 3",
      "cmd": "type",
      "name": "pelican.inspectorVector.transform.rotation.3",
      "text": "0.9239"
    },
    {
      "label": "commit it",
      "cmd": "key",
      "name": "pelican.inspectorVector.transform.rotation.3",
      "sequence": "Return"
    },
    {
      "label": "let the commit land",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "zz-never-shown",
      "timeout_ms": 1500,
      "expect_error": "automation.wait_timeout@1"
    },
    {
      "label": "the field holds the value",
      "cmd": "wait",
      "name": "pelican.inspectorVector.transform.rotation.3",
      "contains": "0.9239",
      "timeout_ms": 30000
    },
    {
      "label": "step 3: Add material pass...",
      "cmd": "action",
      "name": "pelican.framePlan.addMaterialPass"
    },
    {
      "label": "the form is open",
      "cmd": "wait",
      "name": "pelican.materialPassForm.name",
      "visible": true,
      "timeout_ms": 60000
    },
    {
      "label": "Deferred geometry",
      "cmd": "select",
      "name": "pelican.materialPassForm.contract",
      "text": "Deferred geometry (G-buffer)"
    },
    {
      "label": "the pass is named after it, with nothing typed",
      "expect": "text_equals",
      "name": "pelican.materialPassForm.name",
      "value": "deferred_geometry"
    },
    {
      "label": "Create missing targets",
      "cmd": "click",
      "name": "pelican.materialPassForm.createMissing"
    },
    {
      "label": "the albedo output is a new gbuffer_albedo",
      "expect": "text_equals",
      "name": "pelican.materialPassForm.target.albedo",
      "value": "gbuffer_albedo"
    },
    {
      "label": "the normal output is a new gbuffer_normal",
      "expect": "text_equals",
      "name": "pelican.materialPassForm.target.normal",
      "value": "gbuffer_normal"
    },
    {
      "label": "the material output is a new gbuffer_material",
      "expect": "text_equals",
      "name": "pelican.materialPassForm.target.material",
      "value": "gbuffer_material"
    },
    {
      "label": "the world_position output is a new gbuffer_worldpos",
      "expect": "text_equals",
      "name": "pelican.materialPassForm.target.world_position",
      "value": "gbuffer_worldpos"
    },
    {
      "label": "the emissive output is a new gbuffer_emissive",
      "expect": "text_equals",
      "name": "pelican.materialPassForm.target.emissive",
      "value": "gbuffer_emissive"
    },
    {
      "label": "and the depth output a new scene_depth",
      "expect": "text_equals",
      "name": "pelican.materialPassForm.target.depth",
      "value": "scene_depth"
    },
    {
      "label": "a deferred pass takes deferred materials: no forward default is offered",
      "cmd": "wait",
      "name": "pelican.materialPassForm.forwardDefault",
      "visible": false,
      "timeout_ms": 10000
    },
    {
      "label": "Save: the six targets, then the pass",
      "cmd": "click",
      "name": "pelican.materialPassForm.ok"
    },
    {
      "label": "the form closed",
      "cmd": "wait",
      "name": "pelican.materialPassForm.name",
      "visible": false,
      "timeout_ms": 10000
    },
    {
      "label": "the engine runs deferred_geometry first",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[0].name",
      "value": "deferred_geometry",
      "retry_ms": 120000
    },
    {
      "label": "as a material pass of the deferred geometry contract",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[0].declaration.material_contract",
      "value": "deferred_geometry_v1"
    },
    {
      "label": "the automatic materials already go to a deferred pass: no restart was asked for",
      "expect": "result",
      "command": {
        "cmd": "text",
        "name": "pelican.viewportStatus"
      },
      "path": "text",
      "op": "excludes",
      "value": "Restarting the engine"
    },
    {
      "label": "step 4: New render target... for the lit colour",
      "cmd": "action",
      "name": "pelican.framePlan.newRenderTarget"
    },
    {
      "label": "the form is open",
      "cmd": "wait",
      "name": "pelican.renderTargetForm.name",
      "visible": true,
      "timeout_ms": 60000
    },
    {
      "label": "type only a name",
      "cmd": "type",
      "name": "pelican.renderTargetForm.name",
      "text": "lit_color"
    },
    {
      "label": "OK",
      "cmd": "click",
      "name": "pelican.renderTargetForm.ok"
    },
    {
      "label": "the engine declares lit_color",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "render_targets[6].name",
      "value": "lit_color",
      "retry_ms": 60000
    },
    {
      "label": "the new target is drawn as a node (the canvas turns to it)",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::resource_node#lit_color",
      "visible": true,
      "timeout_ms": 180000
    },
    {
      "label": "look at what reaches the screen",
      "cmd": "select",
      "name": "pelican.framePlanTarget",
      "text": "display"
    },
    {
      "label": "present is drawn",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node#present",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "fit the graph so the node can be picked",
      "cmd": "action",
      "name": "pelican.framePlan.fitView"
    },
    {
      "label": "pick present by its heading (detour: see the hole above)",
      "cmd": "click",
      "name": "pelican.framePlanLogicalView::node_header#present"
    },
    {
      "label": "Add fullscreen pass after it",
      "cmd": "action",
      "name": "pelican.framePlan.addFullscreenPass"
    },
    {
      "label": "the Pass Editor has the engine's authoring context",
      "cmd": "wait",
      "name": "pelican.fullscreenPass.authoringStatus",
      "contains": "graph(s)",
      "timeout_ms": 180000
    },
    {
      "label": "and the frame plan whose targets it offers",
      "cmd": "wait",
      "name": "pelican.fullscreenPass.planStatus",
      "contains": "resources",
      "timeout_ms": 180000
    },
    {
      "label": "input 0: gbuffer_albedo",
      "cmd": "select",
      "name": "pelican.fullscreenPass.inputTarget",
      "text": "gbuffer_albedo"
    },
    {
      "label": "added",
      "cmd": "click",
      "name": "pelican.fullscreenPass.addInput"
    },
    {
      "label": "input 1: gbuffer_normal",
      "cmd": "select",
      "name": "pelican.fullscreenPass.inputTarget",
      "text": "gbuffer_normal"
    },
    {
      "label": "added",
      "cmd": "click",
      "name": "pelican.fullscreenPass.addInput"
    },
    {
      "label": "input 2: gbuffer_material",
      "cmd": "select",
      "name": "pelican.fullscreenPass.inputTarget",
      "text": "gbuffer_material"
    },
    {
      "label": "added",
      "cmd": "click",
      "name": "pelican.fullscreenPass.addInput"
    },
    {
      "label": "input 3: gbuffer_worldpos",
      "cmd": "select",
      "name": "pelican.fullscreenPass.inputTarget",
      "text": "gbuffer_worldpos"
    },
    {
      "label": "added",
      "cmd": "click",
      "name": "pelican.fullscreenPass.addInput"
    },
    {
      "label": "input 4: gbuffer_emissive",
      "cmd": "select",
      "name": "pelican.fullscreenPass.inputTarget",
      "text": "gbuffer_emissive"
    },
    {
      "label": "added",
      "cmd": "click",
      "name": "pelican.fullscreenPass.addInput"
    },
    {
      "label": "write lit_color",
      "cmd": "select",
      "name": "pelican.fullscreenPass.colorTarget",
      "text": "lit_color"
    },
    {
      "label": "as colour output 0",
      "cmd": "click",
      "name": "pelican.fullscreenPass.addColor"
    },
    {
      "label": "New... beside the fragment stem",
      "cmd": "click",
      "name": "pelican.fullscreenPass.newFragmentShader"
    },
    {
      "label": "start from Deferred lighting",
      "cmd": "select",
      "name": "pelican.fullscreenPass.shaderTemplateKind",
      "text": "Deferred lighting"
    },
    {
      "label": "the inputs say what the shader reads them as",
      "cmd": "wait",
      "name": "pelican.fullscreenPass.inputRoles",
      "contains": "3 world position",
      "timeout_ms": 10000
    },
    {
      "label": "Uses scene lights and Camera position are on: the pass asks for the camera position",
      "expect": "text_equals",
      "name": "pelican.fullscreenPass.pushConstants",
      "value": "Camera position"
    },
    {
      "label": "the pass is named after what it is",
      "expect": "text_equals",
      "name": "pelican.fullscreenPass.name",
      "value": "deferred_lighting"
    },
    {
      "label": "create the shader",
      "cmd": "click",
      "name": "pelican.fullscreenPass.createFragmentShader"
    },
    {
      "label": "the fragment field holds its stem",
      "expect": "text_equals",
      "name": "pelican.fullscreenPass.shader.fragment",
      "value": "project://shaders/deferred_lighting"
    },
    {
      "label": "the shader reads the world position at input 3",
      "file": "contains",
      "path": "{artifacts}/deferred_loop/shaders/deferred_lighting.frag",
      "text": "PELICAN_DECLARE_INPUT_3(in_gbuffer_worldpos);  // gbuffer_worldpos: world position",
      "value": true
    },
    {
      "label": "Save is ready",
      "cmd": "wait",
      "name": "pelican.fullscreenPass.save",
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "save the pass",
      "cmd": "click",
      "name": "pelican.fullscreenPass.save"
    },
    {
      "label": "the engine has deferred_lighting, declared after present",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[2].name",
      "value": "deferred_lighting",
      "retry_ms": 180000
    },
    {
      "label": "with the scene lights",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[2].declaration.uses_light_data",
      "value": true,
      "retry_ms": 60000
    },
    {
      "label": "File > Save Scene before the detour reopens the project",
      "cmd": "action",
      "name": "pelican.file.saveScene"
    },
    {
      "label": "the save is done",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "Scene saved",
      "timeout_ms": 60000
    },
    {
      "label": "DETOUR: the lighting pass's fragment, edited in the author's own editor: before present",
      "file": "replace",
      "path": "{artifacts}/deferred_loop/passes/authoring/pass-cb9d40e82793d443cfcb.json",
      "old": "\"insert\": \"after:present\"",
      "new": "\"insert\": \"before:present\""
    },
    {
      "label": "DETOUR: open another project, so the next open reads the fragment again",
      "cmd": "open_project",
      "dir": "{other_project}"
    },
    {
      "label": "that engine answers",
      "cmd": "wait_engine",
      "timeout_ms": 180000
    },
    {
      "label": "DETOUR: open the deferred project again",
      "cmd": "open_project",
      "dir": "{artifacts}/deferred_loop"
    },
    {
      "label": "the re-read engine answers and has presented frames",
      "cmd": "wait_engine",
      "timeout_ms": 180000,
      "frames": 30
    },
    {
      "label": "deferred_lighting now runs between the geometry and present",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[1].name",
      "value": "deferred_lighting",
      "retry_ms": 180000
    },
    {
      "label": "the canvas has present again",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node#present",
      "visible": true,
      "timeout_ms": 180000
    },
    {
      "label": "step 5: look at what reaches the screen",
      "cmd": "select",
      "name": "pelican.framePlanTarget",
      "text": "display"
    },
    {
      "label": "fit the graph so present can be picked",
      "cmd": "action",
      "name": "pelican.framePlan.fitView"
    },
    {
      "label": "present is drawn",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node#present",
      "visible": true,
      "timeout_ms": 60000
    },
    {
      "label": "open present in the Pass Editor by its heading",
      "cmd": "double_click",
      "name": "pelican.framePlanLogicalView::node_header#present"
    },
    {
      "label": "the Pass Editor holds present",
      "cmd": "wait",
      "name": "pelican.fullscreenPass.name",
      "text": "present",
      "timeout_ms": 60000
    },
    {
      "label": "present reads lit_color",
      "cmd": "select",
      "name": "pelican.fullscreenPass.inputTarget",
      "text": "lit_color"
    },
    {
      "label": "as input 0",
      "cmd": "click",
      "name": "pelican.fullscreenPass.addInput"
    },
    {
      "label": "New... beside the fragment stem",
      "cmd": "click",
      "name": "pelican.fullscreenPass.newFragmentShader"
    },
    {
      "label": "start from Tone map",
      "cmd": "select",
      "name": "pelican.fullscreenPass.shaderTemplateKind",
      "text": "Tone map"
    },
    {
      "label": "present already reads shaders/present.frag, so the new shader gets a name of its own, with nothing typed",
      "expect": "text_equals",
      "name": "pelican.fullscreenPass.shaderTemplateName",
      "value": "present_tone_map"
    },
    {
      "label": "create the shader",
      "cmd": "click",
      "name": "pelican.fullscreenPass.createFragmentShader"
    },
    {
      "label": "the fragment field holds its stem",
      "expect": "text_equals",
      "name": "pelican.fullscreenPass.shader.fragment",
      "value": "project://shaders/present_tone_map"
    },
    {
      "label": "the shader reads lit_color as the scene colour",
      "file": "contains",
      "path": "{artifacts}/deferred_loop/shaders/present_tone_map.frag",
      "text": "PELICAN_DECLARE_INPUT_0(in_lit_color);  // lit_color: scene colour",
      "value": true
    },
    {
      "label": "the gradient present had is still on disk: New... does not overwrite",
      "file": "contains",
      "path": "{artifacts}/deferred_loop/shaders/present.frag",
      "text": "outColor = vec4(inUV.x, inUV.y, 0.5, 1.0);",
      "value": true
    },
    {
      "label": "Save is ready",
      "cmd": "wait",
      "name": "pelican.fullscreenPass.save",
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "save present: edit_preset_pass on the root",
      "cmd": "click",
      "name": "pelican.fullscreenPass.save"
    },
    {
      "label": "the root's present reads lit_color",
      "expect": "rpc_equals",
      "method": "get_render_authoring_context",
      "params": {},
      "path": "graphs[0].passes[2].root_declaration.input[0]",
      "value": "lit_color",
      "retry_ms": 120000
    },
    {
      "label": "close the Pass Editor (View > Panels) to look at the viewport",
      "cmd": "action",
      "name": "pelican.view.panels.fullscreenPassDock"
    },
    {
      "label": "the canvas draws the read",
      "cmd": "wait",
      "name": "pelican.framePlanLogicalView::node_socket#present/in:lit_color",
      "visible": true,
      "timeout_ms": 120000
    },
    {
      "label": "pick the camera in the Outliner, so no gizmo is drawn over the box",
      "cmd": "select",
      "name": "pelican.outliner",
      "text": "MainCamera"
    },
    {
      "label": "the Inspector holds the camera",
      "cmd": "wait",
      "name": "pelican.inspectorSelection",
      "contains": "MainCamera\n",
      "timeout_ms": 30000
    },
    {
      "label": "the viewport holds a shape, not the gradient's thousands of colours",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_deferred.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "distinct_colors",
      "op": "le",
      "value": 64,
      "retry_ms": 120000
    },
    {
      "label": "the background, read above the box",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_deferred.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[2]",
      "remember": "background"
    },
    {
      "label": "one face of the turned box",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_deferred.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[3]",
      "remember": "face_left"
    },
    {
      "label": "the light paints the two faces differently",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_deferred.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[4]",
      "op": "ne",
      "value_of": "face_left"
    },
    {
      "label": "the lit face is not the background",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_deferred.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[4]",
      "op": "ne",
      "value_of": "background"
    },
    {
      "label": "the right face, as the light paints it now",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step5_deferred.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[4]",
      "remember": "face_right"
    },
    {
      "label": "a picture of the window after step 5",
      "expect": "screenshot",
      "path": "step5_window.png"
    },
    {
      "label": "step 6: pick the light in the Outliner",
      "cmd": "select",
      "name": "pelican.outliner",
      "text": "KeyLight"
    },
    {
      "label": "the Inspector shows its direction",
      "cmd": "wait",
      "name": "pelican.inspectorVector.light.direction.0",
      "visible": true,
      "timeout_ms": 60000
    },
    {
      "label": "let the Inspector settle",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "zz-never-shown",
      "timeout_ms": 1500,
      "expect_error": "automation.wait_timeout@1"
    },
    {
      "label": "the field is on screen and takes input",
      "cmd": "wait",
      "name": "pelican.inspectorVector.light.direction.0",
      "visible": true,
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "turn the light: the other side of the box",
      "cmd": "type",
      "name": "pelican.inspectorVector.light.direction.0",
      "text": "0.5"
    },
    {
      "label": "commit it",
      "cmd": "key",
      "name": "pelican.inspectorVector.light.direction.0",
      "sequence": "Return"
    },
    {
      "label": "let the commit land",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "zz-never-shown",
      "timeout_ms": 1500,
      "expect_error": "automation.wait_timeout@1"
    },
    {
      "label": "the field holds the value",
      "cmd": "wait",
      "name": "pelican.inspectorVector.light.direction.0",
      "contains": "0.5000",
      "timeout_ms": 30000
    },
    {
      "label": "the face the light left changes colour",
      "expect": "result",
      "command": {
        "cmd": "screenshot",
        "name": "pelican.viewportHost",
        "mode": "screen",
        "path": "{artifacts}/step6_deferred.png",
        "pixels": [
          [
            0.5,
            0.5
          ],
          [
            0.5,
            0.92
          ],
          [
            0.5,
            0.06
          ],
          [
            0.46,
            0.5
          ],
          [
            0.54,
            0.5
          ]
        ]
      },
      "path": "pixels[4]",
      "op": "ne",
      "value_of": "face_right",
      "retry_ms": 60000
    },
    {
      "label": "the Inspector is idle",
      "cmd": "wait",
      "name": "pelican.inspectorRefresh",
      "enabled": true,
      "timeout_ms": 60000
    },
    {
      "label": "File > Save Scene, so closing Studio has nothing to ask",
      "cmd": "action",
      "name": "pelican.file.saveScene"
    },
    {
      "label": "the save is done",
      "cmd": "wait",
      "name": "pelican.inspectorNotice",
      "contains": "Scene saved",
      "timeout_ms": 60000
    },
    {
      "label": "a picture of the window after step 6",
      "expect": "screenshot",
      "path": "step6_window.png"
    }
  ]
}
