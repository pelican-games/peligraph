{
  "schema": "pelican.studio_scenario", "version": 1,
  "name": "gui_rt_checks",
  "description": "RTL-3s: the ray tracing operations Studio had only unit tests for, done on the real window and engine. The fixture (test/fixtures/studio_gui_rt_checks) has a cube and a procedural ball, a ray group layout of two ray types (primary, shadow), two hit groups (mesh, ball procedural), two misses, the engine's record and a record field value, and a task `trace` that traces primary only and calls a callable through a callable record. Decision 5 (engine EB-3): the Graph's shadow check makes a whole row in shadow's own payload -- the template's closest hits, which declare no record, written for it -- and the pipeline takes it; unchecked, the row goes in the same edit; checked again, the same files. Decision 6: a cell's shader replaced by one whose record is not the layout's is refused, and the sentence names that shader and what to do, from the refusal's fields, with the cell red; the same shader saved into the root outside Studio is a Problems row whose click opens the task with the same cell red. Decision 3 / 7: a procedural asset's record value changed and taken back with Edit > Undo Render Edit (the engine restores asset data by digest), forward again with Redo; the engine record's geometry_kind checked (the hit shader's Studio block written again); the record field removed and put back with one Undo. The Callable records dialog opened from the Graph and one value changed. The Frame Plan lists the named TLAS's BLAS. Typed: the callable record's value in the Records dialog.",
  "tab": "graph",
  "probe_no_automation": false,
  "invariants": {
    "log_allow": [
      {
        "pattern": "LOG_ERROR\\s+pelican\\s+Failed to load main rendering configuration: pelican\\.ray_tracing\\.shader_record_abi_mismatch@1: shader .*wrong_record\\.rchit",
        "reason": "The wrong_record shader is deliberately rejected both through editing and external reload; the scenario then restores the valid shader."
      }
    ],
    "undo_exempt": [
      {
        "path": "render:passes/main_rendering_config.json",
        "reason": "The scenario rewrites the root graph outside Studio with wrong_record and repairs it through the UI. The disk document is excluded as an external write; this is its RPC view. Asset-data and shader Undo checks remain enabled."
      }
    ]
  },
  "steps": [
    {"label": "the fixture's engine is up and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "start from the default layout", "cmd": "action", "name": "pelican.layout.resetDefault"},
    {"label": "the engine runs the ray group layout", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "mode", "value": "layout", "retry_ms": 60000},
    {"label": "nothing refused at start", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready", "retry_ms": 60000},
    {"label": "the Graph tab is in front", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "the canvas can edit", "cmd": "wait", "name": "pelican.graphCanvasAddNode", "enabled": true, "timeout_ms": 120000},
    {"label": "the trace task is drawn", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#trace", "visible": true, "timeout_ms": 60000},
    {"label": "fit", "cmd": "action", "name": "pelican.graphCanvas.fitView"},
    {"label": "pick trace", "cmd": "click", "name": "pelican.graphCanvasView::graph_node#trace"},
    {"label": "its ray tracing section: a check per ray type", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.traced.shadow", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "no shadow row while shadow is not traced", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.hit.shadow.mesh.closesthit", "missing": true, "timeout_ms": 10000},

    {"label": "decision 5: trace shadow", "cmd": "click", "name": "pelican.graphCanvasRayTracing.traced.shadow"},
    {"label": "the section says which closest hits it wrote for it", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.notice", "contains": "shadow's hit shaders are written from the template: shaders/shadow_mesh.rchit, shaders/shadow_ball.rchit.", "timeout_ms": 10000},
    {"label": "the engine has it: shadow traced", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.traced_ray_types[1]", "value": "shadow", "retry_ms": 120000},
    {"label": "its row whole in one edit: the mesh cell's closest hit", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.hit_shaders.shadow.mesh.closesthit", "value": "project://shaders/shadow_mesh"},
    {"label": "the ball's", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.hit_shaders.shadow.ball.closesthit", "value": "project://shaders/shadow_ball"},
    {"label": "with the ball's intersection kept", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.hit_shaders.shadow.ball.intersection", "value": "project://shaders/ball"},
    {"label": "written in the shadow ray type's payload", "file": "contains", "path": "{project}/shaders/shadow_mesh.rchit", "text": "layout(location = 1) rayPayloadInEXT float occluded;", "value": true},
    {"label": "it reads no record, so it declares none (engine EB-3)", "file": "contains", "path": "{project}/shaders/shadow_mesh.rchit", "text": "shaderRecordEXT", "value": false},
    {"label": "the engine takes the row: nothing refused", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready", "retry_ms": 60000},
    {"label": "the engine lists no problem", "expect": "rpc_equals", "method": "get_problems", "params": {}, "path": "problems.$len", "value": 0, "retry_ms": 30000},
    {"label": "the shadow row's cell is in the grid", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.hit.shadow.mesh.closesthit", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "the raygen's second ray is offered", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.traceSecond", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "Trace shadow toward the light", "cmd": "click", "name": "pelican.graphCanvasRayTracing.traceSecond"},
    {"label": "the raygen's switch is on", "file": "contains", "path": "{project}/shaders/start.rgen", "text": "#define TRACE_SECOND_RAY_TYPE 1", "value": true},
    {"label": "decision 4: Edit > Undo Render Edit takes the switch back", "cmd": "action", "name": "pelican.edit.undoRenderEdit"},
    {"label": "the raygen's switch is off again", "file": "contains", "path": "{project}/shaders/start.rgen", "text": "#define TRACE_SECOND_RAY_TYPE 0", "value": true},
    {"label": "Edit > Redo Render Edit", "cmd": "action", "name": "pelican.edit.redoRenderEdit"},
    {"label": "on again", "file": "contains", "path": "{project}/shaders/start.rgen", "text": "#define TRACE_SECOND_RAY_TYPE 1", "value": true},
    {"label": "the shadow ray answers in the template's payload: nothing refused", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready", "retry_ms": 60000},
    {"label": "the engine has presented frames with it", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "and lists no problem", "expect": "rpc_equals", "method": "get_problems", "params": {}, "path": "problems.$len", "value": 0, "retry_ms": 30000},
    {"label": "the switch takes input again", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.traceSecond", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "it reads the raygen on disk: checked", "expect": "result", "command": {"cmd": "list", "pattern": "pelican.graphCanvasRayTracing.traceSecond"}, "path": "widgets[0].checked", "value": true, "retry_ms": 30000},
    {"label": "its switch off again", "cmd": "click", "name": "pelican.graphCanvasRayTracing.traceSecond"},
    {"label": "the raygen's switch is off", "file": "contains", "path": "{project}/shaders/start.rgen", "text": "#define TRACE_SECOND_RAY_TYPE 0", "value": true},
    {"label": "the engine compiled it again and has presented frames", "cmd": "wait_engine", "timeout_ms": 180000, "frames": 30},
    {"label": "the section read the raygen again: the switch unchecked", "expect": "result", "command": {"cmd": "list", "pattern": "pelican.graphCanvasRayTracing.traceSecond"}, "path": "widgets[0].checked", "value": false, "retry_ms": 30000},
    {"label": "the shadow check takes input (the raygen's reload is through)", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.traced.shadow", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "untrace shadow", "cmd": "click", "name": "pelican.graphCanvasRayTracing.traced.shadow"},
    {"label": "the engine has one traced ray type", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.traced_ray_types.$len", "value": 1, "retry_ms": 120000},
    {"label": "and shadow's row went in the same edit (hit_shader_untraced otherwise)", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.hit_shaders.$len", "value": 1},
    {"label": "nothing refused", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready", "retry_ms": 60000},
    {"label": "the shadow check is read again", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.hit.shadow.mesh.closesthit", "missing": true, "timeout_ms": 60000},
    {"label": "the shadow check takes input (the raygen's reload is through)", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.traced.shadow", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "trace shadow again", "cmd": "click", "name": "pelican.graphCanvasRayTracing.traced.shadow"},
    {"label": "the same closest hit", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.hit_shaders.shadow.mesh.closesthit", "value": "project://shaders/shadow_mesh", "retry_ms": 120000},
    {"label": "the file that holds the template already is used: no second one", "file": "exists", "path": "{project}/shaders/shadow_mesh_2.rchit", "value": false},

    {"label": "decision 6: the shadow x mesh cell is read again", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.hit.shadow.mesh.closesthit", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "the ball cell's border before: its green", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.graphCanvasRayTracing.hit.shadow.ball.closesthit", "path": "{artifacts}/ball_cell.png", "pixels": [[0.0, 0.5]]}, "path": "rgb[0][1]", "remember": "ball_green"},
    {"label": "the ball cell's border is not red: its red is near its green", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.graphCanvasRayTracing.hit.shadow.ball.closesthit", "path": "{artifacts}/ball_cell.png", "pixels": [[0.0, 0.5]]}, "path": "rgb[0][0]", "op": "lt", "value_of": "ball_green", "plus": 40},
    {"label": "the cell's shader: one whose record is not the layout's", "cmd": "select", "name": "pelican.graphCanvasRayTracing.hit.shadow.mesh.closesthit", "text": "project://shaders/wrong_record"},
    {"label": "refused: the section names the shader and what to do, from the refusal's fields", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.problem", "contains": "Shader shaders/wrong_record.rchit declares a shader record that is not the ray group layout's: declare its fields in order (material_index u32, geometry_index u32, value f32), or take the shaderRecordEXT declaration out", "timeout_ms": 120000},
    {"label": "and the cell", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.problem", "contains": "(ray type shadow, hit group mesh, stage closesthit)", "timeout_ms": 10000},
    {"label": "the engine kept the cell as it was", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "nodes[1].parameters.ray_tracing.hit_shaders.shadow.mesh.closesthit", "value": "project://shaders/shadow_mesh"},
    {"label": "the refused cell is red", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.graphCanvasRayTracing.hit.shadow.mesh.closesthit", "path": "{artifacts}/refused_cell.png", "pixels": [[0.0, 0.5]]}, "path": "rgb[0][0]", "op": "gt", "value": 180},
    {"label": "red, not grey", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.graphCanvasRayTracing.hit.shadow.mesh.closesthit", "path": "{artifacts}/refused_cell.png", "pixels": [[0.0, 0.5]]}, "path": "rgb[0][1]", "op": "lt", "value": 110},
    {"label": "the ball cell is not", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.graphCanvasRayTracing.hit.shadow.ball.closesthit", "path": "{artifacts}/ball_cell_after.png", "pixels": [[0.0, 0.5]]}, "path": "rgb[0][0]", "op": "lt", "value_of": "ball_green", "plus": 40},
    {"label": "a picture of the Graph with the refused cell", "expect": "screenshot", "name": "pelican.graphCanvas", "path": "gui_rt_checks_refused_cell.png"},
    {"label": "nothing refused in the engine: it draws the edit before", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready"},

    {"label": "decision 6: View > Problems", "cmd": "action", "name": "pelican.view.problems"},
    {"label": "nothing listed", "cmd": "wait", "name": "pelican.problems.count", "text": "No problems", "timeout_ms": 30000},
    {"label": "the same shader saved into the root outside Studio", "file": "replace", "path": "{project}/passes/main_rendering_config.json", "old": "\"closesthit\": \"project://shaders/shadow_mesh\"", "new": "\"closesthit\": \"project://shaders/wrong_record\""},
    {"label": "Studio's reload is refused: one row", "cmd": "wait", "name": "pelican.problems.count", "text": "1 error", "timeout_ms": 60000},
    {"label": "the engine lists the record's refusal", "expect": "rpc_equals", "method": "get_problems", "params": {}, "path": "problems[0].code", "value": "pelican.ray_tracing.shader_record_abi_mismatch@1"},
    {"label": "with its fields: the stage", "expect": "rpc_equals", "method": "get_problems", "params": {}, "path": "problems[0].fields.stage", "value": "closesthit"},
    {"label": "the Graph tab behind, so the click is what brings it", "cmd": "action", "name": "pelican.view.renderTools.frame_plan"},
    {"label": "a click on the row", "cmd": "select", "name": "pelican.problems.list", "index": 0},
    {"label": "the row says the shader and what to do", "cmd": "wait", "name": "pelican.problems.detail", "contains": "Shader shaders/wrong_record.rchit declares a shader record that is not the ray group layout's", "timeout_ms": 10000},
    {"label": "the Graph shows the task", "cmd": "wait", "name": "pelican.graphCanvasView::graph_node#trace", "visible": true, "timeout_ms": 60000},
    {"label": "its section says where", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.problem", "contains": "(ray type shadow, hit group mesh, stage closesthit)", "timeout_ms": 60000},
    {"label": "the same cell is red", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.graphCanvasRayTracing.hit.shadow.mesh.closesthit", "path": "{artifacts}/problem_cell.png", "pixels": [[0.0, 0.5]]}, "path": "rgb[0][0]", "op": "gt", "value": 180, "retry_ms": 10000},
    {"label": "red, not grey", "expect": "result", "command": {"cmd": "screenshot", "name": "pelican.graphCanvasRayTracing.hit.shadow.mesh.closesthit", "path": "{artifacts}/problem_cell.png", "pixels": [[0.0, 0.5]]}, "path": "rgb[0][1]", "op": "lt", "value": 110},
    {"label": "a picture of the window with the row and the cell", "expect": "screenshot", "path": "gui_rt_checks_problem_cell.png"},
    {"label": "fixed where the row led: the cell's shader back to shadow_mesh, an edit on the saved version", "cmd": "select", "name": "pelican.graphCanvasRayTracing.hit.shadow.mesh.closesthit", "text": "project://shaders/shadow_mesh"},
    {"label": "the engine takes it and publishes it: the reads are live again", "expect": "rpc_equals", "method": "get_graph_instances", "params": {}, "path": "live", "value": true, "retry_ms": 60000},
    {"label": "the row goes", "cmd": "wait", "name": "pelican.problems.count", "text": "No problems", "timeout_ms": 60000},
    {"label": "the engine runs it", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready", "retry_ms": 60000},

    {"label": "decision 3: the Rendering settings tab", "cmd": "action", "name": "pelican.view.renderTools.rendering_settings"},
    {"label": "the ball's record value field", "cmd": "wait", "name": "pelican.rayLayout.assignProcedural.ball.record.value", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "the engine has 0", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "selectable_procedural_assets[0].record_fields.value", "value": 0.0},
    {"label": "one step up", "cmd": "key", "name": "pelican.rayLayout.assignProcedural.ball.record.value", "sequence": "Up"},
    {"label": "the asset's record holds 1", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "selectable_procedural_assets[0].record_fields.value", "value": 1.0, "retry_ms": 60000},
    {"label": "the section has no Undo of its own any more", "cmd": "wait", "name": "pelican.rayLayout.undo", "missing": true, "timeout_ms": 5000},
    {"label": "Edit > Undo Render Edit", "cmd": "action", "name": "pelican.edit.undoRenderEdit"},
    {"label": "the engine restored the asset data: 0 again", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "selectable_procedural_assets[0].record_fields.value", "value": 0.0, "retry_ms": 60000},
    {"label": "Edit > Redo Render Edit", "cmd": "action", "name": "pelican.edit.redoRenderEdit"},
    {"label": "1 again", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "selectable_procedural_assets[0].record_fields.value", "value": 1.0, "retry_ms": 60000},
    {"label": "nothing refused", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready", "retry_ms": 60000},

    {"label": "decision 7: the engine record's geometry_kind", "cmd": "wait", "name": "pelican.rayLayout.engineRecord.geometry_kind", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "check it", "cmd": "click", "name": "pelican.rayLayout.engineRecord.geometry_kind"},
    {"label": "the layout's engine record has it", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "names.engine_record[2]", "value": "geometry_kind", "retry_ms": 60000},
    {"label": "the closest hit's Studio block is written again", "file": "contains", "path": "{project}/shaders/start.rchit", "text": "The engine's fields (engine_record), then the layout's own", "value": true},
    {"label": "nothing refused", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready", "retry_ms": 60000},
    {"label": "the record field value's ×", "cmd": "wait", "name": "pelican.rayLayout.record.value.remove", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "remove it", "cmd": "click", "name": "pelican.rayLayout.record.value.remove"},
    {"label": "the confirmation", "cmd": "wait", "name": "pelican.rayLayout.confirm.text", "contains": "Remove record field value?", "timeout_ms": 30000},
    {"label": "OK", "cmd": "click", "name": "pelican.rayLayout.confirm.ok"},
    {"label": "saved", "cmd": "wait", "name": "pelican.rayLayout.notice", "contains": "Saved: ", "timeout_ms": 120000},
    {"label": "the layout has no record field", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "names.record.$len", "value": 0, "retry_ms": 60000},
    {"label": "the ball's record went with it", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "selectable_procedural_assets[0].record_fields.$len", "value": 0},
    {"label": "the closest hit's block no longer declares it", "file": "contains", "path": "{project}/shaders/start.rchit", "text": "    float value;", "value": false},
    {"label": "nothing refused", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready", "retry_ms": 60000},
    {"label": "Edit > Undo Render Edit", "cmd": "action", "name": "pelican.edit.undoRenderEdit"},
    {"label": "the record field is back", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "names.record[0].name", "value": "value", "retry_ms": 60000},
    {"label": "and the ball's value with it", "expect": "rpc_equals", "method": "get_ray_layout", "params": {}, "path": "selectable_procedural_assets[0].record_fields.value", "value": 1.0, "retry_ms": 60000},
    {"label": "and the block declares it again", "file": "contains", "path": "{project}/shaders/start.rchit", "text": "    float value;", "value": true},
    {"label": "nothing refused", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready", "retry_ms": 60000},

    {"label": "decision 7: the Graph tab", "cmd": "action", "name": "pelican.view.renderTools.graph"},
    {"label": "pick trace", "cmd": "click", "name": "pelican.graphCanvasView::graph_node#trace"},
    {"label": "Callable records... is on: the task declares a callable record", "cmd": "wait", "name": "pelican.graphCanvasRayTracing.callableRecords", "visible": true, "enabled": true, "timeout_ms": 60000},
    {"label": "open it", "cmd": "click", "name": "pelican.graphCanvasRayTracing.callableRecords"},
    {"label": "the Records dialog", "cmd": "wait", "name": "pelican.callableRecords", "visible": true, "timeout_ms": 30000},
    {"label": "its first value: strength, 1", "cmd": "wait", "name": "pelican.callableRecords.value", "visible": true, "text": "1", "timeout_ms": 30000},
    {"label": "strength 0.25", "cmd": "type", "name": "pelican.callableRecords.value", "text": "0.25"},
    {"label": "Apply", "cmd": "click", "name": "pelican.callableRecords.apply"},
    {"label": "the engine has it", "expect": "rpc_equals", "method": "get_ray_callable_records", "params": {}, "path": "tasks[0].records[0].strength", "value": 0.25, "retry_ms": 60000},
    {"label": "nothing refused", "expect": "rpc_equals", "method": "get_status", "params": {}, "path": "render_pipeline.state", "value": "ready", "retry_ms": 60000},

    {"label": "decision 7: the Frame Plan tab", "cmd": "action", "name": "pelican.view.renderTools.frame_plan"},
    {"label": "read the plan again", "cmd": "click", "name": "pelican.framePlanRefresh"},
    {"label": "its Physical plan", "cmd": "action", "name": "pelican.framePlan.tab.physical-plan"},
    {"label": "the hit groups' table lists the cube", "cmd": "wait", "name": "pelican.framePlanPhysical::row#Cube", "visible": true, "timeout_ms": 60000},
    {"label": "the named TLAS actors and its BLAS", "cmd": "wait", "name": "pelican.framePlanPhysical::row#TLAS actors", "visible": true, "timeout_ms": 30000},
    {"label": "a picture of the acceleration structures", "expect": "screenshot", "name": "pelican.framePlanPhysical", "path": "gui_rt_checks_tlas.png"},
    {"label": "a picture of the window", "expect": "screenshot", "path": "gui_rt_checks_window.png"}
  ]
}
