foreach(required IN ITEMS SOURCE_DEPENDENCIES CURRENT_USERPUBLIC FROZEN_USERPUBLIC)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
if(NOT EXISTS "${SOURCE_DEPENDENCIES}")
  message(FATAL_ERROR "WP380b /sourceDependencies output is missing")
endif()
file(READ "${SOURCE_DEPENDENCIES}" dependencies)
string(REPLACE "\\" "/" dependencies "${dependencies}")
string(REPLACE "\\" "/" live "${CURRENT_USERPUBLIC}")
string(REPLACE "\\" "/" frozen "${FROZEN_USERPUBLIC}")
string(REPLACE "//" "/" dependencies "${dependencies}")
string(TOLOWER "${dependencies}" dependencies)
string(TOLOWER "${live}" live)
string(TOLOWER "${frozen}" frozen)
string(FIND "${dependencies}" "${live}" live_index)
if(NOT live_index EQUAL -1)
  message(FATAL_ERROR "frozen v2 fixture consumed live userpublic headers")
endif()
string(FIND "${dependencies}" "${frozen}" frozen_index)
if(frozen_index EQUAL -1)
  message(FATAL_ERROR "frozen v2 fixture did not consume its frozen headers")
endif()
