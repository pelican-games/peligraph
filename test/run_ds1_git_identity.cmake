# DS-1: archive identity must work for source archives and machines without Git.
foreach(required SOURCE_DIR OUT_DIR)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
file(MAKE_DIRECTORY "${OUT_DIR}/source")
configure_file("${SOURCE_DIR}/cmake/pelican_crash_symbols.cmake"
               "${OUT_DIR}/source/symbols.cmake" COPYONLY)
file(WRITE "${OUT_DIR}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.20)
project(source_archive NONE)
include(symbols.cmake)
pelican_read_git_identity(SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}" COMMIT_OUT identity GIT_OUT git)
if(NOT identity STREQUAL "unknown" OR NOT git STREQUAL "")
  message(FATAL_ERROR "Source archive identity must be unknown without a Git executable")
endif()
]=])
foreach(mode archive no_git)
  set(extra)
  if(mode STREQUAL "no_git")
    list(APPEND extra -DCMAKE_DISABLE_FIND_PACKAGE_Git=ON)
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${OUT_DIR}/source" -B "${OUT_DIR}/${mode}"
    ${extra} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
  file(WRITE "${OUT_DIR}/${mode}.log" "${out}\n${err}")
  if(NOT result EQUAL 0 OR NOT err MATCHES "Warning" OR NOT err MATCHES "using unknown")
    message(FATAL_ERROR "${mode}: expected successful configure and warning: ${result}\n${out}\n${err}")
  endif()
endforeach()
