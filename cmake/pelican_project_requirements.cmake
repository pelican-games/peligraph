include_guard(GLOBAL)

# The C++ runtime expands these same rows into its public requirement table.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../src/project/projectrequirements.def"
    requirement_rows REGEX "^PELICAN_PROJECT_REQUIREMENT\\(")
set(PELICAN_PROJECT_REQUIREMENT_NAMES)
foreach(row IN LISTS requirement_rows)
    if(NOT row MATCHES "^PELICAN_PROJECT_REQUIREMENT\\(\"([a-z][a-z0-9_-]*)\", ([A-Z0-9_]+), \"([^\"]+)\"\\)$")
        message(FATAL_ERROR "Invalid project requirement registry row: ${row}")
    endif()
    set(name "${CMAKE_MATCH_1}")
    list(FIND PELICAN_PROJECT_REQUIREMENT_NAMES "${name}" existing)
    if(NOT existing EQUAL -1)
        message(FATAL_ERROR "Duplicate project requirement: ${name}")
    endif()
    list(APPEND PELICAN_PROJECT_REQUIREMENT_NAMES "${name}")
    set(PELICAN_PROJECT_REQUIREMENT_${name}_OPTION "${CMAKE_MATCH_2}")
endforeach()
if(NOT PELICAN_PROJECT_REQUIREMENT_NAMES)
    message(FATAL_ERROR "The project requirement registry is empty")
endif()

function(pelican_project_requirement_arguments output)
    set(arguments)
    foreach(name IN LISTS PELICAN_PROJECT_REQUIREMENT_NAMES)
        set(option "${PELICAN_PROJECT_REQUIREMENT_${name}_OPTION}")
        if(NOT DEFINED ${option})
            message(FATAL_ERROR "Project requirement option is not configured: ${option}")
        endif()
        list(APPEND arguments "-D${option}=${${option}}")
    endforeach()
    set(${output} "${arguments}" PARENT_SCOPE)
endfunction()

# Validate every declaration before returning the first unavailable one, just
# as parseProjectRequirements/unsatisfiedProjectRequirement do in the runtime.
function(pelican_unavailable_project_requirement manifest output_name output_option)
    set(${output_name} "" PARENT_SCOPE)
    set(${output_option} "" PARENT_SCOPE)
    file(READ "${manifest}" contents)
    string(JSON root_type ERROR_VARIABLE error TYPE "${contents}")
    if(error OR NOT root_type STREQUAL "OBJECT")
        message(FATAL_ERROR "project.requires_unknown@1: invalid project JSON: ${manifest}")
    endif()
    string(JSON requires_type ERROR_VARIABLE error TYPE "${contents}" requires)
    if(error)
        return()
    endif()
    if(NOT requires_type STREQUAL "ARRAY")
        message(FATAL_ERROR "project.requires_unknown@1: requires must be an array: ${manifest}")
    endif()
    string(JSON count LENGTH "${contents}" requires)
    set(requirements)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON kind TYPE "${contents}" requires ${index})
            string(JSON name GET "${contents}" requires ${index})
            list(FIND PELICAN_PROJECT_REQUIREMENT_NAMES "${name}" known)
            if(NOT kind STREQUAL "STRING" OR known EQUAL -1)
                message(FATAL_ERROR "project.requires_unknown@1: unknown requirement '${name}': ${manifest}")
            endif()
            list(APPEND requirements "${name}")
        endforeach()
    endif()
    foreach(name IN LISTS requirements)
        set(option "${PELICAN_PROJECT_REQUIREMENT_${name}_OPTION}")
        if(NOT DEFINED ${option})
            message(FATAL_ERROR "Project requirement option is not configured: ${option}")
        endif()
        if(NOT ${option})
            set(${output_name} "${name}" PARENT_SCOPE)
            set(${output_option} "${option}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
endfunction()
